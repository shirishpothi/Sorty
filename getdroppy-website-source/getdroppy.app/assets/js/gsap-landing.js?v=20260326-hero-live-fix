(() => {
    const REPLAY_TOGGLE_ACTIONS = 'restart reverse restart reverse';

    const state = {
        cleanup: null,
        introPlayed: false,
        introLockUntil: 0,
        refreshTimer: 0
    };

    function isElement(node) {
        return node instanceof HTMLElement;
    }

    function getOne(selector, root = document) {
        const node = root.querySelector(selector);
        return isElement(node) ? node : null;
    }

    function getAll(selector, root = document) {
        return Array.from(root.querySelectorAll(selector)).filter(isElement);
    }

    function clearHeroBootstrapState() {
        document.documentElement.classList.remove('droppy-hero-intro-pending');
    }

    function killDroppyTriggers(ScrollTrigger) {
        ScrollTrigger.getAll().forEach((trigger) => {
            if (trigger.vars && typeof trigger.vars.id === 'string' && trigger.vars.id.indexOf('droppy-') === 0) {
                trigger.kill();
            }
        });
    }

    function collectTargets() {
        const hero = getOne('#hero');

        return {
            hero,
            heroLight: getOne('.framer-1w1lta8', hero || document),
            heroContent: getOne('.framer-ik6gh8', hero || document),
            heroParticles: getOne('.framer-yeprz2-container', hero || document),
            heroVisual: getOne('.framer-wdvr1e', hero || document),
            heroShowcase: getOne('.droppy-hero-video-wrap'),
            heroHeadlineLines: getAll('.framer-mk7lz9 .framer-1rmrzte .framer-text, .framer-mk7lz9 .framer-1yylnnf .framer-text', hero || document),
            heroButtons: getAll('.droppy-hero-cta-row a', hero || document),
            heroTickers: getAll('[data-framer-name="Hero Ticker Image"]', hero || document),
            headings: getAll('#features h2, #gallery h2, #icons h2, #how-it-works h2, #companies h2, #pricing h2, #cta h2'),
            featureCards: getAll('#features .droppy-feat'),
            galleryCards: [],
            powerCards: getAll('#icons .droppy-power-card'),
            showcasePanels: getAll('#gallery .droppy-ext-intro, #gallery .droppy-carousel, #icons .droppy-power-marquee, #how-it-works .droppy-how-video-wrap, #companies section, #cta .framer-8sm0k6'),
            hoverPanels: getAll('.droppy-hero-video-wrap, #how-it-works .droppy-how-video-wrap, #cta .framer-8sm0k6')
        };
    }

    function setNoMotionState(gsap, targets) {
        clearHeroBootstrapState();

        const finalNodes = [
            targets.heroLight,
            targets.heroContent,
            targets.heroParticles,
            targets.heroVisual,
            targets.heroShowcase,
            ...targets.heroHeadlineLines,
            ...targets.heroButtons,
            ...targets.heroTickers,
            ...targets.headings,
            ...targets.featureCards,
            ...targets.galleryCards,
            ...targets.powerCards,
            ...targets.showcasePanels
        ].filter(Boolean);

        gsap.set(finalNodes, {
            opacity: 1,
            x: 0,
            y: 0,
            scale: 1,
            rotate: 0,
            filter: 'blur(0px)',
            clipPath: 'inset(0 0% 0 0)'
        });

        targets.featureCards.forEach((card) => {
            const media = getOne('.droppy-feat-img-wrap img', card);
            if (media) gsap.set(media, { opacity: 1, x: 0, y: 0, scale: 1, filter: 'brightness(1) saturate(1)' });
        });

        targets.galleryCards.forEach((card) => {
            const media = getOne('.droppy-ext-media img, .droppy-ext-media video', card);
            if (media) gsap.set(media, { opacity: 1, x: 0, y: 0, scale: 1, filter: 'brightness(1) saturate(1)' });
        });

        targets.powerCards.forEach((card) => {
            const media = getOne('.droppy-power-media img', card);
            if (media) gsap.set(media, { opacity: 1, x: 0, y: 0, scale: 1, filter: 'brightness(1) saturate(1)' });
        });

        targets.showcasePanels.forEach((panel) => {
            const media = getOne('img, video, iframe', panel);
            if (media) gsap.set(media, { opacity: 1, x: 0, y: 0, scale: 1, filter: 'brightness(1) saturate(1)' });
        });
    }

    function setHeroEndState(gsap, targets) {
        clearHeroBootstrapState();

        const endNodes = [
            targets.heroLight,
            targets.heroContent,
            targets.heroParticles,
            targets.heroVisual,
            targets.heroShowcase,
            ...targets.heroHeadlineLines,
            ...targets.heroButtons,
            ...targets.heroTickers
        ].filter(Boolean);

        gsap.set(endNodes, {
            opacity: 1,
            x: 0,
            y: 0,
            scale: 1,
            rotate: 0,
            filter: 'blur(0px)',
            clipPath: 'inset(0 0% 0 0)'
        });

        if (targets.heroVisual) {
            gsap.set(targets.heroVisual, {
                transformOrigin: '50% 0%'
            });
        }
    }

    function initHeroIntro(gsap, targets) {
        if (!targets.hero) return;

        if (targets.heroLight) {
            gsap.set(targets.heroLight, {
                opacity: 1,
                scale: 1.04,
                filter: 'blur(20px)',
                transformOrigin: '50% 50%'
            });
        }

        gsap.set(targets.heroHeadlineLines, {
            opacity: 0,
            y: 16,
            filter: 'blur(18px)',
            clipPath: 'inset(0 100% 0 0)'
        });

        gsap.set(targets.heroButtons, {
            opacity: 0,
            y: 30,
            filter: 'blur(18px)'
        });

        if (targets.heroParticles) {
            gsap.set(targets.heroParticles, {
                opacity: 0,
                scale: 1.04,
                filter: 'blur(18px)',
                transformOrigin: '50% 50%'
            });
        }

        if (targets.heroVisual) {
            gsap.set(targets.heroVisual, {
                opacity: 0,
                y: 140,
                scale: 0.92,
                rotate: 2.5,
                filter: 'brightness(0.78) saturate(1.08)',
                transformOrigin: '50% 0%'
            });
        }

        if (targets.heroShowcase) {
            gsap.set(targets.heroShowcase, {
                opacity: 0,
                y: 52,
                scale: 0.985,
                filter: 'blur(18px)',
                transformOrigin: '50% 50%'
            });
        }

        gsap.set(targets.heroTickers, {
            opacity: 0,
            y: 74,
            rotate: (index) => (index % 2 === 0 ? -7 : 7),
            scale: 0.9,
            filter: 'blur(10px)'
        });

        clearHeroBootstrapState();

        const intro = gsap.timeline({
            defaults: {
                ease: 'power3.out'
            }
        });

        if (targets.heroLight) {
            intro.to(targets.heroLight, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 1.2,
                ease: 'power4.out'
            }, 0);
        }

        if (targets.heroParticles) {
            intro.to(targets.heroParticles, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 1.05
            }, 0.02);
        }

        intro.to(targets.heroHeadlineLines, {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            clipPath: 'inset(0 0% 0 0)',
            duration: 1.52,
            stagger: 0.18,
            ease: 'power3.out'
        }, 0.24);

        if (targets.heroVisual) {
            intro.to(targets.heroVisual, {
                opacity: 1,
                y: 0,
                scale: 1,
                rotate: 0,
                filter: 'brightness(1) saturate(1)',
                duration: 1.15,
                ease: 'power4.out'
            }, 0.16);
        }

        if (targets.heroShowcase) {
            intro.to(targets.heroShowcase, {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: 'blur(0px)',
                duration: 1.32,
                ease: 'power4.out'
            }, 0.42);
        }

        intro.to(targets.heroTickers, {
            opacity: 1,
            y: 0,
            rotate: 0,
            scale: 1,
            filter: 'blur(0px)',
            duration: 1.05,
            stagger: 0.05
        }, 0.34);

        intro.to(targets.heroButtons, {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 1.02,
            ease: 'power4.out'
        }, 1.54);
    }

    function initHeroScroll(gsap, ScrollTrigger, targets) {
        if (!targets.hero) return;

        const isMobile = window.matchMedia('(max-width: 809px)').matches;
        const contentY = isMobile ? -54 : -92;
        const visualY = isMobile ? -86 : -138;
        const tickerY = isMobile ? -18 : -30;
        const tickerX = isMobile ? 10 : 18;

        const heroTimeline = gsap.timeline({
            scrollTrigger: {
                id: 'droppy-hero-story',
                trigger: targets.hero,
                start: 'top top',
                end: 'bottom top',
                scrub: 1.1
            }
        });

        if (targets.heroContent) {
            heroTimeline.to(targets.heroContent, {
                y: contentY,
                scale: isMobile ? 0.965 : 0.935,
                opacity: 0.08,
                ease: 'none'
            }, 0);
        }

        if (targets.heroParticles) {
            heroTimeline.to(targets.heroParticles, {
                y: isMobile ? -28 : -48,
                scale: isMobile ? 1.06 : 1.12,
                opacity: 0.22,
                ease: 'none'
            }, 0);
        }

        if (targets.heroVisual) {
            heroTimeline.to(targets.heroVisual, {
                y: visualY,
                scale: isMobile ? 1.12 : 1.22,
                opacity: 0.78,
                filter: 'brightness(0.8) saturate(1.08)',
                ease: 'none'
            }, 0);
        }

        targets.heroTickers.forEach((node, index) => {
            heroTimeline.to(node, {
                x: index % 2 === 0 ? -tickerX : tickerX,
                y: tickerY - (index * (isMobile ? 5 : 8)),
                scale: isMobile ? 1.04 : 1.09,
                opacity: 0.24,
                filter: `blur(${isMobile ? 4 : 8}px)`,
                ease: 'none'
            }, 0);
        });

        ScrollTrigger.refresh();
    }

    function initHeadingReveal(gsap, targets) {
        targets.headings.forEach((node, index) => {
            gsap.fromTo(node, {
                opacity: 0,
                y: 42,
                filter: 'blur(10px)'
            }, {
                opacity: 1,
                y: 0,
                filter: 'blur(0px)',
                duration: 0.9,
                ease: 'power4.out',
                immediateRender: false,
                scrollTrigger: {
                    id: `droppy-heading-${index}`,
                    trigger: node,
                    start: 'top 88%',
                    toggleActions: REPLAY_TOGGLE_ACTIONS,
                    invalidateOnRefresh: true
                }
            });
        });
    }

    function initCardReveal(gsap, cards, options) {
        cards.forEach((card, index) => {
            const media = getOne(options.mediaSelector, card);

            const timeline = gsap.timeline({
                scrollTrigger: {
                    id: `${options.id}-${index}`,
                    trigger: card,
                    start: options.start || 'top 86%',
                    toggleActions: REPLAY_TOGGLE_ACTIONS,
                    invalidateOnRefresh: true
                }
            });

            timeline.fromTo(card, {
                opacity: 0,
                y: options.fromY,
                x: index % 2 === 0 ? -options.fromX : options.fromX,
                scale: options.fromScale,
                filter: `blur(${options.fromBlur}px)`
            }, {
                opacity: 1,
                y: 0,
                x: 0,
                scale: 1,
                filter: 'blur(0px)',
                immediateRender: false,
                duration: 1.05,
                ease: 'expo.out'
            }, 0);

            if (media) {
                timeline.fromTo(media, {
                    scale: options.mediaFromScale,
                    y: options.mediaFromY,
                    filter: `brightness(${options.mediaBrightness}) saturate(1.08)`
                }, {
                    scale: 1,
                    y: 0,
                    filter: 'brightness(1) saturate(1)',
                    immediateRender: false,
                    duration: 1.15,
                    ease: 'expo.out'
                }, 0);
            }
        });
    }

    function initPanelReveal(gsap, panels) {
        panels.forEach((panel, index) => {
            const media = getOne('img, video, iframe', panel);
            const timeline = gsap.timeline({
                scrollTrigger: {
                    id: `droppy-panel-${index}`,
                    trigger: panel,
                    start: 'top 84%',
                    toggleActions: REPLAY_TOGGLE_ACTIONS,
                    invalidateOnRefresh: true
                }
            });

            timeline.fromTo(panel, {
                opacity: 0,
                y: 44,
                scale: 0.982,
                filter: 'blur(8px)'
            }, {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: 'blur(0px)',
                immediateRender: false,
                duration: 1.12,
                ease: 'expo.out'
            }, 0);

            if (media) {
                timeline.fromTo(media, {
                    scale: 1.025,
                    y: 8,
                    filter: 'brightness(0.92) saturate(1.04)'
                }, {
                    scale: 1,
                    y: 0,
                    filter: 'brightness(1) saturate(1)',
                    immediateRender: false,
                    duration: 1.18,
                    ease: 'expo.out'
                }, 0);
            }
        });
    }

    function addHoverLift(gsap, card, mediaSelector, depth) {
        if (window.matchMedia('(hover: none)').matches) return () => {};

        const media = getOne(mediaSelector, card);
        const enter = () => {
            gsap.to(card, {
                y: -depth,
                scale: 1.012,
                duration: 0.42,
                ease: 'power3.out',
                overwrite: 'auto'
            });

            if (media) {
                gsap.to(media, {
                    y: -4,
                    scale: 1.04,
                    duration: 0.5,
                    ease: 'power3.out',
                    overwrite: 'auto'
                });
            }
        };

        const leave = () => {
            gsap.to(card, {
                y: 0,
                scale: 1,
                duration: 0.42,
                ease: 'power3.out',
                overwrite: 'auto'
            });

            if (media) {
                gsap.to(media, {
                    y: 0,
                    scale: 1,
                    duration: 0.5,
                    ease: 'power3.out',
                    overwrite: 'auto'
                });
            }
        };

        card.addEventListener('mouseenter', enter);
        card.addEventListener('mouseleave', leave);
        card.addEventListener('focusin', enter);
        card.addEventListener('focusout', leave);

        return () => {
            card.removeEventListener('mouseenter', enter);
            card.removeEventListener('mouseleave', leave);
            card.removeEventListener('focusin', enter);
            card.removeEventListener('focusout', leave);
        };
    }

    function clearQueuedRefresh() {
        if (!state.refreshTimer) return;
        window.clearTimeout(state.refreshTimer);
        state.refreshTimer = 0;
    }

    function queueRefreshAfterIntro() {
        const remaining = Math.max(0, state.introLockUntil - performance.now());
        clearQueuedRefresh();
        state.refreshTimer = window.setTimeout(() => {
            state.refreshTimer = 0;
            initializeDroppyGsap();
        }, remaining + 40);
    }

    function initializeDroppyGsap() {
        if (!window.gsap || !window.ScrollTrigger) return;

        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        gsap.registerPlugin(ScrollTrigger);

        if (state.introLockUntil && performance.now() < state.introLockUntil) {
            queueRefreshAfterIntro();
            return;
        }

        state.introLockUntil = 0;
        clearQueuedRefresh();

        if (state.cleanup) {
            state.cleanup();
            state.cleanup = null;
        }

        killDroppyTriggers(ScrollTrigger);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = collectTargets();
        const hoverCleanups = [];

        const context = gsap.context(() => {
            if (prefersReducedMotion) {
                setNoMotionState(gsap, targets);
                state.introPlayed = true;
                return;
            }

            const shouldPlayHeroIntro = !state.introPlayed && window.scrollY < 24;
            if (shouldPlayHeroIntro) {
                state.introLockUntil = performance.now() + 4300;
                initHeroIntro(gsap, targets);
            } else {
                setHeroEndState(gsap, targets);
            }
            state.introPlayed = true;

            initHeroScroll(gsap, ScrollTrigger, targets);
            initHeadingReveal(gsap, targets);
            initCardReveal(gsap, targets.featureCards, {
                id: 'droppy-feature-card',
                mediaSelector: '.droppy-feat-img-wrap img',
                fromX: 28,
                fromY: 70,
                fromScale: 0.96,
                fromBlur: 10,
                mediaFromScale: 1.08,
                mediaFromY: 18,
                mediaBrightness: 0.82
            });
            initCardReveal(gsap, targets.powerCards, {
                id: 'droppy-power-card',
                mediaSelector: '.droppy-power-media img',
                fromX: 28,
                fromY: 62,
                fromScale: 0.97,
                fromBlur: 8,
                mediaFromScale: 1.07,
                mediaFromY: 16,
                mediaBrightness: 0.84
            });
            initPanelReveal(gsap, targets.showcasePanels);

            targets.featureCards.forEach((card) => {
                hoverCleanups.push(addHoverLift(gsap, card, '.droppy-feat-img-wrap img', 10));
            });
            targets.powerCards.forEach((card) => {
                hoverCleanups.push(addHoverLift(gsap, card, '.droppy-power-media img', 8));
            });
            targets.hoverPanels.forEach((panel) => {
                hoverCleanups.push(addHoverLift(gsap, panel, 'img, video, iframe', 8));
            });
        }, document.body);

        state.cleanup = () => {
            hoverCleanups.forEach((cleanup) => cleanup());
            context.revert();
            killDroppyTriggers(ScrollTrigger);
        };
    }

    window.initializeDroppyGsap = initializeDroppyGsap;
})();
