    icon.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371 13.327 13.327 0 0 0-.608 1.2526 18.2699 18.2699 0 0 0-5.4875 0 12.6404 12.6404 0 0 0-.6171-1.2526.077.077 0 0 0-.0785-.037A19.7363 19.7363 0 0 0 3.677 4.3698a.0699.0699 0 0 0-.0321.0277C.5334 9.0467-.319 13.58.0998 18.0578a.0824.0824 0 0 0 .0312.0561 19.9 19.9 0 0 0 5.9931 3.03.078.078 0 0 0 .0841-.0276 13.446 13.446 0 0 0 1.226-1.9944.076.076 0 0 0-.0416-.1057 13.107 13.107 0 0 1-1.872-0.892.077.077 0 0 1-.0077-.1277c.126-.0943.252-.1923.3723-.2914a.074.074 0 0 1 .0776-.0106c3.9278 1.7931 8.1804 1.7931 12.061 0a.074.074 0 0 1 .0785.0094c.1203.099.2463.198.3732.2923a.077.077 0 0 1-.0068.1276 12.299 12.299 0 0 1-1.873.891.0766.0766 0 0 0-.0407.1067 15.1066 15.1066 0 0 0 1.2259 1.9935.076.076 0 0 0 .0841.0285 19.8395 19.8395 0 0 0 6.0022-3.03.077.077 0 0 0 .0313-.0552c.5006-5.177-0.838-9.6748-3.5485-13.66a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1578-1.0857-2.1578-2.419 0-1.3333.9564-2.419 2.1578-2.419 1.2108 0 2.1764 1.0953 2.1578 2.419 0 1.3333-.9563 2.419-2.1578 2.419Zm7.9748 0c-1.1825 0-2.1578-1.0857-2.1578-2.419 0-1.3333.9564-2.419 2.1578-2.419 1.2108 0 2.1763 1.0953 2.1577 2.419 0 1.3333-.947 2.419-2.1577 2.419Z"/></svg>';
    return icon;
  }
  function createMailIconNode(){
    var icon = document.createElement('span');
    icon.className = 'droppy-mail-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5v-9Z" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    return icon;
  }
  function setModalStatus(message, type){
    if(!modalNodes || !modalNodes.statusNode) return;
    var hasMessage = !!(message && message.trim());
    modalNodes.statusNode.textContent = message || '';
    modalNodes.statusNode.classList.remove('error', 'success');
    if(type) modalNodes.statusNode.classList.add(type);
    modalNodes.statusNode.hidden = !hasMessage;
  }
  function setCheckoutButtonDisabled(disabled){
    if(!modalNodes || !modalNodes.checkoutButton) return;
    if('disabled' in modalNodes.checkoutButton) modalNodes.checkoutButton.disabled = !!disabled;
    if(disabled){
      modalNodes.checkoutButton.classList.add('is-disabled');
      modalNodes.checkoutButton.setAttribute('aria-disabled', 'true');
      modalNodes.checkoutButton.setAttribute('tabindex', '-1');
      return;
    }
    modalNodes.checkoutButton.classList.remove('is-disabled');
    modalNodes.checkoutButton.setAttribute('aria-disabled', 'false');
    modalNodes.checkoutButton.removeAttribute('tabindex');
  }
  function parseJsonSafe(value){
    try {
      return JSON.parse(value || '{}');
    } catch (_) {
      return {};
    }
  }
  function clampCheckoutQuantity(rawValue){
    var parsed = parseInt(rawValue, 10);
    if(!Number.isFinite(parsed) || parsed < 1) return 1;
    if(parsed > 25) return 25;
    return parsed;
  }
  function formatCurrencyAmount(amount, currencyCode){
    var safeAmount = Number.isFinite(amount) ? amount : 0;
    var code = String(currencyCode || 'USD').toUpperCase();
    try {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: code,
        currencyDisplay: 'symbol'
      }).format(safeAmount);
    } catch (_) {
      return safeAmount.toFixed(2) + ' ' + code;
    }
  }
  function getQuantityDiscountPercent(quantity){
    if(quantity >= 5) return 25;
    if(quantity >= 2) return 15;
    return 0;
  }
  function inferLocalCurrencyCode(){
    var locale = '';
    try {
      locale = String((Intl.DateTimeFormat().resolvedOptions() || {}).locale || '');
    } catch (_) {
      locale = '';
    }
    var regionMatch = locale.match(/-([A-Z]{2})\b/i);
    var region = regionMatch ? regionMatch[1].toUpperCase() : '';
    var regionCurrency = {
      US: 'USD', CA: 'CAD', GB: 'GBP', AU: 'AUD', NZ: 'NZD', SG: 'SGD', HK: 'HKD',
      JP: 'JPY', CN: 'CNY', KR: 'KRW', IN: 'INR', ID: 'IDR', MY: 'MYR', TH: 'THB',
      PH: 'PHP', VN: 'VND', TW: 'TWD', AE: 'AED', SA: 'SAR', IL: 'ILS', TR: 'TRY',
      CH: 'CHF', SE: 'SEK', NO: 'NOK', DK: 'DKK', PL: 'PLN', CZ: 'CZK', HU: 'HUF',
      RO: 'RON', BG: 'BGN', HR: 'EUR', SI: 'EUR', SK: 'EUR', LT: 'EUR', LV: 'EUR',
      EE: 'EUR', IE: 'EUR', NL: 'EUR', BE: 'EUR', LU: 'EUR', FR: 'EUR', DE: 'EUR',
      ES: 'EUR', PT: 'EUR', IT: 'EUR', AT: 'EUR', FI: 'EUR', GR: 'EUR', CY: 'EUR',
      MT: 'EUR', BR: 'BRL', MX: 'MXN', AR: 'ARS', CL: 'CLP', CO: 'COP', PE: 'PEN',
      ZA: 'ZAR', NG: 'NGN', EG: 'EGP'
    };
    return regionCurrency[region] || 'USD';
  }
  function normalizeSupportedCheckoutCurrency(currencyCode){
    var normalized = String(currencyCode || '').trim().toLowerCase();
    if(normalized === 'usd' || normalized === 'eur' || normalized === 'gbp'){
      return normalized;
    }
    return null;
  }
  function resolveCheckoutDisplayCurrency(){
    return (normalizeSupportedCheckoutCurrency(inferLocalCurrencyCode())
      || normalizeSupportedCheckoutCurrency(checkoutBasePrice.currency)
      || 'usd').toUpperCase();
  }
  function resolveCheckoutRequestCurrency(){
    return normalizeSupportedCheckoutCurrency(purchasePricingState.localCurrency)
      || normalizeSupportedCheckoutCurrency(checkoutBasePrice.currency)
      || 'usd';
  }
  function formatIntentTotal(amountCents, currencyCode){
    var cents = Number.isFinite(amountCents) ? amountCents : 0;
    var normalizedCurrency = normalizeSupportedCheckoutCurrency(currencyCode) || 'usd';
    return formatCurrencyAmount(cents / 100, normalizedCurrency)
      .replace(/\$\s+(?=\d)/g, '$')
      .replace(/^([A-Z]{2,3})\$(?=\d)/, '$1 $');
  }
  function buildPurchasePricingSnapshot(quantity){
    var safeQuantity = clampCheckoutQuantity(quantity);
    var discountPercent = getQuantityDiscountPercent(safeQuantity);
    var discountedUsdTotalCents = Math.round(
      (checkoutBasePrice.amountCents * safeQuantity) * (100 - discountPercent) / 100
    );
    var checkoutCurrency = normalizeSupportedCheckoutCurrency(purchasePricingState.localCurrency) || 'usd';
    var requiresFx = checkoutCurrency !== 'usd';

    if(requiresFx && !purchasePricingState.hasFxRate){
      return {
        quantity: safeQuantity,
        discountPercent: discountPercent,
        amountCents: null,
        currency: checkoutCurrency,
        totalText: '',
        ready: false,
        error: purchasePricingState.error || ''
      };
    }

    var localizedTotalCents = requiresFx
      ? Math.round(discountedUsdTotalCents * purchasePricingState.usdRate)
      : discountedUsdTotalCents;

    return {
      quantity: safeQuantity,
      discountPercent: discountPercent,
      amountCents: localizedTotalCents,
      currency: checkoutCurrency,
      totalText: formatIntentTotal(localizedTotalCents, checkoutCurrency),
      ready: true,
      error: ''
    };
  }
  function syncCheckoutDiscountBadge(label){
    if(!modalNodes || !modalNodes.promoBadge) return;
    if(!label){
      modalNodes.promoBadge.textContent = '';
      modalNodes.promoBadge.style.display = 'none';
      return;
    }
    modalNodes.promoBadge.textContent = label;
    modalNodes.promoBadge.style.display = 'inline-flex';
  }
  var DROPPY_FX_CACHE_KEY = 'droppy.fx.usd.v1';
  var DROPPY_FX_CACHE_TTL_MS = 6 * 60 * 60 * 1000;
  function readCachedFxRates(){
    try {
      var raw = window.localStorage && window.localStorage.getItem(DROPPY_FX_CACHE_KEY);
      if(!raw) return null;
      var parsed = JSON.parse(raw);
      if(!parsed || typeof parsed !== 'object') return null;
      if(typeof parsed.fetchedAt !== 'number' || !parsed.rates || typeof parsed.rates !== 'object') return null;
      if(Date.now() - parsed.fetchedAt > DROPPY_FX_CACHE_TTL_MS) return null;
      return parsed.rates;
    } catch (_) {
      return null;
    }
  }
  function writeCachedFxRates(rates){
    try {
      if(!window.localStorage || !rates) return;
      window.localStorage.setItem(DROPPY_FX_CACHE_KEY, JSON.stringify({ fetchedAt: Date.now(), rates: rates }));
    } catch (_) {}
  }
  async function initializePurchasePricing(){
    if(purchasePricingState.initialized) return;
    purchasePricingState.initialized = true;
    var localCurrency = resolveCheckoutDisplayCurrency();
    purchasePricingState.localCurrency = localCurrency;
    purchasePricingState.usdRate = 1;
    purchasePricingState.hasFxRate = localCurrency === 'USD';
    purchasePricingState.loading = localCurrency !== 'USD';
    purchasePricingState.error = '';
    refreshPurchaseSummary();
    if(localCurrency === 'USD') return;
    var cachedRates = readCachedFxRates();
    if(cachedRates && typeof cachedRates[localCurrency] === 'number' && cachedRates[localCurrency] > 0){
      purchasePricingState.usdRate = cachedRates[localCurrency];
      purchasePricingState.hasFxRate = true;
      purchasePricingState.loading = false;
      refreshPurchaseSummary();
      return;
    }
    try {
      var response = await fetch('https://open.er-api.com/v6/latest/USD');
      if(!response.ok){
        throw new Error('Could not load live exchange rates.');
      }
      var payload = await response.json().catch(function(){ return {}; });
      var rates = payload && payload.rates ? payload.rates : null;
      var rate = rates && typeof rates[localCurrency] === 'number' ? rates[localCurrency] : null;
      if(!Number.isFinite(rate) || rate <= 0){
        throw new Error('Could not resolve checkout currency rate.');
      }
      purchasePricingState.usdRate = rate;
      purchasePricingState.hasFxRate = true;
      writeCachedFxRates(rates);
    } catch (_) {
      purchasePricingState.initialized = false;
      purchasePricingState.hasFxRate = false;
      purchasePricingState.error = 'Could not load local pricing. Refresh and try again.';
    } finally {
      purchasePricingState.loading = false;
      refreshPurchaseSummary();
    }
  }
  function animatePurchasePricingChange(){
    if(!modalNodes) return;
    if(modalNodes.pricingCard){
      modalNodes.pricingCard.classList.remove('is-updating');
      void modalNodes.pricingCard.offsetWidth;
      modalNodes.pricingCard.classList.add('is-updating');
    }
    if(modalNodes.quantityStepper){
      modalNodes.quantityStepper.classList.remove('is-updating');
      void modalNodes.quantityStepper.offsetWidth;
      modalNodes.quantityStepper.classList.add('is-updating');
    }
    if(modalNodes.quantityValue){
      modalNodes.quantityValue.classList.remove('is-updating');
      void modalNodes.quantityValue.offsetWidth;
      modalNodes.quantityValue.classList.add('is-updating');
    }
    if(pricingAnimationTimer){
      window.clearTimeout(pricingAnimationTimer);
    }
    pricingAnimationTimer = window.setTimeout(function(){
      if(!modalNodes) return;
      if(modalNodes.pricingCard){
        modalNodes.pricingCard.classList.remove('is-updating');
      }
      if(modalNodes.quantityStepper){
        modalNodes.quantityStepper.classList.remove('is-updating');
      }
      if(modalNodes.quantityValue){
        modalNodes.quantityValue.classList.remove('is-updating');
      }
    }, 320);
  }
  function refreshPurchaseSummary(){
    if(!modalNodes || !modalNodes.purchaseSummary) return;
    var snapshot = buildPurchasePricingSnapshot(purchaseCheckoutState.quantity);
    purchaseCheckoutState.quantity = snapshot.quantity;
    if(!snapshot.ready){
      modalNodes.purchaseSummary.textContent = purchasePricingState.loading ? '...' : 'Unavailable';
      if(modalNodes.discountBadge){
        modalNodes.discountBadge.textContent = 'Base';
        modalNodes.discountBadge.classList.remove('is-active');
      }
      if(modalNodes.quantityValue){
        modalNodes.quantityValue.textContent = String(snapshot.quantity);
      }
      setCheckoutButtonDisabled(true);
      if(purchasePricingState.error && modalNodes.hasCheckoutConfig !== false){
        setModalStatus(purchasePricingState.error, 'error');
      }
      return;
    }

    modalNodes.purchaseSummary.textContent = snapshot.totalText;
    if(snapshot.discountPercent > 0){
      if(modalNodes.discountBadge){
        modalNodes.discountBadge.textContent = '-' + String(snapshot.discountPercent) + '%';
        modalNodes.discountBadge.classList.add('is-active');
      }
    } else {
      if(modalNodes.discountBadge){
        modalNodes.discountBadge.textContent = 'Base';
        modalNodes.discountBadge.classList.remove('is-active');
      }
    }
    if(modalNodes.quantityValue){
      modalNodes.quantityValue.textContent = String(snapshot.quantity);
    }
    if(modalNodes.hasCheckoutConfig !== false){
      setCheckoutButtonDisabled(false);
      if(embeddedCheckoutState.step === 'configure'){
        setModalStatus('', null);
      }
    }
  }
  function setPurchaseQuantity(rawValue, options){
    var previousQuantity = purchaseCheckoutState.quantity;
    purchaseCheckoutState.quantity = clampCheckoutQuantity(rawValue);
    refreshPurchaseSummary();
    if((options && options.silent) || purchaseCheckoutState.quantity === previousQuantity){
      return;
    }
    animatePurchasePricingChange();
  }
  function buildCheckoutRequestPayload(email, accountAccessToken, currency, quantity){
    return {
      email: email || null,
      account_access_token: accountAccessToken || null,
      currency: currency || null,
      quantity: clampCheckoutQuantity(quantity)
    };
  }
  function createCheckoutSessionViaXHR(endpoint, anonKey, email, accountAccessToken, currency, quantity){
    return new Promise(function(resolve, reject){
      var xhr = new XMLHttpRequest();
      xhr.open('POST', endpoint, true);
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.setRequestHeader('Authorization', 'Bearer ' + anonKey);
      xhr.setRequestHeader('apikey', anonKey);
      xhr.onreadystatechange = function(){
        if(xhr.readyState !== 4) return;
        var payload = parseJsonSafe(xhr.responseText);
        if(xhr.status >= 200 && xhr.status < 300 && typeof payload.url === 'string'){
          resolve(payload);
          return;
        }
        reject(new Error(payload.error || 'Could not create checkout session.'));
      };
      xhr.onerror = function(){
        reject(new Error('Failed to fetch'));
      };
      xhr.send(JSON.stringify(buildCheckoutRequestPayload(
        email,
        accountAccessToken,
        currency,
        quantity
      )));
    });
  }
  async function createCheckoutSession(endpoint, anonKey, email, accountAccessToken, currency, quantity){
    var response;
    try {
      response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + anonKey,
          'apikey': anonKey
        },
        body: JSON.stringify(buildCheckoutRequestPayload(
          email,
          accountAccessToken,
          currency,
          quantity
        ))
      });
    } catch (error) {
      if(((error && error.message) || '').toLowerCase() === 'failed to fetch'){
        return createCheckoutSessionViaXHR(endpoint, anonKey, email, accountAccessToken, currency, quantity);
      }
      throw error;
    }

    var payload = await response.json().catch(function(){ return {}; });
    if(!response.ok || typeof payload.url !== 'string'){
      throw new Error(payload.error || 'Could not create checkout session.');
    }
    return payload;
  }
  function createPurchaseModal(){
    if(modalNodes) return modalNodes;
    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay';
    overlay.id = 'droppy-license-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-purchase-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-license-modal-title">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div class="droppy-purchase-head">' +
              '<div id="droppy-license-modal-title" class="droppy-license-title-wrap" data-framer-name="Grab your license" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
                '<h1 class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Grab your license</h1>' +
              '</div>' +
              '<div class="droppy-purchase-config">' +
                '<div class="droppy-purchase-controls">' +
                  '<button id="droppy-license-checkout-button" type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn droppy-inline-continue" style="background-color:#ffffff;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px;box-shadow:inset 0px 0px 10px 0px rgba(255, 255, 255, 0.65), 0px 5px 18px 0px rgba(255,255,255,0.12)">' +
                    '<div class="framer-ng3b95" data-framer-name="Continue" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;--framer-paragraph-spacing:0px;transform:none" data-framer-component-type="RichTextContainer">' +
                      '<p class="framer-text framer-styles-preset-3f7vf4" data-styles-preset="bWiCpUaS8">Continue</p>' +
                    '</div>' +
                  '</button>' +
                  '<button type="button" id="droppy-purchase-back-btn" class="droppy-purchase-back-btn" style="display:none;">' +
                    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px"><path d="M10 12L6 8l4-4"/></svg>' +
                    'Back' +
