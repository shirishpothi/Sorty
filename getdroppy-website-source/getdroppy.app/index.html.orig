aspect-ratio:16/9;
max-height:38vh;
}
html.droppy-horizontal-scroll #hero .framer-ik6gh8,
html.droppy-horizontal-scroll #hero .framer-mk7lz9{
align-items:center!important;
text-align:center!important;
}
html.droppy-horizontal-scroll #hero .framer-mk7lz9 > *,
html.droppy-horizontal-scroll #hero .droppy-hero-price-badge,
html.droppy-horizontal-scroll #hero .droppy-hero-cta-row,
html.droppy-horizontal-scroll #hero .droppy-macos-ready-badge,
