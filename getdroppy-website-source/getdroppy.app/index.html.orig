    bindDownloadLinkCapture();
    observeDownloadLinks();
    setDownloadLinksTo(stableDownloadUrl);
    refreshLatestDownloadUrl();
  }
  function resolveAccountMagicLinkRedirectURL(){
    var config = modalConfig();
    var origin = window.location.origin || '';
    var pathname = window.location.pathname || '/';
    var localhostPattern = /^https?:\/\/(?:localhost|127\.0\.0\.1)(?::\d+)?$/i;
    var isLocalhost = localhostPattern.test(origin);
    var explicitLocal = config.accountMagicLinkRedirectURLLocal;
    var explicitProd = config.accountMagicLinkRedirectURLProduction || config.accountMagicLinkRedirectURL;

    if(isLocalhost && explicitLocal){
      if(explicitLocal.indexOf('#') === -1) return explicitLocal.replace(/\/$/, '') + '/#account';
      return explicitLocal;
    }

    if(!isLocalhost && explicitProd){
      if(explicitProd.indexOf('#') === -1) return explicitProd.replace(/\/$/, '') + '/#account';
      return explicitProd;
    }

    if(isLocalhost && config.publicSiteURL){
      return config.publicSiteURL.replace(/\/$/, '') + '/#account';
    }
    return origin + pathname + '#account';
  }
  function syncBodyModalLock(){
