  function isDownloadAnchor(anchor){
    if(!(anchor instanceof HTMLAnchorElement)) return false;
    if(anchor.hasAttribute('data-droppy-purchase-trigger')) return false;
    if(anchor.closest('.droppy-license-modal')) return false;
    var href = (anchor.getAttribute('href') || '').toLowerCase();
    if(href.indexOf('droppy') !== -1 && href.indexOf('.dmg') !== -1) return true;
    var label = normalizedText(anchor.textContent || '');
    if(label === 'download for macos' || label === 'download') return true;
    return false;
  }
  function applyDownloadUrlToAnchor(anchor, url){
    if(!(anchor instanceof HTMLAnchorElement) || !url) return;
    if(anchor.getAttribute('href') !== url){
      anchor.setAttribute('href', url);
    }
    if(anchor.getAttribute('target') !== '_blank'){
      anchor.setAttribute('target', '_blank');
    }
    if(anchor.getAttribute('rel') !== 'noopener'){
      anchor.setAttribute('rel', 'noopener');
    }
  }
  function setDownloadLinksTo(url){
    if(!url) return;
    document.querySelectorAll('a').forEach(function(anchor){
      if(!isDownloadAnchor(anchor)) return;
      applyDownloadUrlToAnchor(anchor, url);
    });
  }
  function syncDownloadLinks(root){
    var url = getStableDownloadUrl();
    var scope = root || document;
    if(!url) return;

    if(scope instanceof HTMLAnchorElement){
      if(isDownloadAnchor(scope)) applyDownloadUrlToAnchor(scope, url);
      return;
    }

    if(scope instanceof Element && isDownloadAnchor(scope)){
      applyDownloadUrlToAnchor(scope, url);
    }

    if(scope && typeof scope.querySelectorAll === 'function'){
      scope.querySelectorAll('a').forEach(function(anchor){
        if(!isDownloadAnchor(anchor)) return;
        applyDownloadUrlToAnchor(anchor, url);
      });
    }
  }
  function scheduleDownloadLinkSync(root){
    if(downloadLinkSyncState.rafId){
      cancelAnimationFrame(downloadLinkSyncState.rafId);
    }
    downloadLinkSyncState.rafId = requestAnimationFrame(function(){
      downloadLinkSyncState.rafId = 0;
      syncDownloadLinks(root || document);
    });
  }
  function bindDownloadLinkCapture(){
    if(downloadLinkSyncState.captureBound) return;
    downloadLinkSyncState.captureBound = true;

    function syncFromEvent(event){
      var target = event.target instanceof Element ? event.target : null;
      if(!target) return;
      var anchor = target.closest('a');
      if(!isDownloadAnchor(anchor)) return;
      var stableUrl = getStableDownloadUrl();
      if(!stableUrl) return;
      applyDownloadUrlToAnchor(anchor, stableUrl);
    }

    document.addEventListener('click', syncFromEvent, true);
    document.addEventListener('auxclick', function(event){
      if(event.button !== 1) return;
      syncFromEvent(event);
    }, true);
    document.addEventListener('keydown', function(event){
      if(event.key !== 'Enter') return;
      syncFromEvent(event);
    }, true);
  }
  function observeDownloadLinks(){}
  function wireDownloadButtonsToLatestRelease(){
