  function getStableDownloadUrl(){
    var config = modalConfig();
    return downloadLinkSyncState.resolvedUrl || config.releasesDownloadURL;
  }
  function resolveManifestDownloadUrl(manifest){
    if(!manifest || typeof manifest !== 'object') return '';
    var downloadUrl = typeof manifest.download_url === 'string' ? manifest.download_url.trim() : '';
    if(downloadUrl) return downloadUrl;
    var directDownloadUrl = typeof manifest.direct_download_url === 'string' ? manifest.direct_download_url.trim() : '';
    if(directDownloadUrl) return directDownloadUrl;
    return '';
  }
  function refreshLatestDownloadUrl(){
    if(downloadLinkSyncState.manifestPromise) return downloadLinkSyncState.manifestPromise;
    var config = modalConfig();
    if(!config.releasesManifestURL){
      return Promise.resolve('');
    }
    downloadLinkSyncState.manifestPromise = (async function(){
      var manifestURL = new URL(config.releasesManifestURL, window.location.origin);
      manifestURL.searchParams.set('t', Date.now().toString());
      var response = await fetch(manifestURL.toString(), {
        cache: 'no-store',
        headers: { Accept: 'application/json' }
      });
      if(!response.ok){
        throw new Error('Manifest request failed with status ' + response.status);
      }
      var manifest = await response.json();
      var resolvedDownloadUrl = resolveManifestDownloadUrl(manifest);
      if(!resolvedDownloadUrl){
        throw new Error('Latest release manifest is missing a download URL.');
      }
      downloadLinkSyncState.resolvedUrl = resolvedDownloadUrl;
      setDownloadLinksTo(resolvedDownloadUrl);
      return getStableDownloadUrl();
    })().catch(function(error){
      console.error('Failed to resolve versioned download URL:', error);
      return '';
    }).finally(function(){
      downloadLinkSyncState.manifestPromise = null;
    });
    return downloadLinkSyncState.manifestPromise;
