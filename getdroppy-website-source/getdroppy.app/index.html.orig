#features{width:min(1700px,93vw)!important;margin-inline:auto!important}
html:not(.droppy-horizontal-scroll) #hero{position:relative!important;overflow:visible!important;z-index:30!important;-webkit-mask-image:linear-gradient(180deg,#000 92%,rgba(0,0,0,.55) 97%,rgba(0,0,0,0) 100%)!important;mask-image:linear-gradient(180deg,#000 92%,rgba(0,0,0,.55) 97%,rgba(0,0,0,0) 100%)!important}
#hero{
--droppy-hero-scroll-progress:0;
--droppy-hero-content-opacity:1;
--droppy-hero-content-shift:0px;
--droppy-hero-content-scale:1;
--droppy-hero-particles-opacity:1;
--droppy-hero-particles-shift:0px;
--droppy-hero-particles-scale:1;
--droppy-hero-visual-shift:0px;
--droppy-hero-visual-scale:1;
--droppy-hero-visual-brightness:1;
--droppy-hero-visual-saturate:1;
}
#hero::after{
content:"";
position:absolute;
inset:-6% 0 0;
pointer-events:none;
z-index:42;
background:
radial-gradient(62% 54% at 50% 30%,rgba(124,198,255,.16) 0%,rgba(124,198,255,.06) 42%,rgba(124,198,255,0) 78%),
linear-gradient(180deg,rgba(4,7,10,0) 0%,rgba(4,7,10,0) 48%,rgba(4,7,10,.34) 78%,rgba(4,7,10,.72) 100%);
opacity:calc(var(--droppy-hero-scroll-progress) * .78);
transition:opacity .14s linear;
}
#hero .framer-ik6gh8{
position:relative!important;
z-index:44!important;
opacity:var(--droppy-hero-content-opacity);
transform:translate3d(0,var(--droppy-hero-content-shift),0) scale(var(--droppy-hero-content-scale))!important;
transform-origin:center center!important;
will-change:transform,opacity;
}
#hero .framer-yeprz2-container{
