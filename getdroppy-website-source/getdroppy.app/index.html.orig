.droppy-account-modal .droppy-account-license-key{margin:0;font-size:15px;font-weight:700;letter-spacing:.05em;color:#f8fbff;word-break:break-all}
.droppy-account-modal .droppy-account-license-meta{margin:0;font-size:12px;color:rgba(226,236,248,.68)}
.droppy-account-modal .droppy-account-copy{min-height:40px;padding:0 14px;font-size:13px}
.droppy-faq-modal{width:min(100%,960px);max-height:min(88vh,860px);padding:clamp(22px,2.6vw,34px);border-radius:34px;gap:14px}
.droppy-faq-modal .droppy-license-modal-header{grid-template-columns:minmax(0,1fr);align-items:flex-start;gap:12px}
.droppy-faq-modal .droppy-license-copy{gap:8px}
.droppy-faq-modal .droppy-license-title-wrap::before{display:none!important;content:none!important}
.droppy-faq-modal .droppy-license-title{font-size:clamp(36px,4vw,56px);line-height:.94}
.droppy-faq-modal .droppy-license-meta{white-space:normal;text-wrap:pretty;max-width:none;font-size:14px;color:rgba(226,236,248,.78)}
.droppy-license-modal-overlay#droppy-reclaim-modal-overlay .droppy-license-modal-header{grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:18px;row-gap:10px}
.droppy-license-modal-overlay#droppy-reclaim-modal-overlay .droppy-license-meta{white-space:normal;text-wrap:pretty;overflow-wrap:anywhere;max-width:none}
.droppy-license-modal-overlay#droppy-reclaim-modal-overlay .droppy-inline-continue{justify-self:end;align-self:center}
.droppy-faq-scroll{max-height:min(68vh,620px);overflow:auto;display:grid;gap:12px;padding-right:6px}
.droppy-faq-item{padding:14px 16px;border-radius:18px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.04);display:grid;gap:8px}
.droppy-faq-question{margin:0;font:600 16px/1.35 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.01em;color:#f4f9ff}
.droppy-faq-answer{margin:0;font:400 14px/1.5 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.005em;color:rgba(226,236,248,.86)}
.droppy-faq-link{color:#9ad0ff;text-decoration:none}
.droppy-faq-link:hover,.droppy-faq-link:focus-visible{text-decoration:underline}
.droppy-faq-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.droppy-faq-action{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:999px;font:600 13px/1 "Inter",sans-serif;letter-spacing:-.005em;text-decoration:none;transition:transform .22s cubic-bezier(.22,.61,.36,1),filter .22s,background .22s,border-color .22s}
.droppy-faq-action svg{width:16px;height:16px;display:block;flex:0 0 16px}
.droppy-faq-action:hover{transform:translateY(-1px);filter:brightness(1.06)}
.droppy-faq-action:active{transform:translateY(0) scale(.98)}
.droppy-faq-action--primary{background:#5865F2;color:#fff;box-shadow:0 6px 16px -6px rgba(88,101,242,.55)}
.droppy-faq-action--primary:hover{background:#6571f5}
.droppy-faq-action--secondary{background:rgba(255,255,255,.08);color:#f4f9ff;border:1px solid rgba(255,255,255,.14)}
.droppy-faq-action--secondary:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.22)}
.droppy-faq-scroll::-webkit-scrollbar{width:10px}
.droppy-faq-scroll::-webkit-scrollbar-thumb{background:rgba(148,188,226,.4);border-radius:999px}
.droppy-faq-scroll::-webkit-scrollbar-track{background:transparent}
/* Translucent "liquid glass" panel: drop the grey gradient for a transparent
   blur so the morph box (same glass) hands off to it seamlessly. The dark
   overlay dim behind it keeps the text legible. */
.droppy-changelog-modal{max-height:min(86vh,840px);transition:none!important}
/* During the morph the box stands in for the panel's glass, so strip the
   panel's own glass + border + shadow and let only its content show (content
   opacity is driven by WAAPI, cross-fading as the box grows). */
/* The trigger->popup morph scales the panel itself via an inline transform
   (driven by WAAPI); no separate box or is-morphing class is needed. */
.droppy-changelog-modal .droppy-license-title-wrap::before{display:none!important;content:none!important}
.droppy-changelog-modal .droppy-license-title{font-size:clamp(34px,3.6vw,52px);line-height:.94}
.droppy-changelog-modal .droppy-license-meta{white-space:normal;text-wrap:pretty;max-width:none;font-size:14px;color:rgba(226,236,248,.78)}
.droppy-changelog-scroll{max-height:min(68vh,640px);overflow:auto;display:grid;gap:16px;padding-right:6px}
.droppy-changelog-scroll::-webkit-scrollbar{width:10px}
.droppy-changelog-scroll::-webkit-scrollbar-thumb{background:rgba(148,188,226,.4);border-radius:999px}
.droppy-changelog-scroll::-webkit-scrollbar-track{background:transparent}
.droppy-changelog-empty{margin:6px 2px;color:rgba(226,236,248,.6);font:400 14px/1.5 "Inter","Inter Placeholder",sans-serif}
.droppy-changelog-release{padding:16px 18px;border-radius:18px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);display:grid;gap:13px}
.droppy-changelog-release-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}
.droppy-changelog-version{font:600 17px/1.2 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.01em;color:#f4f9ff}
.droppy-changelog-date{font:500 12.5px/1.2 "Inter","Inter Placeholder",sans-serif;color:rgba(226,236,248,.55);letter-spacing:.01em}
.droppy-changelog-section{display:grid;gap:7px}
.droppy-changelog-section-title{margin:0 0 1px 0;font:590 12.5px/1.2 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.005em;color:rgba(255,255,255,.46)}
.droppy-changelog-list{margin:0;padding:0;list-style:none;display:grid;gap:6px}
.droppy-changelog-list li{position:relative;padding-left:16px;font:400 13.5px/1.5 "Inter","Inter Placeholder",sans-serif;color:rgba(226,236,248,.86)}
.droppy-changelog-list li::before{content:"";position:absolute;left:2px;top:.6em;width:5px;height:5px;border-radius:50%;background:rgba(148,188,226,.6)}
.droppy-legal-modal{width:min(100%,980px);max-height:min(88vh,860px);padding:clamp(22px,2.6vw,34px);border-radius:34px;gap:14px}
.droppy-legal-modal .droppy-license-modal-header{grid-template-columns:minmax(0,1fr);align-items:flex-start;gap:12px}
.droppy-legal-modal .droppy-license-copy{gap:8px}
.droppy-legal-modal .droppy-license-title-wrap::before{display:none!important;content:none!important}
.droppy-legal-modal .droppy-license-title{font-size:clamp(34px,3.6vw,52px);line-height:.95}
.droppy-legal-modal .droppy-license-meta{white-space:normal;text-wrap:pretty;max-width:none;font-size:14px;color:rgba(226,236,248,.78)}
.droppy-legal-scroll{max-height:min(68vh,620px);overflow:auto;display:grid;gap:12px;padding-right:6px}
.droppy-legal-section{padding:14px 16px;border-radius:18px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.04);display:grid;gap:8px}
.droppy-legal-section-title{margin:0;font:600 16px/1.35 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.01em;color:#f4f9ff}
.droppy-legal-paragraph{margin:0;font:400 14px/1.52 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.005em;color:rgba(226,236,248,.86)}
.droppy-legal-list{margin:0;padding-left:20px;display:grid;gap:6px}
.droppy-legal-list li{font:400 14px/1.52 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.005em;color:rgba(226,236,248,.86)}
.droppy-legal-link{color:#9ad0ff;text-decoration:none}
.droppy-legal-link:hover,.droppy-legal-link:focus-visible{text-decoration:underline}
.droppy-legal-scroll::-webkit-scrollbar{width:10px}
.droppy-legal-scroll::-webkit-scrollbar-thumb{background:rgba(148,188,226,.4);border-radius:999px}
.droppy-legal-scroll::-webkit-scrollbar-track{background:transparent}
.droppy-install-modal{width:min(100%,1080px);padding:clamp(24px,2.8vw,40px);border-radius:32px;gap:24px;position:relative}
.droppy-install-modal .droppy-license-modal-header{grid-template-columns:minmax(0,1fr);align-items:flex-start;gap:10px}
.droppy-install-modal .droppy-license-copy{gap:10px}
.droppy-install-modal .droppy-license-title-wrap::before{display:none!important;content:none!important}
.droppy-install-modal .droppy-license-title{font-size:clamp(34px,3.6vw,46px);line-height:.96}
.droppy-install-modal .droppy-license-meta{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-wrap:nowrap;max-width:none;font-size:15px;color:rgba(226,236,248,.78)}
@media (max-width:1099px){.droppy-install-modal .droppy-license-meta{white-space:normal;overflow:visible;text-overflow:clip;text-wrap:pretty}}
.droppy-install-manual-link{color:#bfd9f8;text-decoration:underline;text-underline-offset:3px}
.droppy-install-manual-link:hover,.droppy-install-manual-link:focus-visible{color:#fff}
.droppy-install-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:6px}
.droppy-install-card{display:grid;gap:10px;align-content:start}
.droppy-install-visual{position:relative;aspect-ratio:5/3;border-radius:22px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015));overflow:hidden;display:flex;align-items:center;justify-content:center}
.droppy-install-step-label{margin-top:8px;font:500 13px/1 "Inter","Inter Placeholder",sans-serif;letter-spacing:.01em;color:rgba(212,225,243,.55)}
.droppy-install-step-title{margin:0;font:600 22px/1.15 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.01em;color:#f6fbff}
.droppy-install-step-desc{margin:0;font:400 14px/1.5 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.003em;color:rgba(226,236,248,.78);max-width:32ch}
.droppy-install-cursor{position:absolute;width:13px;height:20px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.55));pointer-events:none}
/* Step 1: browser download row */
.droppy-install-browser{position:relative;width:92%;height:100%;display:flex;align-items:center;justify-content:center;padding:0}
.droppy-install-browser-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);box-shadow:0 2px 8px rgba(0,0,0,.18);width:100%;position:relative}
.droppy-install-file-icon{width:22px;height:22px;flex-shrink:0;opacity:.45}
.droppy-install-file-meta{display:grid;gap:3px;min-width:0;flex:1}
.droppy-install-file-name{font:600 13px/1.2 "Inter","Inter Placeholder",sans-serif;letter-spacing:-.01em;color:#f6fbff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.droppy-install-file-sub{font:400 11px/1.2 "Inter","Inter Placeholder",sans-serif;color:rgba(170,200,235,.62);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.droppy-install-dl-arrow{width:24px;height:24px;border-radius:50%;border:1px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);flex-shrink:0;color:rgba(255,255,255,.5)}
.droppy-install-dl-arrow svg{width:12px;height:12px}
.droppy-install-cursor-1{right:30%;bottom:14%}
/* Step 2: drag to applications */
.droppy-install-drag{position:relative;display:flex;align-items:center;justify-content:space-between;width:80%;height:100%;padding:0 6%}
.droppy-install-app-icon{width:74px;height:74px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 10px 22px rgba(0,0,0,.45));position:relative;z-index:2}
.droppy-install-app-icon img{width:100%;height:100%;object-fit:contain;display:block}
.droppy-install-folder{width:74px;height:74px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 8px 18px rgba(0,0,0,.4))}
.droppy-install-folder img{width:100%;height:100%;object-fit:contain;display:block}
.droppy-install-visual-2,.droppy-install-visual-3{overflow:visible}
.droppy-install-arrow{position:absolute;left:calc(6% + 37px);right:calc(6% + 44px);bottom:calc(50% + 37px + 6px);width:auto;height:auto;aspect-ratio:200/80;pointer-events:none;z-index:3;overflow:visible}
.droppy-install-cursor-2{left:30%;top:55%}
/* Step 3: dock with droppy highlighted */
.droppy-install-dock{position:relative;width:92%;display:flex;flex-direction:column;align-items:center;gap:8px}
.droppy-install-dock-droppy{overflow:visible;position:relative}
.droppy-install-dock-tooltip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);white-space:nowrap;padding:4px 9px;background:rgba(255,255,255,.94);color:#101828;font:600 10px/1 "Inter","Inter Placeholder",sans-serif;letter-spacing:.01em;border-radius:6px;box-shadow:0 2px 6px rgba(0,0,0,.3);z-index:10}
.droppy-install-dock-tooltip::after{content:"";position:absolute;left:50%;bottom:-4px;transform:translateX(-50%);width:8px;height:8px;background:rgba(255,255,255,.94);clip-path:polygon(0 0,100% 0,50% 100%)}
.droppy-install-dock-row{display:flex;align-items:center;justify-content:center;gap:8px;padding:8px 10px;border-radius:12px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 2px 8px rgba(0,0,0,.18);width:100%}
.droppy-install-dock-item{width:32px;height:32px;border-radius:8px;flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center}
.droppy-install-dock-item img{width:100%;height:100%;object-fit:contain;display:block}
.droppy-install-dock-droppy{box-shadow:0 3px 10px rgba(120,180,255,.4),0 0 0 1.5px rgba(150,200,255,.5)}
.droppy-install-dock-indicator{width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,.7);transform:translateY(-1px)}
.droppy-install-cursor-3{right:30%;bottom:18%}
@media (max-width:1099px){.droppy-install-modal{width:min(100%,720px)}.droppy-install-grid{grid-template-columns:1fr;gap:14px}.droppy-install-visual{aspect-ratio:8/3}}
@media (max-width:809px){.droppy-install-modal{border-radius:24px;padding:18px 14px}.droppy-install-modal .droppy-license-title{font-size:30px}.droppy-install-step-title{font-size:20px}.droppy-install-step-desc{font-size:13px}.droppy-install-visual{aspect-ratio:8/3;border-radius:18px}}
