transform-origin:center center!important;
}
#hero [data-framer-name="The native productivity layer macOS is missing"]{display:none!important}
#companies [data-framer-name="Logo"]{overflow:visible!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important}
#features{position:relative!important;z-index:10!important}
