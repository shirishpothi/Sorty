  async function ensureSupabaseClient(){
    if(supabaseState.client) return supabaseState.client;
    if(supabaseState.initPromise) return supabaseState.initPromise;

    supabaseState.initPromise = (async function(){
      var config = modalConfig();
      if(!config.supabaseURL || !config.anonKey){
        throw new Error('Account login is not configured.');
      }
      var module = await import('https://esm.sh/@supabase/supabase-js@2.49.8');
      supabaseState.client = module.createClient(config.supabaseURL, config.anonKey, {
        auth: {
          persistSession: true,
          autoRefreshToken: true,
          detectSessionInUrl: true
        }
      });

      if(!supabaseState.authBound){
        supabaseState.authBound = true;
        supabaseState.client.auth.onAuthStateChange(function(){
          if(accountModalState.isOpen){
            refreshAccountModal();
          }
        });
      }

      return supabaseState.client;
    })().catch(function(error){
      supabaseState.initPromise = null;
      throw error;
    });

    return supabaseState.initPromise;
  }
  async function getSupabaseSession(){
    var client = await ensureSupabaseClient();
    var result = await client.auth.getSession();
    return result && result.data ? (result.data.session || null) : null;
  }
  async function getSupabaseAccessToken(){
    try {
      var session = await getSupabaseSession();
      return session && session.access_token ? session.access_token : null;
    } catch (_) {
      return null;
    }
  }
