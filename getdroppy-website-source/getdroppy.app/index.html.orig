/* ===== Section polish: premium typography rhythm, clean panel layout ===== */
html.droppy-horizontal-scroll body{
background:#04070a!important;
}
html.droppy-horizontal-scroll #hero::before{
content:"";
position:absolute;
top:-30%;
left:50%;
width:120%;
height:90%;
transform:translateX(-50%);
background:radial-gradient(ellipse 50% 60% at 50% 50%,rgba(110,170,255,.22),rgba(80,140,255,.08) 38%,transparent 72%);
pointer-events:none;
z-index:0;
}
html.droppy-horizontal-scroll #hero > *{
position:relative;
z-index:1;
}
#hero > .framer-1w1lta8,
#hero > .framer-yeprz2-container,
#hero > .framer-s9qlth-container,
#hero > .framer-wdvr1e,
#hero > .ssr-variant{
display:none!important;
}
/* Kill leftover Framer subtitle duplicate inside framer-ik6gh8 — it's a
   redundant "Droppy for macOS. Your Mac, just way better." paragraph with
   inline opacity:0.001/blur(10px) that becomes a visible white block on
   mobile once our force-visible rule overrides the opacity. */
#hero .framer-9odp75{display:none!important}
/* Each variant of the CTA container is wrapped in its own ssr-variant.
   The mobile/tablet variants don't get enhanced into .droppy-hero-cta-row
   because the JS only enhances the visible one, so the rest render as
   unstyled Framer ghost wrappers. Hide every ssr-variant that doesn't
   live inside our enhanced row. */
#hero .framer-ik6gh8 > .ssr-variant:not(:has(.droppy-hero-cta-row)){display:none!important}
html.droppy-horizontal-scroll #hero > .droppy-hero-mac-mock{
grid-column:1;
grid-row:1;
}
/* Left column wrapper around the mac-mock + "As featured on" strip. In vertical
   (phone) mode it's transparent (display:contents) so the children flow exactly
   as before. In horizontal mode it becomes a real flex column pinned to the top
   of the grid row, so the featured strip stays welded under the mac-mock and is
   never pushed around by the right-hand text column's height. */
.droppy-hero-media-col{
display:contents;
}
html.droppy-horizontal-scroll #hero > .droppy-hero-media-col{
display:flex;
flex-direction:column;
grid-column:1;
grid-row:1;
align-self:center;
min-width:0;
}
#hero .droppy-hero-featured{
display:flex!important;
align-items:center;
justify-content:center;
gap:10px;
font-size:11px;
line-height:1;
letter-spacing:.18em;
text-transform:uppercase;
color:rgba(255,255,255,.6)!important;
font-weight:500;
margin-top:6px;
}
#hero .droppy-hero-featured *{
color:inherit!important;
}
#hero .droppy-hero-featured-label{
color:rgba(255,255,255,.55)!important;
}
#hero .droppy-hero-featured-name,
#hero .droppy-hero-featured-name a,
#hero .droppy-hero-featured-name span{
color:rgba(255,255,255,.95)!important;
text-decoration:none!important;
}
#hero .droppy-hero-featured-name a:link,
#hero .droppy-hero-featured-name a:visited,
#hero .droppy-hero-featured-name a:hover,
#hero .droppy-hero-featured-name a:active{
color:rgba(255,255,255,.95)!important;
text-decoration:none!important;
}
html.droppy-horizontal-scroll #hero .droppy-hero-featured{
width:100%;
margin-top:14px;
}
#hero .droppy-hero-featured-label{
white-space:nowrap;
line-height:1;
}
#hero .droppy-hero-featured-name{
position:relative;
display:inline-flex;
align-items:center;
min-width:90px;
height:14px;
overflow:hidden;
text-align:left;
color:rgba(255,255,255,.78);
letter-spacing:.04em;
line-height:1;
}
#hero .droppy-hero-featured-name a,
#hero .droppy-hero-featured-name span{
position:absolute;
left:0;
top:0;
right:0;
height:14px;
display:flex;
align-items:center;
line-height:1;
text-decoration:none;
color:inherit;
transition:transform .55s cubic-bezier(.65,.05,.36,1),opacity .35s ease,color .2s ease;
will-change:transform,opacity;
}
#hero .droppy-hero-featured-name a:hover{
color:rgba(255,255,255,1);
}
#hero .droppy-hero-featured-name a.is-in,
#hero .droppy-hero-featured-name span.is-in{
transform:translateY(0);
opacity:1;
}
#hero .droppy-hero-featured-name a.is-out,
#hero .droppy-hero-featured-name span.is-out{
transform:translateY(-110%);
opacity:0;
}
#hero .droppy-hero-featured-name a.is-next,
#hero .droppy-hero-featured-name span.is-next{
transform:translateY(110%);
opacity:0;
}
html.droppy-horizontal-scroll #hero > .framer-ik6gh8{
grid-column:2;
grid-row:1;
align-self:center;
}
html.droppy-horizontal-scroll main.framer-t41vbz > section{
padding:90px 6vw 56px!important;
}
html.droppy-horizontal-scroll main.framer-t41vbz > section > *{
max-width:1180px!important;
}
html.droppy-horizontal-scroll .droppy-h-section{
opacity:1;
}
html.droppy-horizontal-scroll .droppy-h-section h1,
html.droppy-horizontal-scroll .droppy-h-section h2{
letter-spacing:-0.025em!important;
line-height:1.02!important;
font-weight:600!important;
}
html.droppy-horizontal-scroll #companies{
padding:120px 6vw 80px!important;
}
html.droppy-horizontal-scroll #companies::before{
content:"As featured in";
display:block;
font-size:13px;
letter-spacing:.18em;
text-transform:uppercase;
color:rgba(255,255,255,.42);
margin-bottom:42px;
font-weight:500;
text-align:center;
order:-1;
}
html.droppy-horizontal-scroll #companies > *{
opacity:.85!important;
}
html.droppy-horizontal-scroll #features{
padding-top:100px!important;
align-items:center!important;
}
html.droppy-horizontal-scroll #features h2{
font-size:clamp(40px,5vw,72px)!important;
margin-bottom:16px!important;
text-align:center!important;
}
html.droppy-horizontal-scroll #features > div[data-framer-name="Container"]{
gap:20px!important;
}
html.droppy-horizontal-scroll #gallery h2,
html.droppy-horizontal-scroll #icons h2,
html.droppy-horizontal-scroll #pricing h2,
html.droppy-horizontal-scroll #cta h2{
font-size:clamp(40px,5vw,72px)!important;
text-align:center!important;
margin-bottom:8px!important;
}
html.droppy-horizontal-scroll #gallery,
html.droppy-horizontal-scroll #icons{
padding-top:110px!important;
}
html.droppy-horizontal-scroll #gallery .droppy-ext-intro,
html.droppy-horizontal-scroll #icons .droppy-power-marquee{
