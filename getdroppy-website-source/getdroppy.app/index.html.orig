    if(node.closest('[data-license-copy-index]')) return true;
    if(node.closest('.droppy-account-license-key')) return true;
    if(node.closest('#droppy-account-license-input')) return true;
    var text = (node.textContent || '').trim();
    if(text && text.length <= 64 && isDroppyLicenseKeyText(text)) return true;
    return false;
  }
  function selectionHasDroppyLicenseKey(){
    var selection = window.getSelection();
    if(!selection || selection.rangeCount === 0) return false;
    if(isDroppyLicenseKeyText(selection.toString() || '')) return true;
    var range = selection.getRangeAt(0);
    var container = range.commonAncestorContainer;
    var element = container && container.nodeType === 1 ? container : container && container.parentElement;
    return isAllowedCopyTarget(element instanceof HTMLElement ? element : null);
  }
  function eventHasDroppyLicenseSelection(event){
    var target = event && event.target instanceof HTMLElement ? event.target : (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    if(isAllowedCopyTarget(target)) return true;

    if(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement){
      var start = typeof target.selectionStart === 'number' ? target.selectionStart : 0;
      var end = typeof target.selectionEnd === 'number' ? target.selectionEnd : 0;
      var selectedText = (target.value || '').slice(Math.min(start, end), Math.max(start, end));
      if(isDroppyLicenseKeyText(selectedText)) return true;
      if(isDroppyLicenseKeyText(target.value || '')) return true;
    }
    return selectionHasDroppyLicenseKey();
  }
  function blockCopyUnlessLicense(event){
    if(eventHasDroppyLicenseSelection(event)) return;
    event.preventDefault();
    event.stopPropagation();
  }
  function installCopyLock(){
    if(copyLockState.initialized) return;
    copyLockState.initialized = true;
    document.addEventListener('copy', blockCopyUnlessLicense, true);
    document.addEventListener('cut', blockCopyUnlessLicense, true);
    document.addEventListener('keydown', function(event){
      if(!(event.ctrlKey || event.metaKey) || event.altKey) return;
      var key = (event.key || '').toLowerCase();
      if(key !== 'c' && key !== 'x' && key !== 'insert') return;
      blockCopyUnlessLicense(event);
