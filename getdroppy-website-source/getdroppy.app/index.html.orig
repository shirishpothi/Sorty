      { name: 'Coding Companion',  body: 'Live Claude, Codex and Cursor progress in your notch.', iconSrc: './assets/droplets/coding-companion.png' },
      { name: 'Droppy Cloud',      body: 'Drop a file, get a share link. Auto-cleanup after 24h.', iconSrc: './assets/droplets/droppy-cloud.webp' },
      { name: 'Thaw',              body: 'Hide menu bar items, then summon them with a tap.',     iconSrc: './assets/droplets/thaw.png' },
      { name: 'Reminders',         body: 'Capture tasks in plain language. Syncs to Apple Reminders.', iconSrc: './assets/droplets/reminders.png' },
      { name: 'LiquidMouse',       body: 'Smooth external mouse scrolling with reverse toggle.',  iconSrc: './assets/droplets/liquidmouse.webp' },
      { name: 'Thunderstorm',      body: 'Universal search and clipboard launcher, one shortcut.', iconSrc: './assets/droplets/thunderstorm.png' },
      { name: 'High Alert',        body: 'Keep your Mac awake on a timer or until you say stop.', iconSrc: './assets/droplets/high-alert.png' },
      { name: 'Pomodoro',          body: 'Focus timer that lives in the notch with live progress.', iconSrc: './assets/droplets/pomodoro.png' },
      { name: 'Meeting Controls',  body: 'Mute, camera and share for Zoom, Teams and Meet.',      iconSrc: './assets/droplets/meeting-controls.png' }
    ];

    var dropletsYtId = 'zebUcVFTFK8';
    var dropletsYtParams = 'autoplay=1&mute=1&loop=1&playlist=' + dropletsYtId + '&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1&fs=0&cc_load_policy=0&enablejsapi=1';

    var dropletMarquee = [
      { name: 'Droppy Cloud', desc: 'instant file sharing service' },
      { name: 'Window Snap', desc: 'snap windows like Magnet' },
      { name: 'Reminders', desc: 'view and add events and tasks with natural language, syncs with iOS' },
      { name: 'Element Capture', desc: 'full screenshot editor, color picker, capturing elements of your screen and more' },
      { name: 'Mechey', desc: 'mechanical keys for every keystroke' },
      { name: 'Pomodoro', desc: 'your timers, your ease of mind' },
      { name: 'High Alert', desc: 'keep your Mac awake' },
      { name: 'Coding Companion', desc: 'live Claude, Codex and Cursor progress in your notch' },
      { name: 'Thaw', desc: 'hide menu bar items, summon them with a tap' },
      { name: 'LiquidMouse', desc: 'smooth external mouse scrolling' },
      { name: 'Thunderstorm', desc: 'universal search and clipboard launcher' },
      { name: 'Meeting Controls', desc: 'mute, camera and share for Zoom, Teams and Meet' },
      { name: 'And many more', desc: '' }
    ];

    var marqueeHTML = '<div class="droppy-droplets-marquee" aria-hidden="false">' +
      '<div class="droppy-droplets-marquee-track">';
    var dupSeq = dropletMarquee.concat(dropletMarquee);
    dupSeq.forEach(function(d){
      marqueeHTML += '<span class="droppy-droplets-marquee-item">' +
        '<span class="droppy-droplets-marquee-name">' + d.name + '</span>' +
        (d.desc ? '<span class="droppy-droplets-marquee-desc">' + d.desc + '</span>' : '') +
      '</span>';
      marqueeHTML += '<span class="droppy-droplets-marquee-sep" aria-hidden="true">·</span>';
    });
    marqueeHTML += '</div></div>';

    section.innerHTML =
      '<div class="droppy-droplets-header">' +
        '<h2 class="droppy-droplets-title">Just add Droplets</h2>' +
        '<p class="droppy-droplets-body">Expand your experience with free to use and install Droplets. Toggle on what fits your workflow, ignore the rest.</p>' +
        '<p class="droppy-droplets-body droppy-droplets-body-secondary">Droppy <span class="droppy-droplets-can">can</span> compete with full-on apps, by offering them as an extension for free.</p>' +
      '</div>' +
      '<div class="droppy-droplets-video">' +
        '<iframe class="droppy-droplets-youtube-embed" src="https://www.youtube-nocookie.com/embed/' + dropletsYtId + '?' + dropletsYtParams + '" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" loading="lazy" title="Droppy Droplets demo" referrerpolicy="strict-origin-when-cross-origin"></iframe>' +
        '<button type="button" class="droppy-droplets-sound-toggle is-muted" aria-label="Unmute video">' +
          '<svg class="droppy-droplets-sound-icon-on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>' +
          '<svg class="droppy-droplets-sound-icon-off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>' +
        '</button>' +
      '</div>' +
      marqueeHTML;

    icons.appendChild(section);

    var iframe = section.querySelector('.droppy-droplets-youtube-embed');
    var soundBtn = section.querySelector('.droppy-droplets-sound-toggle');
    if(iframe && soundBtn){
      var muted = true;
      soundBtn.addEventListener('click', function(){
        muted = !muted;
        soundBtn.classList.toggle('is-muted', muted);
        soundBtn.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
        try {
          iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: muted ? 'mute' : 'unMute', args: [] }), '*');
        } catch (_) {}
      });
    }
  }

  function stylePricingIncludesWithChecks(pricing){
    if(!pricing) return;
    var legacyShelfBasketLabel = 'Access to core features and Shelf/Basket';
    var unifiedShelfBasketLabel = 'Access to all core features + future updates';
    var includeLabels = [
      'One-time purchase',
      unifiedShelfBasketLabel,
      legacyShelfBasketLabel,
      'Lifetime updates'
    ];

    pricing.querySelectorAll('.framer-text').forEach(function(node){
      var baseText = (node.dataset.droppyIncludeBase || node.textContent || '').replace(/^\u2713\s*/, '').trim();
      if(baseText === legacyShelfBasketLabel){
        baseText = unifiedShelfBasketLabel;
        node.textContent = unifiedShelfBasketLabel;
      }
      if(includeLabels.indexOf(baseText) === -1) return;
      node.dataset.droppyIncludeBase = baseText;
      node.classList.add('droppy-pricing-include-check');
      if(baseText === 'One-time purchase'){
        node.setAttribute('data-droppy-pill', 'mint');
      } else if(baseText === unifiedShelfBasketLabel || baseText === legacyShelfBasketLabel){
        node.setAttribute('data-droppy-pill', 'sky');
      } else if(baseText === 'Lifetime updates'){
        node.setAttribute('data-droppy-pill', 'lavender');
      }
      node.style.setProperty('margin-left', '0px', 'important');
      node.style.setProperty('margin-right', '0px', 'important');
      node.style.textAlign = 'center';
      node.style.setProperty('--framer-text-alignment', 'center');
    });
  }

  function tightenPricingAlignments(pricing){
    // Run after marquees are built. Two micro-adjustments:
    //   1) Subtitle top should match "What's Included" heading top.
    //   2) Purchase button bottom should match the marquee bottom so
    //      the two columns end at the same y line.
    function pv(scope, sel){
      return Array.from(scope.querySelectorAll(sel)).find(function(el){
        var r = el.getBoundingClientRect();
        return r.width > 0 && r.height > 0;
      });
    }
    var subtitle = pv(pricing, '[data-framer-name="Perfect for everyday workflows."]');
    var heading  = pv(pricing, '.framer-1og8yt1, .framer-oj175');
    var button   = pv(pricing, '.framer-1j2jw12-container');
    var stack    = pv(pricing, '.droppy-pricing-marquees');

    // 1) Align subtitle top with heading top by nudging the heading.
    if(subtitle && heading){
      var subTop  = subtitle.getBoundingClientRect().top;
      var headTop = heading.getBoundingClientRect().top;
      var diff    = subTop - headTop;
      if(Math.abs(diff) > 1){
        var currentMT = parseFloat(getComputedStyle(heading).marginTop) || 0;
        heading.style.setProperty('margin-top', Math.round(currentMT + diff) + 'px', 'important');
      }
    }
    // 2) After the heading shift the marquee follows; re-equalize the
    //    heading→marquee gap to match the subtitle→button gap.
    if(stack){
      var container = stack.closest('[data-framer-name="Right Container"]');
      if(container) applyMarqueeTopSpacing(pricing, container, stack);
    }
    // (Button bottom is intentionally NOT forced to match marquee bottom:
    // doing so via margin-top on the button breaks the column's vertical
    // centering and unaligns title↔price tops. The two columns now end
    // at different y, but the card's outer padding stays uniform at 72px.)
  }

  function applyMarqueeTopSpacing(pricing, container, stack){
    // Mirror the spacing between subtitle ("Stop fighting macOS…") and
    // the Purchase License button on the left side of the card, applied
    // as the gap between "What's Included" and the marquee stack.
    function pickVisible(scope, selector){
      return Array.from(scope.querySelectorAll(selector)).find(function(el){
        var r = el.getBoundingClientRect();
        return r.width > 0 && r.height > 0;
      });
    }
    var subtitle = pickVisible(pricing, '[data-framer-name="Perfect for everyday workflows."]');
    var button   = pickVisible(pricing, '.framer-1j2jw12-container');
    var heading  = pickVisible(container, '.framer-1og8yt1, .framer-oj175');
    if(!subtitle || !button || !heading) return;
    var subBottom  = subtitle.getBoundingClientRect().bottom;
    var btnTop     = button.getBoundingClientRect().top;
    var refGap     = btnTop - subBottom;
    if(refGap < 4 || refGap > 400) return;
    var stackTop   = stack.getBoundingClientRect().top;
    var headBottom = heading.getBoundingClientRect().bottom;
    var currentGap = stackTop - headBottom;
    var delta      = refGap - currentGap;
    if(Math.abs(delta) < 1) return;
    var currentTop = parseFloat(getComputedStyle(stack).marginTop) || 0;
    var nextTop    = Math.max(0, currentTop + delta);
    stack.style.setProperty('margin-top', Math.round(nextTop) + 'px', 'important');
  }

  function hideLegacyIncludeWrappers(pricing){
    // The framer wrappers around the (now hidden) checklist rows still
    // reserve vertical space below the marquee. Walk up from each row
    // text to the nearest "*-container" wrapper and hide that — keeps
    // the responsive ssr-variants intact while collapsing the wrapper.
    pricing.querySelectorAll('.droppy-pricing-include-check').forEach(function(row){
      var wrapper = row.closest('[class*="-container"]');
      if(wrapper) wrapper.style.setProperty('display', 'none', 'important');
    });
  }

  function buildPricingMarquees(pricing){
    if(!pricing) return;
    hideLegacyIncludeWrappers(pricing);
    var ROWS = [
      'Shelf · Basket · Termi-Notch · Notchface · Mechey · Notify me · Pomodoro · Reminders · High Alert',
      'Element Capture · Window Snap · Voice Transcribe · Video Target Size · AI Background Removal · Finder Services · Alfred Workflow · Thaw',
      'Now Playing · Battery · AirPods · Volume · Brightness · Calendar · Spotify · Apple Music · Droppy Cloud · Lock-screen widgets · Liquid Glass',
      'One-time purchase · Lifetime license · Lifetime updates · All future droplets · No subscription · macOS native · Privacy-first'
    ];
    pricing.querySelectorAll('[data-framer-name="Right Container"]').forEach(function(container){
      if(container.querySelector('.droppy-pricing-marquees')) return;
      var stack = document.createElement('div');
      stack.className = 'droppy-pricing-marquees';
      ROWS.forEach(function(line){
        var marquee = document.createElement('div');
        marquee.className = 'droppy-marquee';
        var track = document.createElement('div');
        track.className = 'droppy-marquee-track';
        // Triple the content so that the first segment alone already
        // overflows the container width on common viewports, ensuring the
        // scroll always shows motion and the seamless loop has enough
        // material to translate across.
        var content = (line + ' · ').repeat(3);
        var seg1 = document.createElement('span');
        seg1.className = 'droppy-marquee-segment';
        seg1.textContent = content;
        var seg2 = seg1.cloneNode(true);
        seg2.setAttribute('aria-hidden', 'true');
        track.appendChild(seg1);
        track.appendChild(seg2);
        marquee.appendChild(track);
        stack.appendChild(marquee);
      });
      // Insert as a direct sibling of "What's Included" inside the inner
       // .framer-1bct8fq Container, so the empty framer wrappers left over
      // by the hidden checklist sit below the marquee instead of above it.
      var heading = container.querySelector('.framer-1og8yt1, .framer-oj175');
      if(heading && heading.parentElement){
        heading.parentElement.insertBefore(stack, heading.nextSibling);
      } else {
        container.appendChild(stack);
      }
      // Match width to the actual ink width of the "$9.99 $6.99" text
      // above (not its full-width framer wrapper). Use a Range so we get
      // the rendered text box, not the parent container. Then match the
      // top margin to the same gap as subtitle→Purchase button on the
      // left side of the card.
      requestAnimationFrame(function(){
        if(window.matchMedia('(max-width: 809px)').matches){
          // Phones: the marquees span the card, not the price column.
          stack.style.removeProperty('width');
          stack.style.removeProperty('max-width');
          applyMarqueeTopSpacing(pricing, container, stack);
          return;
        }
        var priceText = container.querySelector('.framer-1p1pqcz .framer-text') ||
                        container.querySelector('.framer-1p1pqcz');
        if(priceText){
          var range = document.createRange();
          try {
            range.selectNodeContents(priceText);
            var w = range.getBoundingClientRect().width;
            if(w > 20){
              // Pad slightly so the fade doesn't clip dollar signs. Use
              // !important to beat the Right Container > * width:100%.
              var px = Math.round(w + 12) + 'px';
              stack.style.setProperty('width', px, 'important');
              stack.style.setProperty('max-width', px, 'important');
            }
          } catch(_) {}
        }
        applyMarqueeTopSpacing(pricing, container, stack);
      });
    });
  }

  function buildBareNavBar(){
    var container = document.querySelector('.framer-1wzrkvf-container');
    if(!container) return;
    if(container.querySelector('.droppy-bare-nav')) return;

    var nav = document.createElement('nav');
    nav.className = 'droppy-bare-nav';
    nav.setAttribute('aria-label', 'Primary');

    /* Left: logo */
    var logo = document.createElement('a');
    logo.className = 'droppy-bare-nav-logo';
    logo.href = '#hero';
    logo.setAttribute('aria-label', 'Droppy home');
    var logoImg = document.createElement('img');
    logoImg.src = './assets/app-icon.png';
    logoImg.alt = '';
    logoImg.decoding = 'async';
    logoImg.loading = 'eager';
    logo.appendChild(logoImg);
    nav.appendChild(logo);

    /* Center: links */
    var links = document.createElement('div');
    links.className = 'droppy-bare-nav-links';
    var items = [
      { label: 'Home',       href: '#hero'    },
      { label: 'FAQ',        href: '#faq',    trigger: 'faq' },
      { label: 'Pricing',    href: '#pricing' },
      { label: 'Purchase',   href: '#purchase', cta: true, purchaseTrigger: true }
    ];
    items.forEach(function(item){
      var a = document.createElement('a');
      a.className = 'droppy-bare-nav-link';
      if(item.cta){
        a.className += ' is-cta';
      }
      a.href = item.href;
      a.textContent = item.label;
      if(item.external){
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      }
      if(item.trigger === 'faq'){
        a.setAttribute('data-droppy-faq-trigger', '1');
      }
      if(item.purchaseTrigger){
        a.setAttribute('data-droppy-purchase-trigger', '1');
      }
      links.appendChild(a);
    });
    nav.appendChild(links);

    /* Right: Reddit + Discord icons */
    var social = document.createElement('div');
    social.className = 'droppy-bare-nav-social';

    var reddit = document.createElement('a');
    reddit.className = 'droppy-bare-nav-social-icon droppy-bare-nav-reddit';
    reddit.href = 'https://www.reddit.com/r/DroppyforMac/';
    reddit.target = '_blank';
    reddit.rel = 'noopener noreferrer';
    reddit.setAttribute('aria-label', 'Visit the Droppy subreddit');
    reddit.innerHTML =
      '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">' +
        '<path d="M22 12.06a1.95 1.95 0 0 0-3.3-1.4 9.5 9.5 0 0 0-5.18-1.65l.9-4.18 2.9.62a1.4 1.4 0 1 0 .14-.62l-3.24-.7a.31.31 0 0 0-.37.24l-1 4.64A9.5 9.5 0 0 0 7.5 10.66a1.95 1.95 0 1 0-2.16 3.16 3.7 3.7 0 0 0-.04.62c0 3.16 3.67 5.72 8.2 5.72s8.2-2.56 8.2-5.72c0-.21-.01-.42-.04-.62A1.94 1.94 0 0 0 22 12.06ZM8.6 13.5a1.4 1.4 0 1 1 2.8 0 1.4 1.4 0 0 1-2.8 0Zm7.85 3.9c-1 1-2.6 1.1-3.95 1.1s-2.95-.1-3.95-1.1a.43.43 0 0 1 .6-.6c.66.65 2.06.88 3.35.88s2.7-.23 3.35-.88a.43.43 0 1 1 .6.6Zm-.1-2.5a1.4 1.4 0 1 1 0-2.8 1.4 1.4 0 0 1 0 2.8Z"/>' +
      '</svg>';
    social.appendChild(reddit);

    /* Changelog pill, sitting just left of the Discord icon. Label fills in
       with the newest release date once changelog.json loads. */
    var updatePill = document.createElement('button');
    updatePill.type = 'button';
    updatePill.className = 'droppy-bare-nav-update';
    updatePill.setAttribute('aria-label', 'See what’s new in Droppy');
    updatePill.setAttribute('data-droppy-changelog-trigger', '1');
    updatePill.innerHTML =
      '<span class="droppy-bare-nav-update-label">Update</span>';
    updatePill.addEventListener('click', function(){ openChangelogModal(); });
    social.appendChild(updatePill);
    loadChangelogData().then(function(releases){
      if(releases && releases.length){
        var when = formatNavUpdateDate(releases[0].date);
        var label = updatePill.querySelector('.droppy-bare-nav-update-label');
        if(label && when) label.textContent = 'Update: ' + when;
      }
    });

    var discord = document.createElement('a');
    discord.className = 'droppy-bare-nav-social-icon droppy-bare-nav-discord';
    discord.href = 'https://discord.gg/weJjpkDnQr';
    discord.target = '_blank';
    discord.rel = 'noopener noreferrer';
    discord.setAttribute('aria-label', 'Join the Droppy Discord');
    discord.innerHTML =
      '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">' +
        '<path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371 13.327 13.327 0 0 0-.608 1.2526 18.2699 18.2699 0 0 0-5.4875 0 12.6404 12.6404 0 0 0-.6171-1.2526.077.077 0 0 0-.0785-.037A19.7363 19.7363 0 0 0 3.677 4.3698a.0699.0699 0 0 0-.0321.0277C.5334 9.0467-.319 13.58.0992 18.0578a.0824.0824 0 0 0 .0312.0561 19.9 19.9 0 0 0 5.9933 3.0294.0777.0777 0 0 0 .0842-.0276 14.2 14.2 0 0 0 1.226-1.9942.076.076 0 0 0-.0416-.1057 13.1066 13.1066 0 0 1-1.872-.892.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.074.074 0 0 1 .0785.0095c.1202.099.246.198.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067 15.91 15.91 0 0 0 1.226 1.9933.076.076 0 0 0 .0842.0286 19.85 19.85 0 0 0 6.0022-3.0294.0775.0775 0 0 0 .0313-.0552c.501-5.177-.838-9.6735-3.5491-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1568-1.0857-2.1568-2.419 0-1.3332.9555-2.4189 2.1568-2.4189 1.2108 0 2.1761 1.0952 2.1568 2.4189 0 1.3332-.9555 2.419-2.1568 2.419zm7.9748 0c-1.1825 0-2.1568-1.0857-2.1568-2.419 0-1.3332.9554-2.4189 2.1568-2.4189 1.2108 0 2.1761 1.0952 2.1568 2.4189 0 1.3332-.946 2.419-2.1568 2.419z"/>' +
      '</svg>';
    social.appendChild(discord);

    nav.appendChild(social);

    container.appendChild(nav);

    /* Wire FAQ trigger */
    try { wireFaqTriggers(); } catch(_) {}
  }

  function pruneObsoleteNavLinks(){
    /* Strip "Features", "Droplets" from desktop nav + footer Quick Links,
       and "Visit getdroppy.app" from footer Community. */
    var KILL = [
      { label: 'features',           hrefMatch: '#features' },
      { label: 'droplets',           hrefMatch: '#gallery'  },
      { label: 'visit getdroppy.app', hrefMatch: 'getdroppy.app' }
    ];
    var CONTAINER_NAMES = new Set(['container','big','small','menu','footer']);
    document.querySelectorAll('a').forEach(function(a){
      var label = normalizedText(a.textContent || '');
      var href = (a.getAttribute('href') || '').toLowerCase();
      var match = KILL.find(function(k){
        if(k.label !== label) return false;
        if(k.hrefMatch && href.indexOf(k.hrefMatch) === -1) return false;
        return true;
      });
      if(!match) return;

      /* Hide the immediate framer container that holds JUST this <a>.
         Walk: <a> -> parent div (link slot) -> stop. Never climb to a
         container that holds multiple siblings. */
      var wrapper = a.parentElement;
      while(wrapper && wrapper.tagName !== 'DIV') wrapper = wrapper.parentElement;
      if(!wrapper) { a.style.display = 'none'; return; }

      /* If wrapper holds more than just our <a>, hide the <a> alone */
      var siblingLinks = wrapper.querySelectorAll('a');
      if(siblingLinks.length > 1){
        a.style.display = 'none';
        return;
      }

      /* Safety: if wrapper is a known container (holds multiple items), bail */
      var wrapperName = (wrapper.getAttribute('data-framer-name') || '').toLowerCase();
      if(CONTAINER_NAMES.has(wrapperName)){
        a.style.display = 'none';
        return;
      }

      wrapper.style.display = 'none';

      /* Hide adjacent separator dot to avoid stranded "·" */
      var sep = wrapper.nextElementSibling;
      if(sep && /Seprator|Separator/i.test(sep.getAttribute('data-framer-name') || '')){
        sep.style.display = 'none';
      } else {
        var prevSep = wrapper.previousElementSibling;
        if(prevSep && /Seprator|Separator/i.test(prevSep.getAttribute('data-framer-name') || '')){
          prevSep.style.display = 'none';
        }
      }
    });
  }

  function rewriteCommunityLinks(){
    buildBareNavBar();
    pruneObsoleteNavLinks();
    document.querySelectorAll('a').forEach(function(a){
      var label = normalizedText(a.textContent || '');
      if(!label) return;

      if(label.indexOf('source-available') !== -1){
        a.style.display = 'none';
        if(a.parentElement) a.parentElement.style.display = 'none';
        return;
      }

      if(label.indexOf('join our discord') !== -1){
        a.href = 'https://discord.gg/weJjpkDnQr';
        a.target = '_blank';
        a.rel = 'noopener';
        a.setAttribute('data-droppy-discord', '1');

        var iconHost = a.querySelector('.framer-1dyc4kg-container');
        if(iconHost){
          iconHost.style.opacity = '1';
          if(!iconHost.querySelector('.droppy-discord-icon')){
            iconHost.appendChild(createDiscordIconNode());
          }
        } else if(!a.querySelector('.droppy-discord-icon')){
          a.insertBefore(createDiscordIconNode(), a.firstChild);
        }

        a.querySelectorAll('.framer-text').forEach(function(node){
          if(normalizedText(node.textContent || '') === 'join our discord' || normalizedText(node.textContent || '') === 'discord'){
            node.textContent = 'Discord';
          }
        });
        return;
      }

      if(label.indexOf('hi@getdroppy.app') !== -1){
        /* Skip inline email mentions inside the FAQ / legal modals — they
           should render as plain links without the floating mail icon. */
        if(a.classList.contains('droppy-faq-link') ||
           a.classList.contains('droppy-legal-link') ||
           a.closest('.droppy-faq-modal') ||
           a.closest('.droppy-legal-modal')){
          return;
        }
        a.href = 'mailto:hi@getdroppy.app';
        a.target = '_blank';
        a.rel = 'noopener';
        a.setAttribute('data-droppy-email', '1');
        var emailIconHost = a.querySelector('.framer-1dyc4kg-container');
        if(emailIconHost){
          emailIconHost.style.opacity = '1';
          if(!emailIconHost.querySelector('.droppy-mail-icon')){
            emailIconHost.appendChild(createMailIconNode());
          }
        } else if(!a.querySelector('.droppy-mail-icon')){
          a.insertBefore(createMailIconNode(), a.firstChild);
        }
        a.querySelectorAll('.framer-text').forEach(function(node){
          var textLabel = normalizedText(node.textContent || '');
          if(textLabel === 'hi@getdroppy.app'){
            node.textContent = 'Hi@getdroppy.app';
          }
        });
      }
    });

    document.querySelectorAll('.framer-text').forEach(function(node){
      if(normalizedText(node.textContent || '') === 'hi@getdroppy.app'){
        node.textContent = 'hi@getdroppy.app';
      }
    });
    document.querySelectorAll('a[href^="mailto:"]').forEach(function(a){
      if((a.getAttribute('href') || '').toLowerCase().indexOf('hi@getdroppy.app') !== -1){
        a.setAttribute('href', 'mailto:hi@getdroppy.app');
      }
    });

    document.querySelectorAll('a[data-framer-name="Social Button"]').forEach(function(a){
      var href = (a.getAttribute('href') || '').toLowerCase();
      var label = '';
      if(href.indexOf('x.com') !== -1 || href.indexOf('twitter.com') !== -1) label = 'X';
      else if(href.indexOf('linkedin.com') !== -1) label = 'LinkedIn';
      else if(href.indexOf('instagram.com') !== -1) label = 'Instagram';
      if(!label) return;

      var existingLabel = a.querySelector('.droppy-social-label');
      if(existingLabel){
        existingLabel.textContent = label;
      } else {
        var textNode = document.createElement('span');
        textNode.className = 'droppy-social-label framer-text';
        textNode.textContent = label;
        a.appendChild(textNode);
      }
      a.setAttribute('data-droppy-social-label', '1');
      a.setAttribute('aria-label', label);
    });
  }

  function ensureMainSectionsVisible(){
    var main = document.querySelector('main[data-framer-name="Main"]') || document.querySelector('main');
    if(!main) return;

    main.querySelectorAll('section').forEach(function(section){
      if(section.id === 'hero') return;
      section.querySelectorAll('[style*="opacity:0"]:not([data-framer-appear-id]),[style*="opacity: 0"]:not([data-framer-appear-id]),[style*="opacity:0.001"]:not([data-framer-appear-id])').forEach(function(node){
        if(!(node instanceof HTMLElement)) return;
        var computed = window.getComputedStyle(node);
        if(computed.display === 'none' || computed.visibility === 'hidden') return;
        if(parseFloat(computed.opacity) > 0.05) return;
        node.style.opacity = '1';
        if(!node.style.willChange || node.style.willChange === 'transform'){
          node.style.willChange = 'auto';
        }
      });
    });
  }

  function applyDroppyOverrides(options){
    options = options || {};
    var skipHeroStructure = !!options.skipHeroStructure;
    var skipAnimationRefresh = !!options.skipAnimationRefresh;
    rewriteStaticAssetImages(document);
    installCopyLock();
    wireDownloadButtonsToLatestRelease();
    ensureMainSectionsVisible();
    removeAccountEntryPoints();
    wireInPageNav();
    wireMobileMenuFallback();
    if(!skipHeroStructure){
      applyMobileHeroHeadlineLayout();
      animateHeroHeadingLetters();
    }
    applyFeaturesWorkflowCards();
    applyGalleryBasketDemo();
    if(!skipHeroStructure){
      forceHeroPrimaryLineSingleLine();
    }
    fixNativeProductivityCTA();
    applyDropletsGrid();
    rewriteCommunityLinks();

    if(!skipHeroStructure){
      ensureHeroFirstPaintStructure();
    }

    var pricing = document.getElementById('pricing');
    if(pricing){
      var activePriceText = formatIntentTotal(checkoutBasePrice.amountCents, checkoutBasePrice.currency);
      var standardPriceText = formatIntentTotal(checkoutPriceConfig.standardAmountCents, checkoutPriceConfig.currency);
      var priceSummaryHtml = 'Stop fighting macOS, ease your mind with Droppy.';
      setTextAll(pricing.querySelectorAll('[data-framer-name="Basic"] .framer-text'), 'Lifetime License');
      setHtmlAll(pricing.querySelectorAll('[data-framer-name="Perfect for everyday workflows."] .framer-text'), priceSummaryHtml);

      if(isCheckoutLaunchSaleActive() && activePriceText !== standardPriceText){
        setHtmlAll(pricing.querySelectorAll('.framer-1p1pqcz .framer-text'),
          '<span class="droppy-pricing-was">' + standardPriceText + '</span><span class="droppy-pricing-now">' + activePriceText + '</span>');
      } else {
        setTextAll(pricing.querySelectorAll('.framer-1p1pqcz .framer-text'), activePriceText);
      }
      setTextAll(pricing.querySelectorAll('.framer-1og8yt1 .framer-text, .framer-oj175 .framer-text'), "What's Included");
      pricing.querySelectorAll('.framer-1og8yt1 .framer-text, .framer-oj175 .framer-text').forEach(function(node){
        if(node.querySelector('.droppy-included-badge')) return;
        var badge = document.createElement('span');
        badge.className = 'droppy-included-badge';
        badge.setAttribute('aria-hidden', 'true');
        badge.innerHTML =
          '<svg class="droppy-included-badge-burst" viewBox="0 0 100 100">' +
            '<g fill="currentColor">' +
              '<circle cx="50" cy="50" r="32"/>' +
              '<circle cx="50" cy="15" r="10"/><circle cx="68" cy="20" r="10"/>' +
              '<circle cx="80" cy="32" r="10"/><circle cx="85" cy="50" r="10"/>' +
              '<circle cx="80" cy="68" r="10"/><circle cx="68" cy="80" r="10"/>' +
              '<circle cx="50" cy="85" r="10"/><circle cx="32" cy="80" r="10"/>' +
              '<circle cx="20" cy="68" r="10"/><circle cx="15" cy="50" r="10"/>' +
              '<circle cx="20" cy="32" r="10"/><circle cx="32" cy="20" r="10"/>' +
            '</g>' +
          '</svg>' +
          '<svg class="droppy-included-badge-check" viewBox="0 0 24 24">' +
            '<path d="M6 12.5 L10.5 17 L18 8" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>' +
          '</svg>';
        node.insertBefore(badge, node.firstChild);
      });
      setTextAll(
        pricing.querySelectorAll('[data-framer-name="Access to core features and Shelf/Basket"] .framer-text'),
        'Access to all core features + future updates'
      );
      pricing.querySelectorAll('.framer-text').forEach(function(node){
        if(normalizedText(node.textContent || '') !== 'access to core features and shelf/basket') return;
        node.textContent = 'Access to all core features + future updates';
      });
      stylePricingIncludesWithChecks(pricing);
      buildPricingMarquees(pricing);

      pricing.querySelectorAll('.framer-1j2jw12-container a').forEach(function(a){
        a.setAttribute('data-droppy-purchase-trigger', '1');
        a.removeAttribute('target');
      });
      setTextAll(pricing.querySelectorAll('.framer-1j2jw12-container .framer-text'), 'Purchase License');
      pricing.querySelectorAll('[data-framer-name="Cards 2"]').forEach(function(card){
        card.remove();
      });
    }

    document.querySelectorAll('a').forEach(function(a){
      var label = (a.textContent || '').trim().toLowerCase();
      if(label === 'purchase a license' || label === 'purchase license'){
        a.setAttribute('data-droppy-purchase-trigger', '1');
      }
    });
    wirePurchaseTriggers();
    wireReclaimTriggers();
    wireFaqTriggers();
    wireLegalTriggers();
    wireInstallInstructionsTrigger();
    ensureRecoverLicenseButton();
    ensureMainSectionsVisible();
    applyBelowFoldLazyMedia();
    startDroppyLazyImageObserver();
    if(!skipAnimationRefresh){
      if(typeof window.initializeDroppyGsap === 'function') window.initializeDroppyGsap();
      if(!window.matchMedia('(max-width: 809px)').matches && window._droppyHorizontalScroll){
        window._droppyHorizontalScroll.init();
        window._droppyHorizontalScroll.patchAnchorLinks();
      }
    }
  }

  function initializePurchaseModalState(){
    if(purchaseModalState.initialized) return;
    purchaseModalState.initialized = true;
    createPurchaseModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closePurchaseModal();
    });

    var query = new URLSearchParams(window.location.search);
    if(query.get('canceled') === '1'){
      setModalStatus('Checkout was canceled. You can try again.', 'error');
      openPurchaseModal();
    } else if((window.location.hash || '').toLowerCase() === '#purchase'){
      openPurchaseModal();
    }
  }
  function initializeReclaimModalState(){
    if(reclaimModalState.initialized) return;
    reclaimModalState.initialized = true;
    createReclaimModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closeReclaimModal();
    });

    var hash = (window.location.hash || '').toLowerCase();
    if(hash === '#reclaim-license' || hash === '#reclaim'){
      openReclaimModal();
    }
  }
  function initializeAccountModalState(){
    if(accountModalState.initialized) return;
    accountModalState.initialized = true;
    createAccountModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closeAccountModal();
    });

    if((window.location.hash || '').toLowerCase() === '#account'){
      openAccountModal();
    }
  }
  function initializeFaqModalState(){
    if(faqModalState.initialized) return;
    faqModalState.initialized = true;
    createFaqModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closeFaqModal();
    });

    if((window.location.hash || '').toLowerCase() === '#faq'){
      openFaqModal();
    }
  }
  function initializeLegalModalState(){
    if(legalModalState.initialized) return;
    legalModalState.initialized = true;
    createLegalModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closeLegalModal();
    });

    var hash = (window.location.hash || '').toLowerCase();
    if(hash === '#privacy-policy'){
      openLegalModal('privacy');
    } else if(hash === '#terms-of-service' || hash === '#term-of-service' || hash === '#terms'){
      openLegalModal('terms');
    }
  }

  /* Framer hydration can replace the hero subtree while the GSAP intro is
     mid-flight: the timeline keeps animating the detached nodes and the
     swapped-in nodes stay frozen at the intro's initial opacity-0/blur state.
     Re-initializing snaps the fresh nodes to the intro end state. */
  function ensureHeroIntroIntegrity(){
    var attempts = 0;
    var maxAttempts = 5;
    var timer = window.setInterval(function(){
      attempts += 1;
      var nodes = Array.prototype.slice.call(document.querySelectorAll(
        '#hero .framer-1rmrzte .framer-text, #hero .framer-1yylnnf .framer-text, #hero .droppy-hero-cta-row a'
      ));
      var frozen = nodes.length > 0 && nodes.some(function(node){
        var style = window.getComputedStyle(node);
        if(style.display === 'none' || style.visibility === 'hidden') return false;
        if(parseFloat(style.opacity) > 0.05) return false;
        if(node.getAnimations && node.getAnimations().some(function(anim){ return anim.playState === 'running'; })) return false;
        return true;
      });
      if(frozen && typeof window.initializeDroppyGsap === 'function' && window.gsap){
        window.clearInterval(timer);
        window.initializeDroppyGsap();
        return;
      }
      if(attempts >= maxAttempts) window.clearInterval(timer);
    }, 1400);
  }

  ensureHeroFirstPaintStructure();

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){
      initializePurchaseModalState();
      initializeReclaimModalState();
      initializeFaqModalState();
      initializeLegalModalState();
      initializeInstallModalState();
      initializeChangelogModalState();
      applyDroppyOverrides();
    });
  } else {
    initializePurchaseModalState();
    initializeReclaimModalState();
    initializeFaqModalState();
    initializeLegalModalState();
    initializeInstallModalState();
    initializeChangelogModalState();
    applyDroppyOverrides();
  }
  window.addEventListener('load', function(){
    applyDroppyOverrides({ skipHeroStructure: true, skipAnimationRefresh: true });
    ensureHeroIntroIntegrity();
    setTimeout(function(){
      document.querySelectorAll('[style*="will-change"]').forEach(function(el){
        if(!(el instanceof HTMLElement)) return;
        if(el.getAnimations && el.getAnimations().some(function(a){ return a.playState === 'running'; })) return;
        var s = el.getAttribute('style') || '';
        var cleaned = s.replace(/will-change\s*:[^;]+;?/gi, '').replace(/;\s*;/g, ';').trim();
        if(cleaned){ el.setAttribute('style', cleaned); } else { el.removeAttribute('style'); }
      });
    }, 2200);
  });
})();
