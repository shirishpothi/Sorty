@media (min-width:1200px){#hero .framer-mk7lz9{position:relative!important;left:50%!important;transform:translateX(-50%)!important;width:max-content!important;max-width:none!important}#hero .framer-mk7lz9 .framer-1rmrzte,#hero .framer-mk7lz9 .framer-1yylnnf{width:max-content!important}#hero .framer-mk7lz9 .framer-1rmrzte .framer-text{white-space:nowrap!important;text-wrap:nowrap!important}}
@media (max-width:809px){#hero .framer-1ycnx3s-container.droppy-hero-cta-row{gap:10px}#hero .framer-wdvr1e{width:min(1680px,252vw)!important;bottom:-530px!important}#hero .framer-mk7lz9{left:auto!important;transform:none!important;width:100%!important}.droppy-license-modal{border-radius:24px;padding:20px 16px}.droppy-license-modal-header{grid-template-columns:1fr;gap:12px}.droppy-license-modal .droppy-license-meta{font-size:14px;white-space:normal;text-wrap:pretty}.droppy-license-modal .droppy-inline-continue{justify-self:start;min-height:54px;min-width:118px;padding:0 18px}.droppy-account-modal .droppy-account-auth-row,.droppy-account-modal .droppy-account-link-row{grid-template-columns:1fr;gap:8px}.droppy-account-modal input[type="email"],.droppy-account-modal input[type="text"]{height:54px;font-size:16px;padding:0 16px}.droppy-account-dock{display:none!important}.droppy-faq-modal{border-radius:22px;padding:18px 14px;max-height:min(90vh,860px)}.droppy-faq-modal .droppy-license-title{font-size:34px}.droppy-faq-scroll{max-height:min(72vh,640px);gap:10px}.droppy-faq-item{padding:12px 13px;border-radius:14px}}
@media (max-width:809px){.droppy-license-modal .droppy-license-title-wrap::before{width:96px;height:96px;left:50%;top:58%;opacity:.14}}
/* Phone hero: the section keeps a desktop-scale 120px stack gap that pushes the
   headline below the fold on phones. Tighten the rhythm and inset the video
   mock so the hero reads as one screen. */
@media (max-width:809px){
#hero{gap:30px!important;padding-top:72px!important}
#hero .droppy-hero-mac-mock{width:calc(100% - 28px)!important;margin:0 auto!important}
#hero .droppy-hero-logo-img{margin-bottom:20px!important}
}
/* Phone slides: mirror the desktop one-section-per-screen rhythm with native
   vertical scroll snapping. Each landing section becomes a full-viewport,
   vertically centered slide; sections taller than the viewport (pricing)
   scroll freely inside and snap at their edges. Scoped away from
   droppy-horizontal-scroll so it can never leak into the desktop mode. */
@media (max-width:809px){
html:not(.droppy-horizontal-scroll){scroll-snap-type:y mandatory}
html:not(.droppy-horizontal-scroll) main > section,
html:not(.droppy-horizontal-scroll) main > footer{scroll-snap-align:start}
html:not(.droppy-horizontal-scroll) main > section#hero{
min-height:100vh;
min-height:100svh;
justify-content:center!important;
}
html:not(.droppy-horizontal-scroll) main > section#features,
html:not(.droppy-horizontal-scroll) main > section#gallery,
html:not(.droppy-horizontal-scroll) main > section#icons,
html:not(.droppy-horizontal-scroll) main > section#cta{
min-height:100vh;
min-height:100svh;
display:flex;
flex-direction:column;
justify-content:center;
}
}
@media (prefers-reduced-motion:reduce){.droppy-license-modal-overlay,.droppy-license-modal,:where(button,input[type="button"],input[type="submit"],input[type="reset"],a[role="button"],a[class*="btn"],a[class*="button"],a.framer-9N3cB,a.framer-seHzO,button.framer-9N3cB,button.framer-seHzO){transition:none!important}.droppy-hero-letter,.droppy-blur-reveal-target{animation:none!important;opacity:1!important;filter:none!important;transform:none!important}:where(button,input[type="button"],input[type="submit"],input[type="reset"],a[role="button"],a[class*="btn"],a[class*="button"],a.framer-9N3cB,a.framer-seHzO,button.framer-9N3cB,button.framer-seHzO):hover,:where(button,input[type="button"],input[type="submit"],input[type="reset"],a[role="button"],a[class*="btn"],a[class*="button"],a.framer-9N3cB,a.framer-seHzO,button.framer-9N3cB,button.framer-seHzO):active{transform:none!important;filter:none!important}}
html,body,#main{max-width:100%;overflow-x:hidden!important}
html:not(.droppy-horizontal-scroll) #main,html:not(.droppy-horizontal-scroll) main[data-framer-name="Main"],html:not(.droppy-horizontal-scroll) [data-framer-root]{overflow-x:clip}
.droppy-license-modal,.droppy-faq-modal,.droppy-account-modal,.droppy-legal-modal{max-width:min(100vw - 28px,980px)}
.droppy-account-modal .droppy-account-row-head{flex-wrap:wrap}
.droppy-account-modal .droppy-account-row-head>*{min-width:0}
.droppy-account-modal .droppy-account-email,
