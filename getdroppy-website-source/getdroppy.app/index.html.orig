  function setTextAll(nodes, value){ nodes.forEach(function(el){ el.textContent = value; }); }
  function setHtmlAll(nodes, value){ nodes.forEach(function(el){ el.innerHTML = value; }); }
  function normalizedText(value){ return (value || '').replace(/\s+/g, ' ').trim().toLowerCase(); }
  function clamp01(value){ return Math.max(0, Math.min(1, Number.isFinite(value) ? value : 0)); }
  function lerp(start, end, progress){ return start + ((end - start) * clamp01(progress)); }
