@media (max-width:1199px){.droppy-account-dock{padding:0 10px}}
@media (min-width:1200px){.droppy-license-modal{width:min(100%,780px)}}
#gallery .framer-xcezjj{display:none!important}
#gallery .framer-1cjleze [style*="opacity:0"]{opacity:1!important}
#gallery .framer-1cjleze [style*="translateY("],#gallery .framer-1cjleze [style*="translateX("],#gallery .framer-1cjleze [style*="rotate("]{transform:none!important}
#gallery .framer-1cjleze section{opacity:1!important}
#gallery .framer-1cjleze ul{transform:none!important}
#how-it-works{display:none!important}
#icons.droppy-power-ready{padding-bottom:96px}
#icons .droppy-power-media{
position:absolute;
inset:0;
}
#icons .droppy-power-media img{
display:block;
width:100%;
height:100%;
object-fit:cover;
object-position:center;
transition:transform .42s cubic-bezier(.22,.61,.36,1),filter .42s cubic-bezier(.22,.61,.36,1),opacity .42s cubic-bezier(.22,.61,.36,1);
will-change:transform,filter,opacity;
}
#icons .droppy-power-overlay{
position:absolute;
inset:0;
z-index:2;
display:flex;
flex-direction:column;
justify-content:flex-end;
padding:28px 32px;
background:linear-gradient(180deg,rgba(0,0,0,0) 20%,rgba(0,0,0,.75) 100%);
border:none;
border-radius:0;
backdrop-filter:none;
-webkit-backdrop-filter:none;
text-shadow:0 2px 8px rgba(0,0,0,.7),0 1px 3px rgba(0,0,0,.5);
}
#icons .droppy-power-kicker{
margin:0 0 6px;
font:600 12px/1 "Inter","Inter Placeholder",sans-serif;
letter-spacing:.08em;
text-transform:uppercase;
color:rgba(158,205,250,.92);
}
#icons .droppy-power-title{
margin:0;
font:700 24px/1.15 "Inter","Inter Placeholder",sans-serif;
letter-spacing:-.02em;
color:#fff;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}
#icons .droppy-power-copy{
margin:6px 0 0;
font:400 15px/1.45 "Inter","Inter Placeholder",sans-serif;
letter-spacing:-.01em;
color:rgba(255,255,255,.8);
max-width:420px;
display:-webkit-box;
-webkit-line-clamp:2;
-webkit-box-orient:vertical;
overflow:hidden;
}
@media (max-width:1199px){
#icons .droppy-power-title{font-size:21px}
#icons .droppy-power-overlay{padding:22px 26px}
}
@media (max-width:809px){
