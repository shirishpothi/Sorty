  function linkifyLegalText(value){
    var safe = escapeHtml(value);
    safe = safe.replace(/(https?:\/\/[^\s<]+)/g, function(url){
      return '<a class="droppy-legal-link" href="' + url + '" target="_blank" rel="noopener">' + url + '</a>';
    });
    safe = safe.replace(/\b([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})\b/gi, function(email){
      return '<a class="droppy-legal-link" href="mailto:' + email + '">' + email + '</a>';
    });
    return safe;
