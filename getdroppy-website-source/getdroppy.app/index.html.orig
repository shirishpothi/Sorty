radial-gradient(95% 120% at 86% 74%,rgba(82,162,237,.4) 0%,rgba(82,162,237,.2) 38%,rgba(82,162,237,0) 74%),
linear-gradient(180deg,rgba(18,25,34,.92),rgba(11,17,26,.96))!important;
box-shadow:inset 0 1px 2px rgba(255,255,255,.16),0 18px 40px rgba(12,24,42,.34)!important;
}
/* --- Apple-Style Feature Showcase --- */
html:not(.droppy-horizontal-scroll) #features{overflow:visible!important;overflow-x:visible!important}
#features .droppy-feature-showcase{width:100%;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:160px}

/* --- Shared element styles --- */
#features .droppy-feat{opacity:0;transform:translateY(56px);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1)}
#features .droppy-feat.is-visible{opacity:1;transform:translateY(0)}
#features .droppy-feat-title{margin:0;font:700 56px/1.05 "Inter",sans-serif;letter-spacing:-.035em;color:#fff;text-wrap:balance}
#features .droppy-feat-body{margin:0;font:400 17px/1.65 "Inter",sans-serif;letter-spacing:-.005em;color:rgba(228,237,247,.65);max-width:600px;text-wrap:pretty}
#features .droppy-feat-img-wrap{position:relative;border-radius:20px;overflow:hidden}
#features .droppy-feat-img-wrap img{display:block;width:100%;height:auto;object-fit:contain}
#features .droppy-feat.is-visible .droppy-feat-img-wrap img{transform:none}#features .droppy-feat .droppy-feat-title,#features .droppy-feat .droppy-feat-body,#features .droppy-feat .droppy-feat-img-wrap{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
#features .droppy-feat.is-visible .droppy-feat-title{opacity:1;transform:translateY(0);transition-delay:.12s}
#features .droppy-feat.is-visible .droppy-feat-body{opacity:1;transform:translateY(0);transition-delay:.2s}
#features .droppy-feat.is-visible .droppy-feat-img-wrap{opacity:1;transform:translateY(0);transition-delay:.15s}

/* --- Variant 1: Hero + Stats (centered text, image below, stats beside image) --- */
#features .droppy-feat--hero-stats .droppy-feat-header{text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;margin-bottom:48px}
#features .droppy-feat--hero-stats .droppy-feat-body{text-align:center}
#features .droppy-feat--hero-stats .droppy-feat-visual{position:relative}
#features .droppy-feat--hero-stats .droppy-feat-img-wrap{border-radius:20px}
#features .droppy-feat--hero-stats .droppy-feat-stats{display:flex;justify-content:center;gap:64px;margin-top:40px}

/* --- Hero-stats video embed (replaces image when videoId is set) --- */
#features .droppy-feat--hero-stats .droppy-feat-visual:has(.droppy-feat-youtube-embed){
display:flex;
justify-content:center;
}
#features .droppy-feat-youtube-embed{
display:block;
width:100%;
max-width:980px;
aspect-ratio:16/9;
border:0;
border-radius:22px;
overflow:hidden;
background:#04070a;
box-shadow:0 30px 80px -30px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04);
}
#features .droppy-feat-sound-toggle{
position:absolute;
bottom:18px;
right:calc(50% - 470px + 18px);
width:40px;
height:40px;
border-radius:999px;
border:1px solid rgba(255,255,255,.14);
background:rgba(15,18,24,.55);
backdrop-filter:blur(20px) saturate(140%);
-webkit-backdrop-filter:blur(20px) saturate(140%);
color:#f1f5ff;
display:inline-flex;
align-items:center;
justify-content:center;
cursor:pointer;
padding:0;
box-shadow:0 10px 24px -10px rgba(0,0,0,.55);
transition:transform .25s ease, background .25s ease, border-color .25s ease, opacity .25s ease;
z-index:5;
opacity:.88;
}
#features .droppy-feat-sound-toggle:hover{
background:rgba(20,24,32,.7);
border-color:rgba(255,255,255,.22);
transform:scale(1.06);
opacity:1;
}
#features .droppy-feat-sound-toggle:active{transform:scale(.96)}
#features .droppy-feat-sound-toggle svg{width:16px;height:16px;display:block}
#features .droppy-feat-sound-toggle .droppy-feat-sound-icon-on{display:block}
#features .droppy-feat-sound-toggle .droppy-feat-sound-icon-off{display:none}
#features .droppy-feat-sound-toggle.is-muted .droppy-feat-sound-icon-on{display:none}
#features .droppy-feat-sound-toggle.is-muted .droppy-feat-sound-icon-off{display:block}

/* --- Scrolling marquee below the video --- */
#features .droppy-feat-marquee{
overflow:hidden;
margin-top:32px;
position:relative;
width:100%;
max-width:980px;
margin-left:auto;
margin-right:auto;
mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
}
#features .droppy-feat-marquee-track{
display:flex;
gap:0;
width:max-content;
animation:droppy-feat-marquee-scroll 38s linear infinite;
will-change:transform;
}
#features .droppy-feat-marquee-item{
font:500 13px/1 "Inter",sans-serif;
letter-spacing:.06em;
text-transform:uppercase;
color:rgba(228,237,247,.45);
white-space:nowrap;
padding:0 18px;
}
#features .droppy-feat-marquee-sep{
font:500 13px/1 "Inter",sans-serif;
color:rgba(228,237,247,.18);
}
@keyframes droppy-feat-marquee-scroll{
from{transform:translateX(0)}
to{transform:translateX(-50%)}
}
@media (max-width:809px){
#features .droppy-feat-sound-toggle{right:calc(50% - min(45vw, 470px) + 18px)}
#features .droppy-feat-marquee{margin-top:24px}
}/* --- Variant 2: Image left{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center}/* --- Variant 3: Centered showcase (text top,big image{display:flex;flex-direction:column;align-items:center;text-align:center}
#features .droppy-feat--centered .droppy-feat-header{display:flex;flex-direction:column;align-items:center;gap:14px;margin-bottom:48px}
#features .droppy-feat--centered .droppy-feat-body{text-align:center}
#features .droppy-feat--centered .droppy-feat-img-wrap{width:100%;max-width:900px;border-radius:20px}/* --- Variant 4: Full-bleed (text centered{display:flex;flex-direction:column;align-items:center;text-align:center}
#features .droppy-feat--full-bleed .droppy-feat-header{display:flex;flex-direction:column;align-items:center;gap:14px;margin-bottom:24px}
#features .droppy-feat--full-bleed .droppy-feat-body{text-align:center;margin-bottom:56px}
#features .droppy-feat--full-bleed .droppy-feat-img-wrap{width:calc(100% + 80px);max-width:none;border-radius:24px;margin:0 -40px}
#features .droppy-feat--full-bleed .droppy-feat-img-wrap img{transform:none}
#features .droppy-feat--full-bleed.is-visible .droppy-feat-img-wrap img{transform:none}
#features .droppy-feat--huds-compose .droppy-feat-header{display:flex;flex-direction:column;align-items:center;gap:14px;margin-bottom:24px}
#features .droppy-feat--huds-compose .droppy-feat-body{text-align:center;margin-bottom:56px}

/* Responsive */
@media (max-width:1199px){
#features .droppy-feat-title{font-size:44px}
#features .droppy-feat--img-text{gap:48px}
#features .droppy-feature-showcase{gap:120px}
#features .droppy-feat--full-bleed .droppy-feat-img-wrap{width:calc(100% + 48px);margin:0 -24px}
}
@media (max-width:809px){
#features{padding-top:32px;padding-bottom:32px}
#gallery{padding-top:32px;padding-bottom:32px}
#icons{padding-top:32px;padding-bottom:32px}
#cta{padding-top:32px;padding-bottom:32px}
#features .droppy-feat-title{font-size:32px}
#features .droppy-feat-body{font-size:15px}
#features .droppy-feature-showcase{gap:80px}
#features .droppy-feat-img-wrap{border-radius:16px}
#features .droppy-feat--hero-stats .droppy-feat-stats{flex-direction:column;gap:24px;align-items:center}
#features .droppy-feat--full-bleed .droppy-feat-img-wrap{width:100%;margin:0;border-radius:16px}
#features .droppy-feat--hero-stats .droppy-feat-header{margin-bottom:32px}
#features .droppy-feat--centered .droppy-feat-header{margin-bottom:32px}
