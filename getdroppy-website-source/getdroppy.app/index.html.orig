}

/* ===== Slide 3: Interactive Basket Demo ===== */
html.droppy-horizontal-scroll #gallery{
position:relative!important;
padding:90px 5vw 60px!important;
display:flex!important;
flex-direction:column!important;
align-items:center!important;
justify-content:center!important;
gap:28px!important;
}
.droppy-basket-demo{
width:100%;
max-width:1500px;
display:grid;
grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);
column-gap:clamp(40px,5vw,80px);
row-gap:24px;
align-items:center;
}
.droppy-basket-demo-header{
display:flex;
flex-direction:column;
align-items:center;
text-align:center;
gap:18px;
}
.droppy-basket-demo-title{
font-size:clamp(40px,4.6vw,68px)!important;
font-weight:600!important;
letter-spacing:-0.025em!important;
line-height:1.02!important;
color:#f5f9ff;
margin:0;
}
.droppy-basket-demo-body{
font-size:clamp(16px,1.2vw,18px);
line-height:1.55;
color:rgba(228,237,247,.62);
margin:0;
text-wrap:balance;
}

/* ===== Summon-the-basket magic — plays once, floats above title without
   pushing it down (absolute positioning out of normal document flow) ===== */
.droppy-basket-demo-header{position:relative}
.droppy-basket-summon-float{
position:absolute;
left:50%;
bottom:calc(100% - 6px);
transform:translateX(-50%);
width:160px;
height:130px;
pointer-events:none;
}
.droppy-basket-summon-file{
position:absolute;
top:50%;
left:50%;
width:44px;
height:55px;
margin-left:-22px;
margin-top:-27px;
filter:drop-shadow(0 8px 22px rgba(0,0,0,.55));
will-change:transform,opacity;
opacity:0;
}
.droppy-basket-summon-float.is-playing .droppy-basket-summon-file{
animation:droppy-basket-file-loop 4.2s cubic-bezier(.32,.72,.36,1) forwards;
}
.droppy-basket-summon-file svg{display:block;width:100%;height:100%}
.droppy-basket-summon-cursor{
position:absolute;
top:50%;
left:50%;
width:22px;
height:22px;
margin-left:-1px;
margin-top:6px;
filter:drop-shadow(0 4px 10px rgba(0,0,0,.5));
will-change:transform,opacity;
opacity:0;
pointer-events:none;
}
.droppy-basket-summon-float.is-playing .droppy-basket-summon-cursor{
animation:droppy-basket-cursor-loop 4.2s cubic-bezier(.32,.72,.36,1) forwards;
}
.droppy-basket-summon-cursor svg{display:block;width:100%;height:100%}
.droppy-basket-summon-poof{
position:absolute;
top:50%;
left:50%;
width:0;
height:0;
pointer-events:none;
}
.droppy-basket-poof-ring{
position:absolute;
top:0;
left:0;
width:140px;
height:140px;
margin-left:-70px;
margin-top:-70px;
border-radius:50%;
border:2px solid rgba(180,210,255,.55);
opacity:0;
transform:scale(.2);
}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-ring{
animation:droppy-basket-poof-ring 4.2s cubic-bezier(.22,.61,.36,1) forwards;
}
.droppy-basket-poof-puff{
position:absolute;
top:0;
left:0;
width:34px;
height:34px;
margin-left:-17px;
margin-top:-17px;
border-radius:50%;
background:radial-gradient(circle at 50% 50%,rgba(220,235,255,.85),rgba(150,190,250,.45) 45%,rgba(120,170,240,0) 75%);
filter:blur(2px);
opacity:0;
will-change:transform,opacity;
}
.droppy-basket-poof-puff--1{--droppy-poof-x:-58px;--droppy-poof-y:-22px}
.droppy-basket-poof-puff--2{--droppy-poof-x:48px;--droppy-poof-y:-32px}
.droppy-basket-poof-puff--3{--droppy-poof-x:18px;--droppy-poof-y:-58px}
.droppy-basket-poof-puff--4{--droppy-poof-x:-32px;--droppy-poof-y:42px}
.droppy-basket-poof-puff--5{--droppy-poof-x:46px;--droppy-poof-y:38px}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-puff{animation:droppy-basket-poof-puff 4.2s cubic-bezier(.22,.61,.36,1) forwards}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-puff--2{animation-delay:30ms}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-puff--3{animation-delay:60ms}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-puff--4{animation-delay:50ms}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-puff--5{animation-delay:80ms}
.droppy-basket-poof-spark{
position:absolute;
top:0;
left:0;
width:6px;
height:6px;
margin-left:-3px;
margin-top:-3px;
border-radius:50%;
background:radial-gradient(circle,#dff0ff 0%,rgba(120,180,255,.7) 50%,rgba(80,140,255,0) 100%);
box-shadow:0 0 12px rgba(160,210,255,.65);
opacity:0;
}
.droppy-basket-poof-spark--1{--droppy-spark-x:-78px;--droppy-spark-y:-46px}
.droppy-basket-poof-spark--2{--droppy-spark-x:72px;--droppy-spark-y:-52px}
.droppy-basket-poof-spark--3{--droppy-spark-x:-66px;--droppy-spark-y:58px}
.droppy-basket-poof-spark--4{--droppy-spark-x:74px;--droppy-spark-y:52px}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-spark{animation:droppy-basket-poof-spark 4.2s linear forwards}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-spark--2{animation-delay:40ms}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-spark--3{animation-delay:80ms}
.droppy-basket-summon-float.is-playing .droppy-basket-poof-spark--4{animation-delay:120ms}
.droppy-basket-summon-mini{
position:absolute;
top:50%;
left:50%;
display:inline-flex;
align-items:center;
gap:8px;
padding:7px 14px 7px 8px;
border-radius:999px;
background:rgba(15,22,35,.78);
border:1px solid rgba(255,255,255,.1);
backdrop-filter:blur(16px) saturate(160%);
-webkit-backdrop-filter:blur(16px) saturate(160%);
font:600 12px/1 "Inter",sans-serif;
color:rgba(232,240,252,.92);
white-space:nowrap;
box-shadow:0 10px 24px -8px rgba(0,0,0,.55);
transform:translate(-50%,calc(-50% + 8px)) scale(.6);
opacity:0;
}
.droppy-basket-summon-float.is-playing .droppy-basket-summon-mini{
animation:droppy-basket-mini-reveal 4.2s cubic-bezier(.22,.61,.36,1) forwards;
}
.droppy-basket-summon-mini img{
width:22px;
height:22px;
border-radius:6px;
display:block;
}

@keyframes droppy-basket-file-loop{
0%   { transform:translate(-44px,28px) rotate(-4deg); opacity:0; }
8%   { opacity:1; }
20%  { transform:translate(-8px,2px) rotate(0deg); opacity:1; }
/* jiggle */
28%  { transform:translate(-4px,1px) rotate(-7deg); opacity:1; }
34%  { transform:translate(6px,1px) rotate(7deg); opacity:1; }
40%  { transform:translate(-6px,1px) rotate(-7deg); opacity:1; }
46%  { transform:translate(6px,1px) rotate(7deg); opacity:1; }
52%  { transform:translate(0,2px) rotate(0deg); opacity:1; }
/* poof — file vanishes */
60%  { transform:translate(0,-4px) rotate(0deg) scale(.4); opacity:0; }
100% { transform:translate(0,-4px) rotate(0deg) scale(.4); opacity:0; }
}
@keyframes droppy-basket-cursor-loop{
0%   { transform:translate(-58px,40px); opacity:0; }
6%   { opacity:1; }
20%  { transform:translate(-18px,14px); opacity:1; }
/* mirror jiggle */
28%  { transform:translate(-14px,13px) rotate(-4deg); opacity:1; }
34%  { transform:translate(-2px,13px) rotate(4deg); opacity:1; }
40%  { transform:translate(-16px,13px) rotate(-4deg); opacity:1; }
46%  { transform:translate(-2px,13px) rotate(4deg); opacity:1; }
52%  { transform:translate(-10px,14px) rotate(0deg); opacity:1; }
60%  { transform:translate(-10px,14px); opacity:.9; }
78%  { transform:translate(46px,-32px); opacity:0; }
100% { transform:translate(46px,-32px); opacity:0; }
}
@keyframes droppy-basket-poof-ring{
0%, 56% { transform:scale(.2); opacity:0; }
62%  { transform:scale(.5); opacity:.85; }
78%  { transform:scale(1.1); opacity:0; }
100% { transform:scale(1.1); opacity:0; }
}
@keyframes droppy-basket-poof-puff{
0%, 56% { transform:translate(0,0) scale(.3); opacity:0; }
64%  { transform:translate(calc(var(--droppy-poof-x) * .3),calc(var(--droppy-poof-y) * .3)) scale(.9); opacity:1; }
82%  { transform:translate(var(--droppy-poof-x),var(--droppy-poof-y)) scale(1.4); opacity:0; }
100% { transform:translate(var(--droppy-poof-x),var(--droppy-poof-y)) scale(1.4); opacity:0; }
}
@keyframes droppy-basket-poof-spark{
0%, 57% { transform:translate(0,0) scale(0); opacity:0; }
64%  { transform:translate(calc(var(--droppy-spark-x) * .3),calc(var(--droppy-spark-y) * .3)) scale(1.1); opacity:1; }
80%  { transform:translate(var(--droppy-spark-x),var(--droppy-spark-y)) scale(.4); opacity:0; }
100% { transform:translate(var(--droppy-spark-x),var(--droppy-spark-y)) scale(.4); opacity:0; }
}
@keyframes droppy-basket-mini-reveal{
0%, 64% { transform:translate(-50%,calc(-50% + 8px)) scale(.6); opacity:0; }
72%  { transform:translate(-50%,-50%) scale(1.1); opacity:1; }
80%  { transform:translate(-50%,-50%) scale(1); opacity:1; }
100% { transform:translate(-50%,-50%) scale(1); opacity:1; }
}
@media (prefers-reduced-motion: reduce){
.droppy-basket-summon-float{display:none}
}
@media (max-width:1100px){
.droppy-basket-demo{grid-template-columns:1fr;row-gap:32px}
.droppy-basket-demo-header{align-items:center;text-align:center}
.droppy-basket-summon-float{width:140px;height:110px}
}
@media (max-width:809px){
.droppy-basket-demo{padding:0 18px}
.droppy-basket-demo-body{font-size:15px}
}
@media (max-width:640px){
.droppy-basket-summon-float{width:120px;height:100px}
}

.droppy-basket-stage{
position:relative;
width:100%;
max-width:980px;
aspect-ratio:16/9;
border-radius:26px;
overflow:hidden;
background:#08101e;
border:1px solid rgba(255,255,255,.07);
box-shadow:0 30px 80px -30px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.04);
isolation:isolate;
}
.droppy-basket-video{
position:relative;
width:100%;
max-width:980px;
aspect-ratio:16/9;
border-radius:24px;
overflow:hidden;
background:#04070a;
box-shadow:0 30px 80px -30px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04);
}
.droppy-basket-youtube-embed{
display:block;
width:100%;
height:100%;
border:0;
}
.droppy-basket-sound-toggle{
position:absolute;
bottom:18px;
right:18px;
width:42px;
height:42px;
border-radius:999px;
border:1px solid rgba(255,255,255,.14);
background:rgba(15,18,24,.55);
backdrop-filter:blur(20px) saturate(140%);
-webkit-backdrop-filter:blur(20px) saturate(140%);
color:#f1f5ff;
display:inline-flex;
align-items:center;
justify-content:center;
cursor:pointer;
padding:0;
box-shadow:0 10px 24px -10px rgba(0,0,0,.55);
transition:background .25s ease,border-color .25s ease,opacity .25s ease;
z-index:5;
opacity:.88;
}
.droppy-basket-sound-toggle:hover{
background:rgba(20,24,32,.7);
border-color:rgba(255,255,255,.22);
opacity:1;
}
.droppy-basket-sound-toggle svg{width:18px;height:18px;display:block}
.droppy-basket-sound-toggle .droppy-basket-sound-icon-on{display:block}
.droppy-basket-sound-toggle .droppy-basket-sound-icon-off{display:none}
.droppy-basket-sound-toggle.is-muted .droppy-basket-sound-icon-on{display:none}
.droppy-basket-sound-toggle.is-muted .droppy-basket-sound-icon-off{display:block}

/* Mac-style desktop mockup that the basket floats above */
.droppy-mac-desktop{
position:absolute;
inset:0;
overflow:hidden;
font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",sans-serif;
}
.droppy-mac-wallpaper{
position:absolute;
inset:0;
background:
  radial-gradient(ellipse 90% 70% at 25% 20%, rgba(70,120,200,.35), transparent 55%),
  radial-gradient(ellipse 70% 60% at 80% 80%, rgba(150,90,200,.32), transparent 55%),
  radial-gradient(ellipse 100% 80% at 50% 100%, rgba(40,60,110,.5), transparent 60%),
  linear-gradient(180deg, #1a2848 0%, #0d142a 60%, #08101e 100%);
}
.droppy-mac-wallpaper::after{
content:"";
position:absolute;
inset:0;
background-image:radial-gradient(circle at 30% 40%, rgba(255,255,255,.04) 0%, transparent 40%),radial-gradient(circle at 70% 70%, rgba(255,255,255,.03) 0%, transparent 35%);
mix-blend-mode:screen;
}
.droppy-mac-menubar{
position:absolute;
top:0;
left:0;
right:0;
height:26px;
display:flex;
align-items:center;
padding:0 14px;
background:rgba(20,24,32,.55);
backdrop-filter:blur(20px) saturate(160%);
-webkit-backdrop-filter:blur(20px) saturate(160%);
border-bottom:1px solid rgba(255,255,255,.06);
color:rgba(255,255,255,.85);
font-size:12.5px;
z-index:2;
}
.droppy-mac-menubar-left{
display:flex;
align-items:center;
gap:18px;
}
.droppy-mac-glyph{
width:14px;
height:14px;
display:inline-block;
border-radius:4px;
background:linear-gradient(160deg,rgba(255,255,255,.4),rgba(255,255,255,.15));
border:1px solid rgba(255,255,255,.18);
}
.droppy-mac-menu{
color:rgba(245,250,255,.9);
font-size:13px;
letter-spacing:-0.01em;
}
.droppy-mac-menu--app{font-weight:600}
.droppy-mac-notch{
position:absolute;
top:0;
left:50%;
transform:translateX(-50%);
width:180px;
height:30px;
background:#000;
border-radius:0 0 18px 18px;
z-index:3;
}
.droppy-mac-menubar-right{
margin-left:auto;
display:flex;
align-items:center;
gap:14px;
color:rgba(245,250,255,.86);
}
.droppy-mac-status{
width:16px;
height:16px;
color:rgba(245,250,255,.88);
}
.droppy-mac-time{
font-size:13px;
font-variant-numeric:tabular-nums;
letter-spacing:.01em;
}
.droppy-mac-dock{
position:absolute;
bottom:10px;
left:50%;
transform:translateX(-50%);
display:flex;
align-items:flex-end;
gap:8px;
padding:8px 12px;
border-radius:22px;
background:rgba(255,255,255,.08);
backdrop-filter:blur(24px) saturate(180%);
-webkit-backdrop-filter:blur(24px) saturate(180%);
border:1px solid rgba(255,255,255,.12);
box-shadow:0 14px 36px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.12);
z-index:2;
}
.droppy-mac-dock-icon{
width:42px;
height:42px;
border-radius:11px;
background:linear-gradient(160deg, var(--c1, #5cb6ff), var(--c2, #1e5dc4));
box-shadow:0 4px 10px -4px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.25);
transition:transform .3s cubic-bezier(.22,1,.36,1);
flex-shrink:0;
position:relative;
overflow:hidden;
}
.droppy-mac-dock-icon::after{
content:"";
position:absolute;
inset:1px;
border-radius:inherit;
background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.35), transparent 55%);
pointer-events:none;
}
.droppy-mac-dock-icon.is-droppy{background:transparent;padding:0}
.droppy-mac-dock-icon.is-droppy::after{display:none}
.droppy-mac-dock-icon.is-droppy img{width:100%;height:100%;display:block;object-fit:contain}
.droppy-mac-dock-icon:hover{transform:translateY(-6px) scale(1.08)}
@media (max-width:809px){
.droppy-mac-dock{gap:6px;padding:6px 10px;bottom:6px}
.droppy-mac-dock-icon{width:34px;height:34px;border-radius:9px}
.droppy-mac-menubar{height:22px;font-size:11px}
.droppy-mac-notch{width:140px;height:24px;border-radius:0 0 14px 14px}
}

.droppy-basket-stage-inner{
position:absolute;
inset:0;
z-index:4;
pointer-events:none;
}

/* Draggable Droppy icon */
.droppy-basket-icon-wrap{
position:absolute;
left:14%;
top:50%;
transform:translateY(-50%);
display:flex;
flex-direction:column;
align-items:center;
gap:14px;
touch-action:none;
user-select:none;
pointer-events:auto;
}
.droppy-basket-icon-wrap.is-dragging .droppy-basket-icon{opacity:0;transform:scale(.95)}
.droppy-basket-icon{
width:96px;
height:96px;
display:block;
filter:drop-shadow(0 12px 28px rgba(80,140,255,.22));
cursor:grab;
touch-action:none;
transition:transform .2s ease,opacity .2s ease;
}
.droppy-basket-icon:active{cursor:grabbing}
.droppy-basket-hint{
font-size:12px;
letter-spacing:.04em;
color:rgba(228,237,247,.5);
text-align:center;
max-width:160px;
line-height:1.4;
transition:opacity .25s ease;
}
.droppy-basket-hint.is-fading{opacity:.18}

/* Ghost element that follows the cursor */
.droppy-basket-ghost{
position:absolute;
left:0;top:0;
border-radius:20px;
background-image:url('./assets/images/droppy-v2-app-icon.png');
background-size:contain;
background-repeat:no-repeat;
background-position:center;
filter:drop-shadow(0 16px 32px rgba(80,140,255,.32));
pointer-events:none;
opacity:0;
transform:scale(.9);
transition:opacity .2s ease,transform .2s ease;
z-index:6;
}
.droppy-basket-ghost.is-active{opacity:1;transform:scale(1)}
.droppy-basket-ghost.is-returning{transition:left .25s cubic-bezier(.22,1,.36,1),top .25s cubic-bezier(.22,1,.36,1),opacity .25s ease,transform .25s ease;opacity:0;transform:scale(.9)}

/* The basket - liquid glass */
.droppy-basket-card{
position:absolute;
left:60%;
top:50%;
width:240px;
height:260px;
padding:14px 12px 12px;
border-radius:28px;
background:linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.05));
backdrop-filter:blur(40px) saturate(200%);
-webkit-backdrop-filter:blur(40px) saturate(200%);
border:1px solid rgba(255,255,255,.18);
box-shadow:
  0 30px 60px -18px rgba(0,0,0,.55),
  0 0 0 1px rgba(255,255,255,.08) inset,
  inset 0 1px 0 rgba(255,255,255,.22),
  inset 0 -1px 0 rgba(0,0,0,.18);
display:flex;
flex-direction:column;
gap:10px;
opacity:0;
transform:translateY(20px) scale(.88);
pointer-events:none;
transition:opacity .32s cubic-bezier(.22,1,.36,1),transform .38s cubic-bezier(.34,1.4,.4,1),box-shadow .25s ease;
z-index:5;
overflow:hidden;
isolation:isolate;
}
.droppy-basket-card::before{
content:"";
position:absolute;
inset:0;
border-radius:inherit;
background:
  radial-gradient(ellipse 80% 60% at 20% 0%, rgba(255,255,255,.22), transparent 55%),
  radial-gradient(ellipse 60% 40% at 80% 100%, rgba(120,180,255,.08), transparent 60%);
pointer-events:none;
mix-blend-mode:screen;
z-index:0;
}
.droppy-basket-card > *{position:relative;z-index:1}
.droppy-basket-card.is-summoned{
opacity:1;
transform:translateY(0) scale(1);
pointer-events:auto;
}
.droppy-basket-card.is-drop-target{
transform:scale(.97);
box-shadow:
  0 30px 60px -18px rgba(0,0,0,.6),
  0 0 0 2px rgba(120,180,255,.45) inset,
  inset 0 1px 0 rgba(255,255,255,.3),
  0 0 36px rgba(120,180,255,.28);
}
.droppy-basket-card.is-receiving{
animation:droppy-basket-receive .45s cubic-bezier(.22,1,.36,1);
}
@keyframes droppy-basket-receive{
0%{transform:scale(.95)}
50%{transform:scale(1.04)}
100%{transform:scale(1)}
}
.droppy-basket-handle{
width:44px;
height:5px;
border-radius:999px;
background:rgba(255,255,255,.32);
margin:0 auto 4px;
}
.droppy-basket-grid{
display:grid;
grid-template-columns:1fr 1fr;
grid-template-rows:1fr 1fr;
gap:6px;
flex:1;
}
.droppy-basket-cell{
position:relative;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:6px;
padding:8px;
border-radius:8px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.05);
color:rgba(238,245,255,.84);
font-size:11px;
font-weight:500;
line-height:1.15;
text-align:center;
transition:background .2s ease,transform .2s ease,border-color .2s ease;
cursor:default;
font-family:inherit;
}
.droppy-basket-cell:first-child{border-top-left-radius:22px}
.droppy-basket-cell:nth-child(2){border-top-right-radius:22px}
.droppy-basket-cell:nth-child(3){border-bottom-left-radius:22px}
.droppy-basket-cell:nth-child(4){border-bottom-right-radius:22px}
.droppy-basket-cell svg{width:22px;height:22px;color:rgba(255,255,255,.9)}
.droppy-basket-cell.is-drop{
background:rgba(120,180,255,.06);
border-color:rgba(120,180,255,.12);
color:rgba(220,235,255,.92);
}
.droppy-basket-card.is-drop-target .droppy-basket-cell.is-drop{
background:rgba(120,180,255,.18);
border-color:rgba(120,180,255,.32);
transform:scale(1.02);
}
.droppy-basket-stored{
position:absolute;
top:6px;
right:6px;
min-width:18px;
height:18px;
padding:0 5px;
border-radius:999px;
background:rgba(120,180,255,.88);
color:#04070a;
font-size:10px;
font-weight:700;
display:none;
align-items:center;
justify-content:center;
font-feature-settings:"tnum";
}
.droppy-basket-stored.is-visible{display:inline-flex}

.droppy-basket-step{
display:inline-flex;
align-items:center;
gap:10px;
padding:8px 16px;
border-radius:999px;
background:rgba(10,15,24,.7);
backdrop-filter:blur(16px) saturate(160%);
-webkit-backdrop-filter:blur(16px) saturate(160%);
border:1px solid rgba(255,255,255,.1);
color:rgba(228,237,247,.86);
font-size:12.5px;
letter-spacing:.01em;
position:absolute;
top:42px;
left:50%;
transform:translateX(-50%);
z-index:6;
white-space:nowrap;
max-width:90%;
overflow:hidden;
text-overflow:ellipsis;
}
.droppy-basket-step-dot{
width:6px;
height:6px;
border-radius:999px;
background:rgba(120,180,255,.85);
animation:droppy-basket-pulse 1.6s ease-in-out infinite;
flex-shrink:0;
}
@keyframes droppy-basket-pulse{
0%,100%{opacity:.5;transform:scale(.85)}
50%{opacity:1;transform:scale(1.1)}
}

@media (max-width:809px){
.droppy-basket-stage{aspect-ratio:9/14;max-width:420px}
.droppy-basket-stage-inner{flex-direction:column;justify-content:space-around;padding:24px}
.droppy-basket-icon{width:84px;height:84px}
.droppy-basket-card{width:220px;height:240px}
.droppy-basket-step{font-size:11px;padding:6px 12px;bottom:8px}
}
html.droppy-horizontal-scroll #icons .droppy-power-card{
border-radius:22px!important;
}

/* ===== Slide 4: Droplets Grid ===== */
html.droppy-horizontal-scroll #icons{
padding:90px 5vw 60px!important;
display:flex!important;
flex-direction:column!important;
align-items:center!important;
justify-content:center!important;
overflow-y:auto!important;
}
.droppy-droplets-section{
width:100%;
max-width:1280px;
display:flex;
flex-direction:column;
align-items:center;
gap:32px;
}
/* Vertical (non-horizontal-scroll) layout: the enhanced sections are bare
   <section> elements inside a centered flex column, so without an explicit
   width they shrink-to-fit their widest child (980px media) and overflow
   phones. Horizontal mode overrides this with its own !important sizing. */
html:not(.droppy-horizontal-scroll) main > section#features,
html:not(.droppy-horizontal-scroll) main > section#gallery,
html:not(.droppy-horizontal-scroll) main > section#icons,
html:not(.droppy-horizontal-scroll) main > section#cta{
width:100%;
max-width:100%;
overflow-x:clip;
}
@media (max-width:809px){
.droppy-droplets-section{padding:0 18px;gap:24px}
.droppy-droplets-video{border-radius:18px}
}
.droppy-droplets-body-secondary{
max-width:none;
color:rgba(228,237,247,.5)!important;
font-size:clamp(14px,1.05vw,16px)!important;
}
.droppy-droplets-can{
position:relative;
display:inline-block;
color:rgba(228,237,247,.92);
font-weight:600;
}
.droppy-droplets-can::after{
content:"";
position:absolute;
left:-2px;
right:-2px;
bottom:-3px;
height:2px;
border-radius:2px;
background:linear-gradient(90deg,#77c1ff,#5e90f0);
box-shadow:0 0 12px rgba(120,180,255,.55);
transform-origin:left center;
animation:droppy-droplets-can-stripe 3.4s cubic-bezier(.65,.05,.36,1) infinite;
}
@keyframes droppy-droplets-can-stripe{
0%   { transform:scaleX(0); transform-origin:left center; opacity:0; }
12%  { opacity:1; }
40%  { transform:scaleX(1); transform-origin:left center; opacity:1; }
55%  { transform:scaleX(1); transform-origin:right center; opacity:1; }
85%  { transform:scaleX(0); transform-origin:right center; opacity:1; }
100% { transform:scaleX(0); transform-origin:right center; opacity:0; }
}
@media (prefers-reduced-motion: reduce){
.droppy-droplets-can::after{
animation:none;
transform:scaleX(1);
opacity:1;
}
}
.droppy-droplets-marquee{
width:100%;
max-width:980px;
overflow:hidden;
position:relative;
mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);
-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);
}
.droppy-droplets-marquee-track{
display:flex;
align-items:center;
gap:0;
width:max-content;
animation:droppy-droplets-marquee-scroll 60s linear infinite;
will-change:transform;
}
.droppy-droplets-marquee-item{
display:inline-flex;
align-items:baseline;
gap:8px;
padding:0 18px;
white-space:nowrap;
font:500 13px/1 "Inter",sans-serif;
}
.droppy-droplets-marquee-name{
color:rgba(228,237,247,.85);
letter-spacing:.02em;
font-weight:600;
text-transform:none;
}
.droppy-droplets-marquee-desc{
color:rgba(228,237,247,.45);
letter-spacing:.01em;
font-weight:400;
}
.droppy-droplets-marquee-sep{
font:500 13px/1 "Inter",sans-serif;
color:rgba(228,237,247,.18);
}
@keyframes droppy-droplets-marquee-scroll{
from{transform:translateX(0)}
to{transform:translateX(-50%)}
}
@media (max-width:809px){
.droppy-droplets-marquee-item{font-size:12px;padding:0 12px}
.droppy-droplets-marquee-track{animation-duration:48s}
}
.droppy-droplets-header{
display:flex;
flex-direction:column;
align-items:center;
text-align:center;
gap:14px;
max-width:none;
width:100%;
}
.droppy-droplets-title{
font-size:clamp(40px,4.6vw,68px)!important;
font-weight:600!important;
letter-spacing:-0.025em!important;
line-height:1.02!important;
color:#f5f9ff;
margin:0;
}
.droppy-droplets-body{
font-size:clamp(16px,1.2vw,18px);
line-height:1.55;
color:rgba(228,237,247,.62);
margin:0;
white-space:nowrap;
text-wrap:nowrap;
}
/* Must come after the nowrap base rule above: same specificity, last wins. */
@media (max-width:809px){
.droppy-droplets-body,
.droppy-droplets-body-secondary{
white-space:normal;
text-wrap:balance;
}
}
.droppy-droplets-video{
position:relative;
width:100%;
max-width:980px;
margin:0 auto;
aspect-ratio:16/9;
border-radius:24px;
overflow:hidden;
background:#04070a;
box-shadow:0 30px 80px -30px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04);
}
.droppy-droplets-youtube-embed{
display:block;
width:100%;
height:100%;
border:0;
}
.droppy-droplets-sound-toggle{
position:absolute;
bottom:18px;
right:18px;
width:42px;
height:42px;
border-radius:999px;
border:1px solid rgba(255,255,255,.14);
background:rgba(15,18,24,.55);
backdrop-filter:blur(20px) saturate(140%);
-webkit-backdrop-filter:blur(20px) saturate(140%);
color:#f1f5ff;
display:inline-flex;
align-items:center;
justify-content:center;
cursor:pointer;
padding:0;
box-shadow:0 10px 24px -10px rgba(0,0,0,.55);
transition:background .25s ease,border-color .25s ease,opacity .25s ease;
z-index:5;
opacity:.88;
}
.droppy-droplets-sound-toggle:hover{
background:rgba(20,24,32,.7);
border-color:rgba(255,255,255,.22);
opacity:1;
}
.droppy-droplets-sound-toggle svg{width:18px;height:18px;display:block}
.droppy-droplets-sound-toggle .droppy-droplets-sound-icon-on{display:block}
.droppy-droplets-sound-toggle .droppy-droplets-sound-icon-off{display:none}
.droppy-droplets-sound-toggle.is-muted .droppy-droplets-sound-icon-on{display:none}
.droppy-droplets-sound-toggle.is-muted .droppy-droplets-sound-icon-off{display:block}

.droppy-droplets-grid{
width:100%;
display:grid;
grid-template-columns:repeat(4, 1fr);
gap:18px;
perspective:1100px;
}
@media (max-width:1100px){
.droppy-droplets-grid{grid-template-columns:repeat(3, 1fr)}
}
@media (max-width:809px){
.droppy-droplets-grid{grid-template-columns:repeat(2, 1fr);gap:14px}
}
@media (max-width:520px){
.droppy-droplets-grid{grid-template-columns:1fr}
}
.droppy-droplet-card{
--droppy-droplet-tilt-x:0deg;
--droppy-droplet-tilt-y:0deg;
--droppy-droplet-glow:0;
position:relative;
display:flex;
flex-direction:column;
align-items:center;
text-align:center;
gap:14px;
padding:32px 22px 28px;
border-radius:22px;
background:linear-gradient(160deg,rgba(28,33,42,.55),rgba(14,18,26,.7));
border:1px solid rgba(255,255,255,.06);
box-shadow:0 16px 40px -22px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.02) inset;
transition:transform .55s cubic-bezier(.22,1,.36,1),border-color .35s ease,box-shadow .35s ease,background .35s ease;
transform-style:preserve-3d;
overflow:hidden;
}
.droppy-droplet-card::before{
content:"";
position:absolute;
inset:0;
border-radius:inherit;
background:radial-gradient(circle 240px at 50% 30%,rgba(120,180,255,calc(0.15 * var(--droppy-droplet-glow))),transparent 70%);
opacity:var(--droppy-droplet-glow);
pointer-events:none;
transition:opacity .25s ease;
}
.droppy-droplet-card:hover{
border-color:rgba(120,180,255,.22);
background:linear-gradient(160deg,rgba(34,42,55,.7),rgba(16,22,32,.78));
box-shadow:0 24px 60px -26px rgba(0,0,0,.6),0 0 0 1px rgba(120,180,255,.16) inset;
}
.droppy-droplet-card{
transform:perspective(900px) rotateX(var(--droppy-droplet-tilt-x)) rotateY(var(--droppy-droplet-tilt-y));
}
.droppy-droplet-icon-wrap{
width:72px;
height:72px;
display:inline-flex;
align-items:center;
justify-content:center;
background:transparent;
filter:drop-shadow(0 12px 22px rgba(0,0,0,.45));
transform:translateZ(20px);
transition:transform .4s cubic-bezier(.22,1,.36,1),filter .35s ease;
}
.droppy-droplet-card:hover .droppy-droplet-icon-wrap{
filter:drop-shadow(0 18px 32px rgba(0,0,0,.55));
transform:translateZ(30px) scale(1.06);
}
.droppy-droplet-icon{
width:100%;
height:100%;
display:block;
object-fit:contain;
background:transparent;
}
.droppy-droplet-name{
margin:0;
font-size:16px;
font-weight:600;
letter-spacing:-0.012em;
color:#eef4ff;
transform:translateZ(14px);
}
.droppy-droplet-body{
margin:0;
font-size:13.5px;
line-height:1.5;
color:rgba(228,237,247,.6);
text-wrap:balance;
transform:translateZ(8px);
}
@media (hover:none){
.droppy-droplet-card{transform:none!important}
.droppy-droplet-card .droppy-droplet-icon-wrap,
.droppy-droplet-card .droppy-droplet-name,
.droppy-droplet-card .droppy-droplet-body{transform:none}
}
html.droppy-horizontal-scroll #pricing{
padding-top:60px!important;
overflow:hidden!important;
max-height:100dvh!important;
}
html.droppy-horizontal-scroll #pricing::-webkit-scrollbar{display:none!important}
html.droppy-horizontal-scroll #pricing .droppy-pricing-card{
box-shadow:0 30px 80px -30px rgba(80,140,255,.18),0 0 0 1px rgba(255,255,255,.06)!important;
}
/* Pricing card subtitle (now "Stop fighting macOS, ease your mind with
   Droppy.") needs balanced line breaks so it doesn't widow. */
#pricing [data-framer-name="Perfect for everyday workflows."] .framer-text,
#pricing [data-framer-name="Perfect for everyday workflows."] p{
text-wrap:balance;
}
/* Green rotating scalloped badge in front of "What's Included". The burst
   shape rotates while the checkmark stays static and readable. */
.droppy-included-badge{
position:relative;
display:inline-flex;
align-items:center;
justify-content:center;
width:22px;
height:22px;
margin-right:10px;
vertical-align:middle;
transform:translateY(-1px);
color:#34c759;
flex:0 0 auto;
}
.droppy-included-badge-burst{
position:absolute;
inset:0;
width:100%;
height:100%;
animation:droppy-included-badge-spin 7s linear infinite;
filter:drop-shadow(0 2px 6px rgba(52,199,89,.35));
}
.droppy-included-badge-check{
position:relative;
z-index:1;
width:12px;
height:12px;
}
@keyframes droppy-included-badge-spin{
to{transform:rotate(360deg);}
}
@media (prefers-reduced-motion: reduce){
.droppy-included-badge-burst{animation:none;}
}
#pricing .droppy-pricing-was{
display:inline-block!important;
margin-right:.5em!important;
color:rgba(255,255,255,.45)!important;
text-decoration:line-through!important;
text-decoration-color:rgba(255,255,255,.55)!important;
text-decoration-thickness:2.2px!important;
text-decoration-skip-ink:none!important;
font-weight:400!important;
font-feature-settings:"tnum"!important;
}
#pricing .droppy-pricing-now{
display:inline-block!important;
margin-left:.1em!important;
