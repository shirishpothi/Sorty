.droppy-account-modal .droppy-license-modal-header{grid-template-columns:1fr}
.droppy-account-modal .droppy-account-auth-row,.droppy-account-modal .droppy-account-link-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:stretch}
.droppy-account-modal input[type="email"],.droppy-account-modal input[type="text"]{height:56px;width:100%;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);padding:0 20px;color:#f8fbff;font-size:17px;outline:none;transition:border-color .2s ease,box-shadow .2s ease,background-color .2s ease}
