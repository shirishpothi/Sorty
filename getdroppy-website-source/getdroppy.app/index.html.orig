margin-right:auto!important;
}
html.droppy-horizontal-scroll #hero .framer-mk7lz9 .framer-1rmrzte .framer-text,
html.droppy-horizontal-scroll #hero .framer-mk7lz9 .framer-1yylnnf .framer-text{
text-align:center!important;
}
}
html.droppy-horizontal-scroll #companies{
justify-content:center!important;
}
html.droppy-horizontal-scroll #features{
justify-content:center!important;
padding-top:60px!important;
overflow:hidden!important;
