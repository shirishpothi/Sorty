    <svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
      <defs>
        <filter id="droppy-glass-distort" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.014 0.018" numOctaves="2" seed="9" result="noise"/>
          <feGaussianBlur in="noise" stdDeviation="1.4" result="softNoise"/>
