.droppy-mobile-menu-overlay{
position:fixed;
inset:0;
z-index:2147483500;
display:flex;
align-items:center;
justify-content:center;
padding:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left));
background:rgba(2,4,7,.72);
backdrop-filter:blur(10px);
-webkit-backdrop-filter:blur(10px);
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .34s cubic-bezier(.22,.61,.36,1),visibility 0s linear .34s;
}
.droppy-mobile-menu-overlay.is-open{
opacity:1;
visibility:visible;
pointer-events:auto;
transition:opacity .34s cubic-bezier(.22,.61,.36,1),visibility 0s linear 0s;
}
.droppy-mobile-menu-panel{
position:relative;
width:min(100%,680px);
max-height:min(88vh,860px);
padding:clamp(18px,2.6vw,30px);
border-radius:34px;
border:1px solid rgba(255,255,255,.12);
background:linear-gradient(180deg,rgba(94,94,94,.4) 0%,rgba(40,40,40,.4) 100%);
backdrop-filter:blur(60px);
-webkit-backdrop-filter:blur(60px);
box-shadow:inset 0 1px 2px rgba(255,255,255,.2),0 30px 70px rgba(0,0,0,.45);
display:grid;
gap:14px;
overflow:auto;
transform:translateY(18px) scale(.975);
opacity:0;
transition:transform .38s cubic-bezier(.2,.77,.24,.99),opacity .28s cubic-bezier(.22,.61,.36,1);
}
.droppy-mobile-menu-panel::before{
content:"";
position:absolute;
inset:0;
border-radius:inherit;
pointer-events:none;
background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,0));
opacity:.7;
}
.droppy-mobile-menu-overlay.is-open .droppy-mobile-menu-panel{
transform:translateY(0) scale(1);
opacity:1;
}
.droppy-mobile-menu-head{
display:flex;
align-items:center;
justify-content:flex-start;
gap:10px;
position:relative;
z-index:1;
}
.droppy-mobile-menu-title{
margin:0;
font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Helvetica,Arial,sans-serif;
font-size:clamp(36px,9vw,54px);
font-weight:400;
letter-spacing:-.03em;
line-height:.92;
color:#f2f7ff;
}
.droppy-mobile-menu-nav{
display:grid;
gap:10px;
position:relative;
z-index:1;
}
.droppy-mobile-menu-link{
display:flex;
align-items:center;
justify-content:flex-start;
min-height:56px;
padding:0 20px;
border-radius:999px;
border:1px solid rgba(255,255,255,.15);
background:rgba(255,255,255,.04);
color:#eef5ff;
font:500 19px/1.2 "Inter","Inter Placeholder",sans-serif;
letter-spacing:-.01em;
text-decoration:none;
}
.droppy-mobile-menu-link.is-cta{
background:#fff;
color:#101828;
box-shadow:inset 0px 0px 10px 0px rgba(255,255,255,.65),0px 5px 18px 0px rgba(255,255,255,.12);
border:0;
}
.droppy-mobile-menu-link.is-active:not(.is-cta){
background:linear-gradient(180deg,rgba(111,190,255,.24),rgba(111,190,255,.1));
border-color:rgba(111,190,255,.38);
box-shadow:inset 0 0 12px rgba(111,190,255,.18);
color:#f1f8ff;
}
@media (min-width:1200px){
.droppy-mobile-menu-overlay{display:none!important}
}
/* Floating menu button for phones: the Framer export ships no mobile nav
   variant, so this is the only navigation entry point under 810px. */
.droppy-mobile-menu-fab{
display:none;
position:fixed;
top:max(14px,env(safe-area-inset-top));
right:max(14px,env(safe-area-inset-right));
z-index:2147483100;
width:44px;
height:44px;
border-radius:999px;
align-items:center;
justify-content:center;
padding:0;
color:#f1f6ff;
background:rgba(15,18,24,.6);
border:1px solid rgba(255,255,255,.14);
backdrop-filter:blur(20px) saturate(140%);
-webkit-backdrop-filter:blur(20px) saturate(140%);
box-shadow:0 10px 24px -12px rgba(0,0,0,.6),inset 0 1px 1px rgba(255,255,255,.1);
cursor:pointer;
transition:background .25s ease,border-color .25s ease,transform .2s ease;
}
.droppy-mobile-menu-fab:active{transform:scale(.94)}
.droppy-mobile-menu-fab svg{width:20px;height:20px;display:block}
.droppy-mobile-menu-fab .droppy-mobile-menu-fab-close{display:none}
.droppy-mobile-menu-fab.is-open .droppy-mobile-menu-fab-open{display:none}
.droppy-mobile-menu-fab.is-open .droppy-mobile-menu-fab-close{display:block}
@media (max-width:809px){
.droppy-mobile-menu-fab{display:inline-flex}
}

/* ===== Landing component styles + horizontal scroll layout.
   Horizontal-scroll rules stay desktop-only because html.droppy-horizontal-scroll
   is only ever added at >=810px; everything else cascades to phones, where the
   nested max-width rules below adapt it. Do NOT wrap this whole section in a
   min-width media query: the enhancement script injects this DOM on all
   viewports, so gating the styles strips mobile bare. ===== */
html.droppy-horizontal-scroll{scroll-behavior:auto!important}
html.droppy-horizontal-scroll body{overflow-x:hidden!important}
html.droppy-horizontal-scroll #main,
html.droppy-horizontal-scroll .framer-YRUXb{overflow:visible!important;overflow-x:visible!important}
html.droppy-horizontal-scroll main.framer-t41vbz,
html.droppy-horizontal-scroll main[data-framer-name="Main"]{
display:flex!important;
flex-direction:row!important;
flex-wrap:nowrap!important;
width:max-content!important;
height:100vh!important;
overflow:visible!important;
justify-content:flex-start!important;
align-items:stretch!important;
}
html.droppy-horizontal-scroll main.framer-t41vbz > .droppy-hero-video-section,
html.droppy-horizontal-scroll main.framer-t41vbz > section#companies{
display:none!important;
}
html.droppy-horizontal-scroll main.framer-t41vbz > section,
html.droppy-horizontal-scroll main[data-framer-name="Main"] > section{
width:100vw!important;
min-width:100vw!important;
height:100vh!important;
min-height:100vh!important;
max-height:100vh!important;
flex-shrink:0!important;
overflow-y:auto!important;
overflow-x:hidden!important;
display:flex!important;
flex-direction:column!important;
align-items:center!important;
justify-content:center!important;
padding:0 5vw!important;
box-sizing:border-box!important;
position:relative!important;
}
html.droppy-horizontal-scroll main.framer-t41vbz > section > *{
max-width:1200px!important;
width:100%!important;
flex-shrink:0!important;
}
html.droppy-horizontal-scroll main.framer-t41vbz > footer,
html.droppy-horizontal-scroll main.framer-t41vbz > div.framer-ng3b95{
display:none!important;
}
.framer-1wzrkvf-container{
position:fixed!important;
top:14px!important;
left:0!important;
right:0!important;
transform:none!important;
z-index:2147483000!important;
width:100%!important;
max-width:none!important;
padding:0 clamp(16px,3.2vw,40px)!important;
display:flex!important;
justify-content:center!important;
pointer-events:none!important;
}
/* ===== Minimal transparent navbar (applies everywhere, not just horizontal-scroll) ===== */
.droppy-bare-nav{
display:flex!important;
align-items:center!important;
justify-content:space-between!important;
width:100%!important;
max-width:1400px!important;
padding:0!important;
margin:0!important;
background:transparent!important;
border:0!important;
box-shadow:none!important;
backdrop-filter:none!important;
-webkit-backdrop-filter:none!important;
border-radius:0!important;
pointer-events:auto;
}
.droppy-bare-nav-logo{
display:inline-flex;
align-items:center;
justify-content:center;
width:36px;
height:36px;
border-radius:9px;
overflow:hidden;
text-decoration:none;
flex:0 0 auto;
transition:transform .25s ease,filter .25s ease;
}
.droppy-bare-nav-logo:hover{
transform:scale(1.04);
filter:drop-shadow(0 4px 14px rgba(120,180,255,.4));
}
.droppy-bare-nav-logo img{
display:block;
width:100%;
height:100%;
object-fit:contain;
}
.droppy-bare-nav-links{
display:inline-flex;
align-items:center;
gap:clamp(18px,2.4vw,36px);
flex:0 0 auto;
}
.droppy-bare-nav-link{
position:relative;
display:inline-flex;
align-items:center;
padding:6px 0;
color:rgba(232,240,252,.86);
font:500 14px/1 "Inter",-apple-system,sans-serif;
letter-spacing:-.005em;
text-decoration:none;
white-space:nowrap;
transition:color .2s ease;
}
.droppy-bare-nav-link:hover,
.droppy-bare-nav-link:focus-visible{
color:#ffffff;
outline:none;
}
.droppy-bare-nav-link::after{
content:"";
position:absolute;
left:-2px;
right:-2px;
bottom:-2px;
height:2px;
border-radius:2px;
background:linear-gradient(90deg,#77c1ff,#5e90f0);
box-shadow:0 0 12px rgba(120,180,255,.55);
transform:scaleX(0);
transform-origin:left center;
opacity:0;
transition:transform .55s cubic-bezier(.65,.05,.36,1),opacity .25s ease;
pointer-events:none;
}
.droppy-bare-nav-link:hover::after,
.droppy-bare-nav-link:focus-visible::after{
transform:scaleX(1);
opacity:1;
}
.droppy-bare-nav-link.is-active{
color:#ffffff;
}
.droppy-bare-nav-link.is-active::after{
transform:scaleX(1);
opacity:.85;
}
/* Nav CTA pill: white badge with black text, sits to the right of Pricing. */
.droppy-bare-nav-link.is-cta{
padding:7px 16px;
background:#ffffff;
color:#000;
font-weight:600;
border-radius:9999px;
box-shadow:
  inset 0 1px 0 rgba(255,255,255,.95),
  inset 0 -1px 0 rgba(0,0,0,.05),
  0 6px 18px -10px rgba(0,0,0,.55);
transition:transform .2s ease, box-shadow .25s ease, color .2s ease, background .2s ease;
}
.droppy-bare-nav-link.is-cta:hover,
.droppy-bare-nav-link.is-cta:focus-visible{
color:#000;
transform:translateY(-1px);
background:#fff;
box-shadow:
  inset 0 1px 0 rgba(255,255,255,1),
  inset 0 -1px 0 rgba(0,0,0,.07),
  0 10px 24px -10px rgba(0,0,0,.6);
}
.droppy-bare-nav-link.is-cta.is-active{
color:#000;
}
.droppy-bare-nav-link.is-cta::after,
.droppy-bare-nav-link.is-cta:hover::after,
.droppy-bare-nav-link.is-cta:focus-visible::after,
.droppy-bare-nav-link.is-cta.is-active::after{
content:none!important;
display:none!important;
}
.droppy-bare-nav-social{
display:inline-flex;
align-items:center;
gap:6px;
flex:0 0 auto;
}
.droppy-bare-nav-social-icon{
display:inline-flex;
align-items:center;
justify-content:center;
width:36px;
height:36px;
border-radius:10px;
color:rgba(232,240,252,.78);
text-decoration:none;
flex:0 0 auto;
transition:color .2s ease,transform .25s ease;
}
.droppy-bare-nav-social-icon:hover{
color:#ffffff;
transform:scale(1.05);
}
.droppy-bare-nav-social-icon svg{
width:22px;
height:22px;
display:block;
}
/* Changelog pill: same clean rounded-pill construction as the Purchase CTA,
   kept in a quieter tone so the white Purchase pill stays the primary action. */
.droppy-bare-nav-update{
display:inline-flex;
align-items:center;
height:34px;
padding:0 16px;
border-radius:9999px;
border:1px solid rgba(255,255,255,.16);
background:rgba(255,255,255,.07);
color:rgba(255,255,255,.9);
font:600 13px/1 "Inter",-apple-system,sans-serif;
letter-spacing:-.005em;
white-space:nowrap;
cursor:pointer;
flex:0 0 auto;
box-shadow:
  inset 0 1px 0 rgba(255,255,255,.12),
  0 6px 18px -12px rgba(0,0,0,.6);
transition:transform .2s ease,box-shadow .25s ease,background .2s ease,border-color .2s ease,color .2s ease;
}
.droppy-bare-nav-update:hover,
.droppy-bare-nav-update:focus-visible{
color:#fff;
background:rgba(255,255,255,.12);
border-color:rgba(255,255,255,.28);
transform:translateY(-1px);
outline:none;
}
/* Hide every leftover Framer nav layer (mobile + tablet variants, ssr fallbacks) so only our new nav renders */
.framer-1wzrkvf-container > *:not(.droppy-bare-nav){display:none!important;}
