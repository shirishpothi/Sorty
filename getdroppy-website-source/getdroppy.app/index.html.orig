                '<button type="button" id="droppy-promo-apply-btn" class="droppy-promo-apply-btn">Apply</button>' +
              '</div>' +
              '<p id="droppy-promo-status" class="droppy-promo-status" style="display:none;"></p>' +
              '<div id="droppy-payment-element"></div>' +
              '<p id="droppy-checkout-error" class="droppy-checkout-error" style="display:none;"></p>' +
