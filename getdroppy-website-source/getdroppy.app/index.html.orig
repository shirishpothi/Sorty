<script id="droppy-live-overrides-js">
(function(){
  document.documentElement.classList.add('droppy-hero-intro-pending');
  stripHeroAppearIds(document.getElementById('hero'));
  var purchaseModalState = { initialized: false, isOpen: false };
  var modalNodes = null;
  var reclaimModalState = { initialized: false, isOpen: false };
  var reclaimModalNodes = null;
  var accountModalState = { initialized: false, isOpen: false };
  var accountModalNodes = null;
  var faqModalState = { initialized: false, isOpen: false };
  var faqModalNodes = null;
  var legalModalState = { initialized: false, isOpen: false, activeDocument: '' };
  var legalModalNodes = null;
  var installModalState = { initialized: false, isOpen: false };
  var installModalNodes = null;
  var changelogModalState = { initialized: false, isOpen: false };
  var changelogModalNodes = null;
  var changelogDataPromise = null;
  var blurRevealState = { observer: null, initialized: false };
  var scrollStoryState = { initialized: false, ticking: false, hero: null, heroContent: null, heroVisual: null, heroParticles: null, heroTickerNodes: [], featureCards: [], galleryCards: [], powerCards: [], showcasePanels: [] };
  var mobileMenuState = { overlay: null, isOpen: false, wired: false };
  var supabaseState = { client: null, initPromise: null, authBound: false };
  var downloadLinkSyncState = { observer: null, captureBound: false, rafId: 0, resolvedUrl: '', manifestPromise: null };
  var accountDockSyncBound = false;
  var pendingLicenseStorageKey = 'droppy_pending_license_key';
  var copyLockState = { initialized: false };
  var pricingAnimationTimer = null;
  var droppyLicenseKeyPattern = /^DRPY(?:-[A-Z0-9]{4}){6}$/;
  var checkoutPriceConfig = {
    currency: 'usd',
    standardAmountCents: 999,
    launchSaleAmountCents: 699,
    launchSaleEndsAt: '2027-12-31T22:00:00Z'
  };
  function isCheckoutLaunchSaleActive(){
    var endMs = Date.parse(checkoutPriceConfig.launchSaleEndsAt);
    return Number.isFinite(endMs) && Date.now() < endMs;
  }
  var checkoutBasePrice = {
    currency: checkoutPriceConfig.currency,
    amountCents: isCheckoutLaunchSaleActive()
      ? checkoutPriceConfig.launchSaleAmountCents
      : checkoutPriceConfig.standardAmountCents
  };
  var purchaseCheckoutState = { quantity: 1 };
  var purchasePricingState = {
    localCurrency: 'USD',
    usdRate: 1,
    hasFxRate: false,
    initialized: false,
    loading: false,
    error: ''
  };
  var embeddedCheckoutState = { step: 'configure', checkout: null, sessionId: null, stripeInstance: null };
  var stripeScriptPromise = null;
  function loadStripeScript(){
    if(window.Stripe) return Promise.resolve(window.Stripe);
    if(stripeScriptPromise) return stripeScriptPromise;
    stripeScriptPromise = new Promise(function(resolve, reject){
      var existing = document.querySelector('script[data-droppy-stripe]');
      if(existing){ existing.remove(); }
      var s = document.createElement('script');
      s.src = 'https://js.stripe.com/v3/';
      s.async = true;
      s.dataset.droppyStripe = '1';
      s.onload = function(){ resolve(window.Stripe); };
      s.onerror = function(err){ stripeScriptPromise = null; reject(err); };
      document.head.appendChild(s);
    });
    return stripeScriptPromise;
  }
  var faqEntries = [
    {
      question: 'What is Droppy?',
      answer: 'Droppy is a native macOS app that turns your notch (or menu bar on notchless Macs) into a productivity hub. It gives you a file shelf, clipboard manager, media player, system HUDs, and more, all accessible from a single spot on your screen.'
    },
    {
      question: 'What are Droplets?',
      answer: 'Droplets are free, optional extensions that add extra capabilities to Droppy. Things like AI background removal, meeting controls, mechanical keyboard sounds, and voice transcription each live in their own Droplet. You toggle them on or off independently, and they only run when activated, so Droppy stays lightweight.'
    },
    {
      question: 'Does Droppy work on Macs without a notch?',
      answer: 'Yes! Droppy supports both notched MacBooks and notchless displays like iMacs or external monitors. On notchless Macs, Droppy uses a floating shelf and menu bar integration instead.'
    },
    {
      question: 'What macOS version do I need?',
      answer: 'Droppy requires macOS 14 (Sonoma) or later.'
    },
    {
      question: 'Is the lifetime license really lifetime?',
      answer: 'Yes. A Droppy lifetime license means you pay once and receive all future updates at no additional cost. No subscriptions, no renewals. The license is yours to keep.'
    },
    {
      question: 'How do I download and activate Droppy?',
      answer: 'Purchase a license key on getdroppy.app, then download the .dmg from the same page. Open it, drag Droppy to Applications, launch it, and enter your license key to activate.'
    },
    {
      question: 'What is Droppy Cloud?',
      answer: 'Droppy Cloud lets you share files instantly via a private link. Files are capped at 100 MB each (1 GB total, 25 files max) and auto-expire after 24 hours. Recipients can preview and download without needing an account.'
    },
    {
      question: 'What permissions does Droppy need?',
      answer: 'Droppy asks for Accessibility and Screen Recording permissions to display overlays and interact with your desktop. Some Droplets (like voice transcription or meeting controls) may request additional permissions like microphone access.'
    },
    {
      question: 'Can I use Droppy on multiple Macs?',
      answer: 'Your license key can be used on the devices you personally own and control. If you need to move your license to a new Mac, you can reset it via the Recover License page on our website.'
    },
    {
      question: 'Will updating Droppy carry over my settings and clipboard history?',
      answer: 'Yes! All your settings, clipboard history, and Droplet configurations are preserved across updates.'
    },
    {
      question: 'How can I submit a bug report or feature request?',
      answerHtml: 'On our Discord server, post bugs in <strong>#bug-reports</strong> and new ideas in <strong>#suggestions</strong>. Prefer email? Reach us at <a class="droppy-faq-link" href="mailto:hi@getdroppy.app">hi@getdroppy.app</a>.',
      actions: [
        { label: 'Open Discord', href: 'https://discord.gg/weJjpkDnQr', variant: 'primary', icon: 'discord' },
        { label: 'Email us', href: 'mailto:hi@getdroppy.app', variant: 'secondary', icon: 'mail' }
      ]
