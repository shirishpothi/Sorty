  function modalConfig(){
    var config = window.DROPPY_LICENSE_FLOW_CONFIG || {};
    var functionsBaseURL = config.FUNCTIONS_BASE_URL || '';
    var supabaseURL = config.SUPABASE_URL || functionsBaseURL.replace(/\/functions\/v1\/?$/i, '');
    var publicSiteURL = (config.PUBLIC_SITE_URL || '').trim();
    var accountMagicLinkRedirectURL = (config.ACCOUNT_MAGIC_LINK_REDIRECT_URL || '').trim();
    var accountMagicLinkRedirectURLProduction = (config.ACCOUNT_MAGIC_LINK_REDIRECT_URL_PRODUCTION || '').trim();
    var accountMagicLinkRedirectURLLocal = (config.ACCOUNT_MAGIC_LINK_REDIRECT_URL_LOCAL || '').trim();
