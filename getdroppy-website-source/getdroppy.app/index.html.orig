            '<a id="droppy-success-activate-btn" class="droppy-success-btn is-secondary" href="#" style="display:none;">Activate in Droppy</a>' +
            '<button type="button" id="droppy-success-close-btn" class="droppy-success-btn is-secondary">Done</button>' +
          '</div>' +
        '</div>' +
        '<p id="droppy-license-status" class="droppy-license-modal-status" aria-live="polite" hidden></p>' +
      '</div>';
    document.body.appendChild(overlay);

    modalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-license-modal'),
      checkoutButton: overlay.querySelector('#droppy-license-checkout-button'),
      statusNode: overlay.querySelector('#droppy-license-status'),
      quantityButtons: Array.from(overlay.querySelectorAll('.droppy-quantity-step')),
      quantityStepper: overlay.querySelector('.droppy-quantity-stepper'),
      quantityValue: overlay.querySelector('#droppy-quantity-value'),
      purchaseSummary: overlay.querySelector('#droppy-purchase-summary'),
      pricingCard: overlay.querySelector('#droppy-pricing-card'),
      discountBadge: overlay.querySelector('#droppy-discount-badge'),
      backButton: overlay.querySelector('#droppy-purchase-back-btn'),
      checkoutQtyLabel: overlay.querySelector('#droppy-checkout-qty-label'),
      checkoutTotalDisplay: overlay.querySelector('#droppy-checkout-total-display'),
      checkoutContainer: overlay.querySelector('#droppy-checkout-container'),
      checkoutEmail: overlay.querySelector('#droppy-checkout-email'),
      checkoutPromo: overlay.querySelector('#droppy-checkout-promo'),
      promoApplyBtn: overlay.querySelector('#droppy-promo-apply-btn'),
      promoRow: overlay.querySelector('#droppy-promo-row'),
      promoStatus: overlay.querySelector('#droppy-promo-status'),
      promoBadge: overlay.querySelector('#droppy-promo-badge'),
      paymentElement: overlay.querySelector('#droppy-payment-element'),
      payBtn: overlay.querySelector('#droppy-pay-btn'),
      checkoutError: overlay.querySelector('#droppy-checkout-error'),
      successContainer: overlay.querySelector('#droppy-success-container'),
      successKeyWrap: overlay.querySelector('#droppy-success-key-wrap'),
      successKeyLabel: overlay.querySelector('#droppy-success-key-label'),
      successKeyList: overlay.querySelector('#droppy-success-key-list'),
      successCopyBtn: overlay.querySelector('#droppy-success-copy-btn'),
      successActivateBtn: overlay.querySelector('#droppy-success-activate-btn'),
      successCloseBtn: overlay.querySelector('#droppy-success-close-btn'),
      purchaseHead: overlay.querySelector('.droppy-purchase-head'),
      licenseMeta: overlay.querySelector('.droppy-license-meta')
    };

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closePurchaseModal();
    });

    var config = window.DROPPY_LICENSE_FLOW_CONFIG || {};
    var functionsBaseURL = config.FUNCTIONS_BASE_URL;
    var anonKey = config.ANON_KEY;
    var hasCheckoutConfig = !!(functionsBaseURL && anonKey);
    modalNodes.hasCheckoutConfig = hasCheckoutConfig;
    initializePurchasePricing();
    setPurchaseQuantity(purchaseCheckoutState.quantity || 1, { silent: true });
    modalNodes.quantityButtons.forEach(function(button){
      button.addEventListener('click', function(event){
        event.preventDefault();
        var delta = parseInt(button.getAttribute('data-quantity-step') || '0', 10);
        if(!Number.isFinite(delta) || delta === 0) return;
        setPurchaseQuantity((purchaseCheckoutState.quantity || 1) + delta);
      });
    });
    if(!hasCheckoutConfig){
      setCheckoutButtonDisabled(true);
      setModalStatus('License checkout configuration is missing.', 'error');
    }

    modalNodes.checkoutButton.addEventListener('click', async function(event){
      event.preventDefault();
      if(modalNodes.checkoutButton.classList.contains('is-disabled')) return;
      if(!functionsBaseURL || !anonKey){
        setModalStatus('Checkout config missing on this page. Refresh and try again.', 'error');
        return;
      }

      var stripePublishableKey = config.STRIPE_PUBLISHABLE_KEY;
      var canUseCustomCheckout = !!stripePublishableKey;

      if(!canUseCustomCheckout){
        try {
          setCheckoutButtonDisabled(true);
          setModalStatus('', null);
          var accountAccessToken = await getSupabaseAccessToken();
          var payload = await createCheckoutSession(
            functionsBaseURL + '/stripe-create-checkout-session',
            anonKey,
            null,
            accountAccessToken,
            resolveCheckoutRequestCurrency(),
            purchaseCheckoutState.quantity || 1
          );
          window.location.assign(payload.url);
        } catch (error) {
          setCheckoutButtonDisabled(false);
          var message = (error && error.message) || 'Could not start checkout.';
          if(message.toLowerCase() === 'failed to fetch'){
            message = 'Could not reach checkout service. Disable blockers/VPN for supabase.co and stripe.com, then retry.';
          }
          setModalStatus(message, 'error');
        }
        return;
      }

      try {
        setCheckoutButtonDisabled(true);
        setModalStatus('', null);
        if(!embeddedCheckoutState.stripeInstance){
          await loadStripeScript();
          embeddedCheckoutState.stripeInstance = Stripe(stripePublishableKey);
        }
        var capturedQuantity = purchaseCheckoutState.quantity || 1;
        var capturedCurrency = resolveCheckoutRequestCurrency();

        var response = await fetch(functionsBaseURL + '/stripe-create-payment-intent', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + anonKey,
            'apikey': anonKey
          },
          body: JSON.stringify({
            email: null,
            currency: capturedCurrency || null,
            quantity: clampCheckoutQuantity(capturedQuantity)
          })
        });
        var piPayload = await response.json().catch(function(){ return {}; });
        if(!response.ok || typeof piPayload.clientSecret !== 'string'){
          throw new Error(piPayload.error || 'Could not create payment session.');
        }
        if(typeof piPayload.amount !== 'number' || typeof piPayload.currency !== 'string'){
          throw new Error('Payment session was missing pricing details.');
        }
        embeddedCheckoutState.sessionId = piPayload.id;
        embeddedCheckoutState.piAmount = piPayload.amount;
        embeddedCheckoutState.piCurrency = normalizeSupportedCheckoutCurrency(piPayload.currency) || capturedCurrency;

        var droppyAppearance = {
          theme: 'night',
          variables: {
            colorPrimary: '#93c5fd',
            colorDanger: '#ffb1b1',
            fontFamily: '"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif',
            fontSizeBase: '14px',
            fontWeightNormal: '500',
            borderRadius: '32px',
            colorBackground: '#1a1f2e',
            colorText: '#f5f8ff',
            colorTextPlaceholder: 'rgba(195,211,229,.35)',
            colorTextSecondary: 'rgba(195,211,229,.65)',
            spacingUnit: '4px',
            spacingGridRow: '12px'
          },
          rules: {
            '.Input': {
              backgroundColor: 'rgba(255,255,255,.05)',
              border: '1px solid rgba(255,255,255,.14)',
              boxShadow: 'inset 0 1px 0 rgba(255,255,255,.06)',
              borderRadius: '32px',
              padding: '12px 14px',
              color: '#f5f8ff',
              fontWeight: '500',
              fontSize: '14px',
              transition: 'border-color .18s ease, box-shadow .18s ease'
            },
            '.Input::placeholder': {
              color: 'rgba(195,211,229,.35)'
            },
            '.Input:focus': {
              border: '1px solid rgba(147,197,253,.45)',
              boxShadow: '0 0 0 2px rgba(147,197,253,.10), inset 0 1px 0 rgba(255,255,255,.06)'
            },
            '.Input--invalid': {
              border: '1px solid rgba(255,177,177,.45)',
              boxShadow: 'inset 0 1px 0 rgba(255,255,255,.06)'
            },
            '.Label': {
              color: 'rgba(232,241,250,.92)',
              fontSize: '12px',
              fontWeight: '600',
              marginBottom: '6px',
              lineHeight: '1'
            },
            '.Tab': {
              backgroundColor: 'rgba(255,255,255,.05)',
              border: '1px solid rgba(255,255,255,.14)',
              boxShadow: 'inset 0 1px 0 rgba(255,255,255,.06)',
              borderRadius: '32px',
              padding: '12px 16px',
              transition: 'background-color .18s ease, border-color .18s ease'
            },
            '.Tab:hover': {
              backgroundColor: 'rgba(255,255,255,.08)',
              borderColor: 'rgba(255,255,255,.22)'
            },
            '.Tab--selected': {
              backgroundColor: '#ffffff',
              borderColor: 'transparent',
              color: '#101828',
              boxShadow: 'inset 0 0 10px 0 rgba(255,255,255,.65), 0 4px 14px 0 rgba(255,255,255,.12)'
            },
            '.Tab--selected:focus': {
              backgroundColor: '#ffffff',
              borderColor: 'transparent',
              color: '#101828'
            },
            '.TabIcon--selected': {
              color: '#101828',
              fill: '#101828'
            },
            '.TabLabel': {
              fontWeight: '600'
            },
            '.PickerItem': {
              backgroundColor: 'rgba(255,255,255,.05)',
              border: '1px solid rgba(255,255,255,.14)',
              borderRadius: '32px',
              padding: '12px 14px'
            },
            '.PickerItem:hover': {
              backgroundColor: 'rgba(255,255,255,.08)',
              borderColor: 'rgba(255,255,255,.22)'
            },
            '.PickerItem--selected': {
              backgroundColor: '#ffffff',
              borderColor: 'transparent',
              color: '#101828'
            },
            '.Block': {
              backgroundColor: 'rgba(255,255,255,.03)',
              border: '1px solid rgba(255,255,255,.10)',
              borderRadius: '32px',
              boxShadow: 'inset 0 1px 0 rgba(255,255,255,.04)'
            },
            '.BlockDivider': {
              backgroundColor: 'rgba(255,255,255,.08)'
            },
            '.Action': {
              color: '#93c5fd',
              fontWeight: '600'
            },
            '.Error': {
              color: '#ffb1b1',
              fontSize: '13px'
            }
          }
        };

        var elements = embeddedCheckoutState.stripeInstance.elements({
          clientSecret: piPayload.clientSecret,
          appearance: droppyAppearance
        });
        embeddedCheckoutState.elements = elements;

        var paymentElement = elements.create('payment');
        embeddedCheckoutState.paymentElement = paymentElement;
        if(modalNodes.paymentElement){
          modalNodes.paymentElement.classList.remove('is-ready');
          modalNodes.paymentElement.classList.add('is-loading');
        }

        var qty = capturedQuantity;
        if(modalNodes.checkoutQtyLabel) modalNodes.checkoutQtyLabel.textContent = 'Quantity: ' + qty;
        var discountPercent = typeof piPayload.quantityDiscountPercent === 'number'
          ? piPayload.quantityDiscountPercent
          : getQuantityDiscountPercent(qty);
        var totalText = formatIntentTotal(embeddedCheckoutState.piAmount, embeddedCheckoutState.piCurrency);
        if(modalNodes.checkoutTotalDisplay) modalNodes.checkoutTotalDisplay.textContent = totalText;
        syncCheckoutDiscountBadge(discountPercent > 0 ? '-' + String(discountPercent) + '%' : '');
        embeddedCheckoutState.displayTotal = totalText;

        modalNodes.payBtn.textContent = 'Pay ' + totalText;
        modalNodes.payBtn.disabled = true;

        paymentElement.on('ready', function(){
          embeddedCheckoutState.paymentMounted = true;
          if(modalNodes.paymentElement){
            modalNodes.paymentElement.classList.remove('is-loading');
            modalNodes.paymentElement.classList.add('is-ready');
          }
        });
        paymentElement.on('change', function(event){
          if(event && event.complete !== undefined){
            embeddedCheckoutState.paymentReady = event.complete;
            modalNodes.payBtn.disabled = !event.complete;
          }
        });

        // Make container visible immediately (Stripe can't mount into display:none).
        // Set opacity:0 so it's invisible while transition animates, then fade in.
        modalNodes.checkoutContainer.style.display = 'block';
        modalNodes.checkoutContainer.style.opacity = '0';
        paymentElement.mount('#droppy-payment-element');
        transitionToPayment();
      } catch (error) {
        setCheckoutButtonDisabled(false);
        if(embeddedCheckoutState.checkout){
          try { embeddedCheckoutState.checkout.destroy(); } catch(e){}
          embeddedCheckoutState.checkout = null;
        }
        var message = (error && error.message) || 'Could not start checkout.';
        if(message.toLowerCase() === 'failed to fetch'){
          message = 'Could not reach checkout service. Disable blockers/VPN for supabase.co and stripe.com, then retry.';
        }
        setModalStatus(message, 'error');
      }
    });

    modalNodes.payBtn.addEventListener('click', async function(event){
      event.preventDefault();
      if(!embeddedCheckoutState.elements || !embeddedCheckoutState.stripeInstance || modalNodes.payBtn.disabled) return;
      modalNodes.payBtn.disabled = true;
      modalNodes.payBtn.textContent = 'Processing\u2026';
      if(modalNodes.checkoutError) modalNodes.checkoutError.style.display = 'none';

      try {
        var emailValue = (modalNodes.checkoutEmail.value || '').trim();

        var siteURL = (config.PUBLIC_SITE_URL || 'https://getdroppy.app').replace(/\/$/, '');
        var result = await embeddedCheckoutState.stripeInstance.confirmPayment({
          elements: embeddedCheckoutState.elements,
          confirmParams: {
            receipt_email: emailValue || undefined,
            return_url: siteURL + '/license-success.html?payment_intent_id=' + encodeURIComponent(embeddedCheckoutState.sessionId)
          },
          redirect: 'if_required'
        });

        if(result.error){
          throw new Error(result.error.message || 'Payment failed.');
        }

        if(result.paymentIntent && result.paymentIntent.status === 'succeeded'){
          transitionToSuccess(embeddedCheckoutState.sessionId);
        }
      } catch (error) {
        modalNodes.payBtn.disabled = false;
        var payText = 'Pay';
        if(embeddedCheckoutState.displayTotal) payText = 'Pay ' + embeddedCheckoutState.displayTotal;
        modalNodes.payBtn.textContent = payText;
        var msg = (error && error.message) || 'Payment could not be completed.';
        if(modalNodes.checkoutError){
          modalNodes.checkoutError.textContent = msg;
          modalNodes.checkoutError.style.display = 'block';
        }
      }
    });

    modalNodes.promoApplyBtn.addEventListener('click', async function(){
      if(!embeddedCheckoutState.sessionId) return;
      var code = (modalNodes.checkoutPromo.value || '').trim();
      if(!code){
        showPromoStatus('Enter a discount code.', 'error');
        return;
      }
      modalNodes.promoApplyBtn.disabled = true;
      modalNodes.promoApplyBtn.textContent = '\u2026';
      showPromoStatus('', null);
      try {
        var promoResponse = await fetch(functionsBaseURL + '/stripe-apply-promo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + anonKey, 'apikey': anonKey },
          body: JSON.stringify({
            payment_intent_id: embeddedCheckoutState.sessionId,
            promo_code: code,
            original_amount: embeddedCheckoutState.piAmount || 0
          })
        });
        var promoResult = await promoResponse.json().catch(function(){ return {}; });
        if(!promoResponse.ok || !promoResult.valid){
          throw new Error(promoResult.error || 'Invalid or expired code.');
        }
        showPromoStatus('', null);
        if(modalNodes.promoRow) modalNodes.promoRow.style.display = 'none';
        var badgeLabel = promoResult.promoName || code;
        if(promoResult.discountPercent) badgeLabel = '-' + promoResult.discountPercent + '%';
        syncCheckoutDiscountBadge(badgeLabel);

        // Handle free order — skip payment, show keys directly.
        if(promoResult.free && promoResult.licenseKeys && promoResult.licenseKeys.length){
          embeddedCheckoutState.licenseKeys = promoResult.licenseKeys;
          embeddedCheckoutState.step = 'success';
          if(embeddedCheckoutState.paymentElement){
            try { embeddedCheckoutState.paymentElement.destroy(); } catch(e){}
            embeddedCheckoutState.paymentElement = null;
          }
          embeddedCheckoutState.elements = null;
          // Animate transition
          modalNodes.panel.classList.add('is-step-leaving');
          setTimeout(function(){
            modalNodes.panel.classList.remove('is-step-leaving','is-payment-step');
            modalNodes.panel.classList.add('is-step-entering');
            modalNodes.checkoutContainer.style.display = 'none';
            modalNodes.purchaseHead.style.display = 'none';
            modalNodes.licenseMeta.style.display = 'none';
            modalNodes.successContainer.style.display = 'grid';
            var keys = promoResult.licenseKeys;
            // Update title
            var successTitle = modalNodes.successContainer.querySelector('.droppy-success-title');
            if(successTitle) successTitle.textContent = keys.length > 1 ? 'Here are your licenses' : 'Here is your license';
            // Update meta
            var successMeta = modalNodes.successContainer.querySelector('.droppy-success-meta');
            if(successMeta) successMeta.innerHTML = 'Copy your key' + (keys.length > 1 ? 's' : '') + ' and use ' + (keys.length > 1 ? 'them' : 'it') + ' in Droppy under <strong>Settings \u2192 License</strong>.';
            modalNodes.successKeyLabel.textContent = keys.length > 1 ? keys.length + ' License keys' : 'License key';
            modalNodes.successKeyList.innerHTML = '';
            keys.forEach(function(key){
              var p = document.createElement('p');
              p.className = 'droppy-license-key';
              p.textContent = key;
              modalNodes.successKeyList.appendChild(p);
            });
            modalNodes.successCopyBtn.disabled = false;
            modalNodes.successCopyBtn.textContent = keys.length > 1 ? 'Copy ' + keys.length + ' License Keys' : 'Copy License Key';
            if(keys.length === 1){
              var activateUrl = 'droppy://license?key=' + encodeURIComponent(keys[0]);
              if(promoResult.purchaserEmail) activateUrl += '&email=' + encodeURIComponent(promoResult.purchaserEmail);
              modalNodes.successActivateBtn.href = activateUrl;
              modalNodes.successActivateBtn.style.display = 'inline-flex';
            }
            setTimeout(function(){ modalNodes.panel.classList.remove('is-step-entering'); }, 340);
          }, 280);
          return;
        }

        if(promoResult.newAmount != null && !promoResult.free){
          embeddedCheckoutState.piAmount = promoResult.newAmount;
          if(typeof promoResult.currency === 'string'){
            embeddedCheckoutState.piCurrency = normalizeSupportedCheckoutCurrency(promoResult.currency) || embeddedCheckoutState.piCurrency;
          }
          var newTotalText = formatIntentTotal(embeddedCheckoutState.piAmount, embeddedCheckoutState.piCurrency);
          if(modalNodes.checkoutTotalDisplay) modalNodes.checkoutTotalDisplay.textContent = newTotalText;
          modalNodes.payBtn.textContent = 'Pay ' + newTotalText;
          embeddedCheckoutState.displayTotal = newTotalText;
        }
      } catch (error) {
        showPromoStatus((error && error.message) || 'Could not apply code.', 'error');
      }
      modalNodes.promoApplyBtn.disabled = false;
      modalNodes.promoApplyBtn.textContent = 'Apply';
    });

    function showPromoStatus(message, type){
      if(!modalNodes.promoStatus) return;
      if(!message){
        modalNodes.promoStatus.style.display = 'none';
        return;
      }
      modalNodes.promoStatus.textContent = message;
      modalNodes.promoStatus.className = 'droppy-promo-status' + (type === 'success' ? ' is-success' : type === 'error' ? ' is-error' : '');
      modalNodes.promoStatus.style.display = 'block';
    }

    modalNodes.backButton.addEventListener('click', function(event){
      event.preventDefault();
      transitionToConfigure();
    });

    modalNodes.successCloseBtn.addEventListener('click', function(event){
      event.preventDefault();
      closePurchaseModal();
    });

    modalNodes.successCopyBtn.addEventListener('click', async function(){
      var keys = embeddedCheckoutState.licenseKeys || [];
      if(!keys.length) return;
      try {
        await navigator.clipboard.writeText(keys.join('\n'));
        modalNodes.successCopyBtn.textContent = 'Copied!';
        setTimeout(function(){
          modalNodes.successCopyBtn.textContent = keys.length > 1
            ? 'Copy ' + keys.length + ' License Keys'
            : 'Copy License Key';
        }, 2000);
      } catch(e){
        setModalStatus('Could not copy automatically. Select and copy the key manually.', 'error');
      }
    });

    return modalNodes;
  }
  function transitionToPayment(){
    if(!modalNodes) return;
    embeddedCheckoutState.step = 'payment';
    // Animate out current content
    modalNodes.panel.classList.add('is-step-leaving');
    setTimeout(function(){
      modalNodes.panel.classList.remove('is-step-leaving');
      modalNodes.panel.classList.add('is-payment-step','is-step-entering');
      // Swap title
      var titleEl = modalNodes.panel.querySelector('.droppy-license-title');
      if(titleEl) titleEl.textContent = 'Complete payment';
      // Swap continue button for back button
      modalNodes.checkoutButton.style.display = 'none';
      modalNodes.backButton.style.display = '';
      // Hide configure-specific elements
      modalNodes.licenseMeta.style.display = 'none';
      modalNodes.pricingCard.style.display = 'none';
      modalNodes.statusNode.hidden = true;
      // Container is already display:block (set before mount). Fade it in.
      modalNodes.checkoutContainer.style.display = 'block';
      modalNodes.checkoutContainer.style.opacity = '1';
      modalNodes.successContainer.style.display = 'none';
      setTimeout(function(){
        modalNodes.panel.classList.remove('is-step-entering');
      }, 340);
    }, 280);
  }
  function transitionToConfigure(){
    if(!modalNodes) return;
    modalNodes.panel.classList.add('is-step-leaving');
    setTimeout(function(){
      resetPurchaseModalToConfigureState();
      modalNodes.panel.classList.add('is-step-entering');
      setTimeout(function(){
        modalNodes.panel.classList.remove('is-step-entering');
      }, 340);
    }, 280);
  }
  function transitionToSuccess(sessionId){
    if(!modalNodes) return;
    embeddedCheckoutState.step = 'success';
    if(embeddedCheckoutState.paymentElement){
      try { embeddedCheckoutState.paymentElement.destroy(); } catch(e){}
      embeddedCheckoutState.paymentElement = null;
    }
    embeddedCheckoutState.elements = null;
    // Animate out, then swap to success
    modalNodes.panel.classList.add('is-step-leaving');
    setTimeout(function(){
      modalNodes.panel.classList.remove('is-step-leaving','is-payment-step');
      modalNodes.panel.classList.add('is-step-entering');
      // Hide payment UI + header
      modalNodes.checkoutContainer.style.display = 'none';
      modalNodes.purchaseHead.style.display = 'none';
      modalNodes.licenseMeta.style.display = 'none';
      // Show success
      modalNodes.successContainer.style.display = 'grid';
      modalNodes.successCopyBtn.disabled = true;
      modalNodes.successCopyBtn.textContent = 'Loading key\u2026';
      modalNodes.successActivateBtn.style.display = 'none';
      modalNodes.successKeyList.innerHTML = '';
      setTimeout(function(){
        modalNodes.panel.classList.remove('is-step-entering');
      }, 340);
    }, 280);
    fetchLicenseForSession(sessionId, 0);
  }
  function fetchLicenseForSession(sessionId, attempt){
    var config = window.DROPPY_LICENSE_FLOW_CONFIG || {};
    var functionsBaseURL = config.FUNCTIONS_BASE_URL;
    var anonKey = config.ANON_KEY;
    if(!functionsBaseURL || !anonKey || !sessionId){
      setModalStatus('License lookup configuration missing.', 'error');
      return;
    }
    fetch(functionsBaseURL + '/stripe-session-license', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + anonKey,
        'apikey': anonKey
      },
      body: JSON.stringify(
        sessionId.startsWith('pi_')
          ? { payment_intent_id: sessionId }
          : { session_id: sessionId }
      )
    })
    .then(function(response){
      return response.json().then(function(payload){
        return { status: response.status, ok: response.ok, data: payload };
      }).catch(function(){
        return { status: response.status, ok: response.ok, data: {} };
      });
    })
    .then(function(result){
      if(result.status === 202 && attempt < 5){
        setTimeout(function(){ fetchLicenseForSession(sessionId, attempt + 1); }, 2500);
        return;
      }
      var keys = [];
      if(Array.isArray(result.data.license_keys) && result.data.license_keys.length){
        keys = result.data.license_keys;
      } else if(typeof result.data.license_key === 'string' && result.data.license_key){
        keys = [result.data.license_key];
      }
      if(!result.ok || !result.data.ready || !keys.length){
        if(attempt < 5){
          setTimeout(function(){ fetchLicenseForSession(sessionId, attempt + 1); }, 2500);
          return;
        }
        setModalStatus(result.data.error || result.data.message || 'Could not retrieve license keys. Check your email for the receipt.', 'error');
        modalNodes.successCopyBtn.textContent = 'Copy License Key';
        modalNodes.successCopyBtn.disabled = true;
        return;
      }
      embeddedCheckoutState.licenseKeys = keys;
      // Update title
      var successTitle = modalNodes.successContainer.querySelector('.droppy-success-title');
      if(successTitle){
        successTitle.textContent = keys.length > 1
          ? 'Here are your licenses'
          : 'Here is your license';
      }
      // Update meta with email note
      var successMeta = modalNodes.successContainer.querySelector('.droppy-success-meta');
      var purchaserEmail = result.data.purchaser_email || '';
      if(successMeta){
        var metaText = 'Copy your key' + (keys.length > 1 ? 's' : '') + ' and use ' + (keys.length > 1 ? 'them' : 'it') + ' in Droppy under <strong>Settings \u2192 License</strong>.';
        if(purchaserEmail){
          metaText += ' A receipt and your key' + (keys.length > 1 ? 's have' : ' has') + ' also been sent to <strong>' + purchaserEmail + '</strong>.';
        }
        successMeta.innerHTML = metaText;
      }
      modalNodes.successKeyLabel.textContent = keys.length > 1
        ? keys.length + ' License keys'
        : 'License key';
      modalNodes.successKeyList.innerHTML = '';
      keys.forEach(function(key){
        var p = document.createElement('p');
        p.className = 'droppy-license-key';
        p.textContent = key;
        modalNodes.successKeyList.appendChild(p);
      });
      modalNodes.successCopyBtn.disabled = false;
      modalNodes.successCopyBtn.textContent = keys.length > 1
        ? 'Copy ' + keys.length + ' License Keys'
        : 'Copy License Key';
      if(result.data.activate_url){
        modalNodes.successActivateBtn.href = result.data.activate_url;
        modalNodes.successActivateBtn.style.display = 'inline-flex';
      } else if(keys.length === 1){
        var activateUrl = 'droppy://license?key=' + encodeURIComponent(keys[0]);
        if(purchaserEmail) activateUrl += '&email=' + encodeURIComponent(purchaserEmail);
        modalNodes.successActivateBtn.href = activateUrl;
        modalNodes.successActivateBtn.style.display = 'inline-flex';
      }
    })
    .catch(function(error){
      if(attempt < 3){
        setTimeout(function(){ fetchLicenseForSession(sessionId, attempt + 1); }, 2000);
        return;
      }
      setModalStatus('Could not retrieve license. Check your email for the receipt.', 'error');
      modalNodes.successCopyBtn.textContent = 'Copy License Key';
      modalNodes.successCopyBtn.disabled = true;
    });
  }
  function openPurchaseModal(){
    closeMobileMenu();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(accountModalState.isOpen) closeAccountModal();
    if(legalModalState.isOpen) closeLegalModal();
    var nodes = createPurchaseModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      purchaseModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    }, nodes.checkoutButton);
  }
  function resetPurchaseModalToConfigureState(){
    if(!modalNodes) return;
    // Destroy Stripe elements
    if(embeddedCheckoutState.paymentElement){
      try { embeddedCheckoutState.paymentElement.destroy(); } catch(e){}
      embeddedCheckoutState.paymentElement = null;
    }
    embeddedCheckoutState.checkout = null;
    embeddedCheckoutState.elements = null;
    embeddedCheckoutState.step = 'configure';
    embeddedCheckoutState.sessionId = null;
    embeddedCheckoutState.licenseKeys = null;
    embeddedCheckoutState.displayTotal = null;
    embeddedCheckoutState.piAmount = null;
    embeddedCheckoutState.piCurrency = null;
    embeddedCheckoutState.paymentReady = false;
    embeddedCheckoutState.paymentMounted = false;
    // Reset modal classes
    modalNodes.panel.classList.remove('is-payment-step','is-step-leaving','is-step-entering');
    // Reset title
    var titleEl = modalNodes.panel.querySelector('.droppy-license-title');
    if(titleEl) titleEl.textContent = 'Grab your license';
    // Reset header: show continue, hide back
    modalNodes.purchaseHead.style.display = '';
    modalNodes.checkoutButton.style.display = '';
    modalNodes.backButton.style.display = 'none';
    // Show configure elements
    modalNodes.licenseMeta.style.display = '';
    modalNodes.pricingCard.style.display = '';
    // Hide checkout + success
    modalNodes.checkoutContainer.style.display = 'none';
    modalNodes.checkoutContainer.style.opacity = '';
    modalNodes.successContainer.style.display = 'none';
    // Reset form fields
    if(modalNodes.checkoutEmail) modalNodes.checkoutEmail.value = '';
    if(modalNodes.checkoutPromo){ modalNodes.checkoutPromo.value = ''; modalNodes.checkoutPromo.disabled = false; modalNodes.checkoutPromo.style.display = ''; }
    if(modalNodes.promoRow) modalNodes.promoRow.style.display = '';
    syncCheckoutDiscountBadge('');
    if(modalNodes.promoStatus) modalNodes.promoStatus.style.display = 'none';
    if(modalNodes.checkoutError) modalNodes.checkoutError.style.display = 'none';
    if(modalNodes.paymentElement){
      modalNodes.paymentElement.classList.remove('is-loading','is-ready');
      modalNodes.paymentElement.innerHTML = '';
    }
    if(modalNodes.payBtn){ modalNodes.payBtn.disabled = true; modalNodes.payBtn.textContent = 'Pay'; }
    // Reset success container state
    if(modalNodes.successActivateBtn) modalNodes.successActivateBtn.style.display = 'none';
    if(modalNodes.successKeyList) modalNodes.successKeyList.innerHTML = '';
    // Reset status + buttons
    setCheckoutButtonDisabled(modalNodes.hasCheckoutConfig === false);
    setModalStatus('', null);
  }
  function closePurchaseModal(){
    if(!modalNodes || !purchaseModalState.isOpen) return;
    morphModalHide(modalNodes.overlay, modalNodes.panel, function(){
      purchaseModalState.isOpen = false;
      resetPurchaseModalToConfigureState();
      modalNodes.overlay.classList.remove('is-open');
      modalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function isPurchaseAnchor(anchor){
    if(!(anchor instanceof HTMLAnchorElement)) return false;
    if(anchor.closest('.droppy-license-modal')) return false;
    if(anchor.hasAttribute('data-droppy-purchase-trigger')) return true;
    var label = normalizedText(anchor.textContent || '');
    if(label === 'purchase a license' || label === 'purchase license' || label === 'purchase') {
      var href = (anchor.getAttribute('href') || '').toLowerCase();
      if(href.indexOf('droppy') !== -1 || href === '#purchase' || href === '') return true;
    }
    return false;
  }
  function patchPurchaseAnchors(){
    document.querySelectorAll('a').forEach(function(a){
      if(!isPurchaseAnchor(a)) return;
      a.setAttribute('data-droppy-purchase-trigger', '1');
      a.setAttribute('href', '#purchase');
      a.removeAttribute('target');
      a.removeAttribute('rel');
    });
  }
  function wirePurchaseTriggers(){
    createPurchaseModal();
    patchPurchaseAnchors();
    if(!window.__droppyPurchaseDelegated){
      window.__droppyPurchaseDelegated = true;
      document.addEventListener('click', function(event){
        if(event.defaultPrevented) return;
        if(event.button !== undefined && event.button !== 0) return;
        var target = event.target instanceof Element ? event.target : null;
        if(!target) return;
        var anchor = target.closest('a');
        if(!anchor || !isPurchaseAnchor(anchor)) return;
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        setModalStatus('', null);
        openPurchaseModal();
      }, true);
    }
  }
  function setReclaimStatus(message, type){
    if(!reclaimModalNodes || !reclaimModalNodes.statusNode) return;
    var hasMessage = !!(message && message.trim());
    reclaimModalNodes.statusNode.textContent = message || '';
    reclaimModalNodes.statusNode.classList.remove('error', 'success');
    if(type) reclaimModalNodes.statusNode.classList.add(type);
    reclaimModalNodes.statusNode.hidden = !hasMessage;
  }
  function createReclaimModal(){
    if(reclaimModalNodes) return reclaimModalNodes;
    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay';
    overlay.id = 'droppy-reclaim-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-reclaim-modal-title">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div id="droppy-reclaim-modal-title" class="droppy-license-title-wrap" data-framer-name="Reclaim your key" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
              '<h1 class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Reclaim your key</h1>' +
            '</div>' +
            '<p class="droppy-license-meta">If you previously bought Droppy on Gumroad, you can claim a new Droppy license by entering your previous Gumroad purchase license key.</p>' +
          '</div>' +
          '<button id="droppy-reclaim-continue-button" type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn droppy-inline-continue" style="background-color:#ffffff;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px;box-shadow:inset 0px 0px 10px 0px rgba(255, 255, 255, 0.65), 0px 5px 18px 0px rgba(255,255,255,0.12)">' +
            '<div class="framer-ng3b95" data-framer-name="Continue to reclaim" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;--framer-paragraph-spacing:0px;transform:none" data-framer-component-type="RichTextContainer">' +
              '<p class="framer-text framer-styles-preset-3f7vf4" data-styles-preset="bWiCpUaS8">Continue</p>' +
            '</div>' +
          '</button>' +
        '</header>' +
        '<p id="droppy-reclaim-status" class="droppy-license-modal-status" aria-live="polite" hidden></p>' +
      '</div>';
    document.body.appendChild(overlay);

    reclaimModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-license-modal'),
      continueButton: overlay.querySelector('#droppy-reclaim-continue-button'),
      statusNode: overlay.querySelector('#droppy-reclaim-status')
    };

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closeReclaimModal();
    });

    reclaimModalNodes.continueButton.addEventListener('click', function(event){
      event.preventDefault();
      event.stopPropagation();
      try {
        window.location.assign(resolveClaimLicenseURL());
      } catch (error) {
        setReclaimStatus('Could not open claim page. Please try again.', 'error');
      }
    });

    return reclaimModalNodes;
  }
  function openReclaimModal(){
    closeMobileMenu();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(accountModalState.isOpen) closeAccountModal();
    if(legalModalState.isOpen) closeLegalModal();
    var nodes = createReclaimModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      reclaimModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    }, nodes.continueButton);
  }
  function closeReclaimModal(){
    if(!reclaimModalNodes || !reclaimModalState.isOpen) return;
    morphModalHide(reclaimModalNodes.overlay, reclaimModalNodes.panel, function(){
      reclaimModalState.isOpen = false;
      reclaimModalNodes.overlay.classList.remove('is-open');
      reclaimModalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function wireReclaimTriggers(){
    createReclaimModal();
    document.querySelectorAll('[data-droppy-reclaim-trigger]').forEach(function(a){
      if(a.dataset.reclaimModalPatched === '1') return;
      a.dataset.reclaimModalPatched = '1';
      a.setAttribute('href', '#reclaim-license');
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        ev.stopPropagation();
        setReclaimStatus('', null);
        openReclaimModal();
      }, true);
    });
  }
  function createFaqModal(){
    if(faqModalNodes) return faqModalNodes;

    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay droppy-faq-modal-overlay';
    overlay.id = 'droppy-faq-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.setAttribute('data-lenis-prevent', '');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-faq-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-faq-modal-title" tabindex="-1">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div id="droppy-faq-modal-title" class="droppy-license-title-wrap" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
              '<h1 class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Droppy FAQ</h1>' +
            '</div>' +
            '<p class="droppy-license-meta">Answers about licenses, downloads, and more.</p>' +
          '</div>' +
        '</header>' +
        '<div id="droppy-faq-scroll" class="droppy-faq-scroll" data-lenis-prevent></div>' +
      '</div>';
    document.body.appendChild(overlay);

    faqModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-faq-modal'),
      list: overlay.querySelector('#droppy-faq-scroll')
    };

    faqModalNodes.list.innerHTML = faqEntries.map(function(item){
      var answer = item.answerHtml ? item.answerHtml : linkifyText(item.answer || '');
      var actionsHtml = '';
      if(Array.isArray(item.actions) && item.actions.length){
        actionsHtml = '<div class="droppy-faq-actions">' + item.actions.map(function(a){
          var external = a.href && a.href.indexOf('http') === 0;
          var iconSvg = '';
          if(a.icon === 'discord'){
            iconSvg = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371 13.327 13.327 0 0 0-.608 1.2526 18.2699 18.2699 0 0 0-5.4875 0 12.6404 12.6404 0 0 0-.6171-1.2526.077.077 0 0 0-.0785-.037A19.7363 19.7363 0 0 0 3.677 4.3698a.0699.0699 0 0 0-.0321.0277C.5334 9.0467-.319 13.58.0992 18.0578a.0824.0824 0 0 0 .0312.0561 19.9 19.9 0 0 0 5.9933 3.0294.0777.0777 0 0 0 .0842-.0276 14.2 14.2 0 0 0 1.226-1.9942.076.076 0 0 0-.0416-.1057 13.1066 13.1066 0 0 1-1.872-.892.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.074.074 0 0 1 .0785.0095c.1202.099.246.198.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067 15.91 15.91 0 0 0 1.226 1.9933.076.076 0 0 0 .0842.0286 19.85 19.85 0 0 0 6.0022-3.0294.0775.0775 0 0 0 .0313-.0552c.501-5.177-.838-9.6735-3.5491-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1568-1.0857-2.1568-2.419 0-1.3332.9555-2.4189 2.1568-2.4189 1.2108 0 2.1761 1.0952 2.1568 2.4189 0 1.3332-.9555 2.419-2.1568 2.419zm7.9748 0c-1.1825 0-2.1568-1.0857-2.1568-2.419 0-1.3332.9554-2.4189 2.1568-2.4189 1.2108 0 2.1761 1.0952 2.1568 2.4189 0 1.3332-.946 2.419-2.1568 2.419z"/></svg>';
          } else if(a.icon === 'mail'){
            iconSvg = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/><path d="m2 7 10 7L22 7"/></svg>';
          }
          return '<a class="droppy-faq-action droppy-faq-action--' + (a.variant || 'secondary') + '" href="' +
            escapeHtml(a.href) + '"' +
            (external ? ' target="_blank" rel="noopener noreferrer"' : '') +
            '>' + iconSvg + '<span>' + escapeHtml(a.label) + '</span></a>';
        }).join('') + '</div>';
      }
      return '' +
        '<article class="droppy-faq-item">' +
          '<h3 class="droppy-faq-question">' + escapeHtml(item.question) + '</h3>' +
          '<p class="droppy-faq-answer">' + answer + '</p>' +
          actionsHtml +
        '</article>';
    }).join('');

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closeFaqModal();
    });

    return faqModalNodes;
  }
  function openFaqModal(){
    closeMobileMenu();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(accountModalState.isOpen) closeAccountModal();
    if(legalModalState.isOpen) closeLegalModal();
    var nodes = createFaqModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      faqModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    });
  }
  function closeFaqModal(){
    if(!faqModalNodes || !faqModalState.isOpen) return;
    morphModalHide(faqModalNodes.overlay, faqModalNodes.panel, function(){
      faqModalState.isOpen = false;
      faqModalNodes.overlay.classList.remove('is-open');
      faqModalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function wireFaqTriggers(){
    createFaqModal();
    document.querySelectorAll('a').forEach(function(a){
      var label = normalizedText(a.textContent || '');
      var href = (a.getAttribute('href') || '').toLowerCase();
      var isFaqLink = (
        label === 'droppy faq' ||
        href === '#faq' ||
        href.indexOf('/#faq') !== -1 ||
        href.indexOf('getdroppy.app/#faq') !== -1 ||
        href.indexOf('droppy.app/#faq') !== -1
      );
      if(!isFaqLink) return;
      if(a.dataset.faqModalPatched === '1') return;
      a.dataset.faqModalPatched = '1';
      a.setAttribute('href', '#faq');
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.setAttribute('data-droppy-faq-trigger', '1');
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        ev.stopPropagation();
        openFaqModal();
      }, true);
    });
  }

  /* ---- Website changelog: "Update: <date>" nav pill + scrollable popup.
     Data comes from docs/changelog.json, which release_droppy.sh refreshes from
     each release's notes file, so new builds appear here automatically. ---- */
  function compareReleaseVersionsDesc(a, b){
    var pa = String(a || '').split('.').map(function(n){ return parseInt(n, 10) || 0; });
    var pb = String(b || '').split('.').map(function(n){ return parseInt(n, 10) || 0; });
    for(var i = 0; i < Math.max(pa.length, pb.length); i++){
      var da = pa[i] || 0, db = pb[i] || 0;
      if(da !== db) return db - da;
    }
    return 0;
  }
  function loadChangelogData(){
    if(changelogDataPromise) return changelogDataPromise;
    changelogDataPromise = fetch('./changelog.json', { cache: 'no-cache' })
      .then(function(res){ if(!res.ok) throw new Error('changelog ' + res.status); return res.json(); })
      .then(function(data){
        var releases = (data && Array.isArray(data.releases)) ? data.releases.slice() : [];
        releases.sort(function(a, b){ return compareReleaseVersionsDesc(a.version, b.version); });
        return releases;
      })
      .catch(function(){ return []; });
    return changelogDataPromise;
  }
  var CHANGELOG_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var CHANGELOG_MONTHS_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  function parseChangelogDate(str){
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(str || ''));
    return m ? { y: +m[1], mo: (+m[2]) - 1, d: +m[3] } : null;
  }
  function formatNavUpdateDate(str){
    var p = parseChangelogDate(str);
    if(!p || !CHANGELOG_MONTHS[p.mo]) return '';
    var base = CHANGELOG_MONTHS[p.mo] + ' ' + p.d;
    return (p.y === new Date().getFullYear()) ? base : (base + ', ' + p.y);
  }
  function formatChangelogDateFull(str){
    var p = parseChangelogDate(str);
    if(!p || !CHANGELOG_MONTHS_FULL[p.mo]) return '';
    return CHANGELOG_MONTHS_FULL[p.mo] + ' ' + p.d + ', ' + p.y;
  }
  var CHANGELOG_SECTION_LABELS = {
    'new features': 'New',
    'bug fixes': 'Fixed',
    'refinements': 'Improved',
    'updates': 'Highlights'
  };
  function changelogSectionLabel(title){
    var key = String(title || '').trim().toLowerCase();
    return CHANGELOG_SECTION_LABELS[key] || title;
  }
  function renderChangelogInto(list){
    if(!list) return;
    list.innerHTML = '<p class="droppy-changelog-empty">Loading updates&hellip;</p>';
    loadChangelogData().then(function(releases){
      if(!releases.length){
        list.innerHTML = '<p class="droppy-changelog-empty">No updates to show yet.</p>';
        return;
      }
      list.innerHTML = releases.map(function(rel){
        var sectionsHtml = (rel.sections || []).map(function(sec){
          var items = (sec.items || []).map(function(it){ return '<li>' + escapeHtml(it) + '</li>'; }).join('');
          if(!items) return '';
          return '<div class="droppy-changelog-section">' +
              '<h4 class="droppy-changelog-section-title">' + escapeHtml(changelogSectionLabel(sec.title)) + '</h4>' +
              '<ul class="droppy-changelog-list">' + items + '</ul>' +
            '</div>';
        }).join('');
        return '<article class="droppy-changelog-release">' +
            '<header class="droppy-changelog-release-head">' +
              '<span class="droppy-changelog-version">Droppy ' + escapeHtml(rel.version) + '</span>' +
              '<span class="droppy-changelog-date">' + escapeHtml(formatChangelogDateFull(rel.date)) + '</span>' +
            '</header>' + sectionsHtml +
          '</article>';
      }).join('');
    });
  }
  function createChangelogModal(){
    if(changelogModalNodes) return changelogModalNodes;
    /* Hard guard: remove any stale overlay (e.g. left by an earlier cached
       build) so the popup can never render as stacked duplicate copies. */
    document.querySelectorAll('.droppy-changelog-modal-overlay').forEach(function(el){ el.remove(); });
    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay droppy-changelog-modal-overlay';
    overlay.id = 'droppy-changelog-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.setAttribute('data-lenis-prevent', '');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-changelog-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-changelog-modal-title" tabindex="-1">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div id="droppy-changelog-modal-title" class="droppy-license-title-wrap" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
              '<h1 class="framer-text droppy-license-title" style="--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">What’s New</h1>' +
            '</div>' +
            '<p class="droppy-license-meta">Every Droppy update, newest first.</p>' +
          '</div>' +
        '</header>' +
        '<div id="droppy-changelog-scroll" class="droppy-changelog-scroll" data-lenis-prevent></div>' +
      '</div>';
    document.body.appendChild(overlay);
    changelogModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-changelog-modal'),
      list: overlay.querySelector('#droppy-changelog-scroll')
    };
    overlay.addEventListener('click', function(event){ if(event.target === overlay) closeChangelogModal(); });
    renderChangelogInto(changelogModalNodes.list);
    return changelogModalNodes;
  }
  /* ---- Generic trigger <-> popup morph ----
     The popup PANEL itself scales + translates (a GPU transform) from the
     clicked trigger's position out to its final centred rect, with the content
     living INSIDE it the whole time, over a solid dim. Because it's the real
     panel (not a stand-in box), nothing ever detaches or leaks, and because it
     animates transform + opacity only, it's composited on the GPU with no
     layout jitter. Reverses on close, collapsing back into the button it came
     from. Falls back to a plain open/close for reduced-motion / no WAAPI or
     when there's no usable trigger. Used by every modal via morphModalShow /
     morphModalHide. */
  var MODAL_MORPH_MS = 460;
  var MODAL_MORPH_EASE = 'cubic-bezier(.22,1,.36,1)';
  var modalMorphSeq = 0;
  /* The element clicked in the current event loop, used as the morph origin.
     Captured in the capture phase so it's set before any modal trigger handler
     runs. Cleared on a macrotask (NOT a microtask: a microtask checkpoint runs
     between event-listener invocations, which would wipe the trigger before the
     modal's own click handler reads it and make every popup fall back to a
     plain fade). The macrotask only fires once the whole click has finished. */
  var pendingModalTrigger = null;
  var pendingModalTriggerTimer = null;
  document.addEventListener('click', function(e){
    var t = (e.target && e.target.closest) ? e.target.closest('a,button,[role="button"]') : null;
    pendingModalTrigger = t || null;
    if(pendingModalTriggerTimer) clearTimeout(pendingModalTriggerTimer);
    pendingModalTriggerTimer = setTimeout(function(){ pendingModalTrigger = null; pendingModalTriggerTimer = null; }, 0);
  }, true);
  function consumeModalTrigger(){
    var t = pendingModalTrigger;
    if(t && document.contains(t)){
      var r = t.getBoundingClientRect();
      if(r.width > 0 && r.height > 0) return t;
    }
    return null;
  }
  function modalMorphEnabled(){
    return typeof Element !== 'undefined' && typeof Element.prototype.animate === 'function' &&
      !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  }
  /* Transform mapping the panel onto the trigger: scaled down UNIFORMLY (so the
     content never distorts) and centred on the trigger. transform-origin stays
     the panel's own centre (the default). */
  function morphFlipTransform(panelRect, triggerRect){
    var s = triggerRect.width / panelRect.width;
    if(s > 0.92) s = 0.92;
    if(s < 0.05) s = 0.05;
    var tx = (triggerRect.left + triggerRect.width / 2) - (panelRect.left + panelRect.width / 2);
    var ty = (triggerRect.top + triggerRect.height / 2) - (panelRect.top + panelRect.height / 2);
    return 'translate(' + tx.toFixed(2) + 'px,' + ty.toFixed(2) + 'px) scale(' + s.toFixed(4) + ')';
  }
  /* Cancel any in-flight morph and clear its inline styles, so rapid toggling or
     switching popups can never strand a panel mid-transform. Bumping
     modalMorphSeq also neutralises stale finish callbacks. */
  function resetModalMorph(){
    modalMorphSeq++;
    document.querySelectorAll('.droppy-license-modal[data-morphing="1"]').forEach(function(p){
      p.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      delete p.dataset.morphing;
      p.style.transform = ''; p.style.opacity = ''; p.style.transition = ''; p.style.willChange = '';
    });
    document.querySelectorAll('.droppy-license-modal-overlay[data-morphing="1"]').forEach(function(o){
      o.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      delete o.dataset.morphing;
      o.style.opacity = ''; o.style.pointerEvents = '';
    });
    return modalMorphSeq;
  }
  function onMorphFinish(anim, gen, fn){
    var ran = false;
    var done = function(){ if(ran || gen !== modalMorphSeq) return; ran = true; fn(); };
    anim.addEventListener('finish', done);
    anim.addEventListener('cancel', done);
    /* Wall-clock safety net for a throttled/background tab where the animation
       timeline (and finish event) never advances. */
    setTimeout(done, MODAL_MORPH_MS + 140);
  }
  /* Show a modal, scaling the panel out from the trigger that opened it.
     applyShow() performs the modal's real open (state + is-open + body lock). */
  function morphModalShow(overlay, panel, applyShow, focusTarget){
    var focusEl = focusTarget || panel;
    var trigger = consumeModalTrigger();
    var gen = resetModalMorph();
    if(!(modalMorphEnabled() && trigger)){
      applyShow();
      window.setTimeout(function(){ try{ focusEl.focus(); }catch(_){} }, 70);
      return;
    }
    overlay._morphTrigger = trigger;
    var tRect = trigger.getBoundingClientRect();
    applyShow();
    /* Pin the panel to its final rect (no CSS transition) so we read a true rect
       and the WAAPI fully owns the entrance. */
    panel.style.transition = 'none';
    panel.style.transform = 'none';
    var pRect = panel.getBoundingClientRect();
    var fromT = morphFlipTransform(pRect, tRect);
    panel.dataset.morphing = '1';
    panel.style.willChange = 'transform,opacity';
    panel.style.transform = fromT;
    overlay.dataset.morphing = '1';
    overlay.style.transition = 'none';
    overlay.style.opacity = '0';
    var panelAnim = panel.animate(
      [{ transform: fromT }, { transform: 'none' }],
      { duration: MODAL_MORPH_MS, easing: MODAL_MORPH_EASE, fill: 'both' }
    );
    /* Solid dim quickly, then hold, so the panel grows against a stable backdrop. */
    overlay.animate(
      [{ opacity: 0, offset: 0 }, { opacity: 1, offset: 0.45 }, { opacity: 1, offset: 1 }],
      { duration: MODAL_MORPH_MS, easing: 'ease-out', fill: 'both' }
    );
    onMorphFinish(panelAnim, gen, function(){
      delete panel.dataset.morphing; delete overlay.dataset.morphing;
      panel.style.transform = ''; panel.style.transition = ''; panel.style.willChange = '';
      panel.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      overlay.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      overlay.style.opacity = ''; overlay.style.transition = '';
      try{ focusEl.focus(); }catch(_){}
    });
  }
  /* Hide a modal, collapsing the panel back into the trigger it came from.
     applyHide() performs the modal's real close (state + remove is-open + lock). */
  function morphModalHide(overlay, panel, applyHide){
    var trigger = overlay._morphTrigger;
    var gen = resetModalMorph();
    if(!(modalMorphEnabled() && trigger && document.contains(trigger) && trigger.getBoundingClientRect().width > 0)){
      applyHide();
      return;
    }
    var pRect = panel.getBoundingClientRect();
    var tRect = trigger.getBoundingClientRect();
    var toT = morphFlipTransform(pRect, tRect);
    panel.style.transition = 'none';
    panel.dataset.morphing = '1';
    panel.style.willChange = 'transform,opacity';
    overlay.dataset.morphing = '1';
    overlay.style.transition = 'none';
    overlay.style.pointerEvents = 'none';
    /* Play the EXACT open morph in reverse (same keyframes, same easing, just
       direction:reverse) so the popup collapses back into the button as one
       cohesive motion — a perfect mirror of the way it opened. */
    var panelAnim = panel.animate(
      [{ transform: toT }, { transform: 'none' }],
      { duration: MODAL_MORPH_MS, easing: MODAL_MORPH_EASE, fill: 'both', direction: 'reverse' }
    );
    overlay.animate(
      [{ opacity: 0, offset: 0 }, { opacity: 1, offset: 0.45 }, { opacity: 1, offset: 1 }],
      { duration: MODAL_MORPH_MS, easing: 'ease-out', fill: 'both', direction: 'reverse' }
    );
    onMorphFinish(panelAnim, gen, function(){
      panel.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      overlay.getAnimations().forEach(function(a){ try{ a.cancel(); }catch(_){} });
      delete panel.dataset.morphing; delete overlay.dataset.morphing;
      panel.style.transform = ''; panel.style.transition = ''; panel.style.willChange = '';
      overlay.style.opacity = ''; overlay.style.transition = ''; overlay.style.pointerEvents = '';
      applyHide();
      overlay._morphTrigger = null;
    });
  }
  function openChangelogModal(){
    closeMobileMenu();
    if(faqModalState.isOpen) closeFaqModal();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(legalModalState.isOpen) closeLegalModal();
    if(changelogModalState.isOpen) return;
    var nodes = createChangelogModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      changelogModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    });
  }
  function closeChangelogModal(){
    if(!changelogModalNodes || !changelogModalState.isOpen) return;
    var nodes = changelogModalNodes;
    morphModalHide(nodes.overlay, nodes.panel, function(){
      changelogModalState.isOpen = false;
      nodes.overlay.classList.remove('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function initializeChangelogModalState(){
    if(changelogModalState.initialized) return;
    changelogModalState.initialized = true;
    createChangelogModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape') closeChangelogModal();
    });
    var hash = (window.location.hash || '').toLowerCase();
    if(hash === '#changelog' || hash === '#whats-new' || hash === '#updates'){
      openChangelogModal();
    }
  }
  function ensureRecoverLicenseButton(){
    if(document.querySelector('.droppy-fixed-button-stack')) return;
    var stack = document.createElement('div');
    stack.className = 'droppy-fixed-button-stack';

    var recoverLink = document.createElement('a');
    recoverLink.href = './recover-license.html';
    recoverLink.textContent = 'Recover License';

    var purchaseLink = document.createElement('a');
    purchaseLink.href = '#purchase';
    purchaseLink.textContent = 'Purchase a License';
    purchaseLink.setAttribute('data-droppy-purchase-trigger', '1');

    stack.appendChild(recoverLink);
    stack.appendChild(purchaseLink);

    document.body.appendChild(stack);
  }
  function resolveLegalDocumentKey(anchor){
    if(!(anchor instanceof HTMLElement)) return '';
    var label = normalizedText(anchor.textContent || '');
    var href = (anchor.getAttribute('href') || '').toLowerCase();
    if(
      label === 'privacy policy' ||
      href === '#privacy-policy' ||
      href.indexOf('/#privacy-policy') !== -1 ||
      href.indexOf('privacy-policy') !== -1
    ){
      return 'privacy';
    }
    if(
      label === 'terms of service' ||
      label === 'terms of use' ||
      href === '#terms-of-service' ||
      href === '#term-of-service' ||
      href === '#terms' ||
      href.indexOf('/#terms-of-service') !== -1 ||
      href.indexOf('term-of-service') !== -1 ||
      href.indexOf('terms-of-service') !== -1
    ){
      return 'terms';
    }
    return '';
  }
  function renderLegalDocument(docKey){
    var nodes = createLegalModal();
    var legalDoc = legalDocuments[docKey] || legalDocuments.privacy;
    legalModalState.activeDocument = docKey in legalDocuments ? docKey : 'privacy';
    nodes.titleNode.textContent = legalDoc.title;
    nodes.metaNode.textContent = legalDoc.subtitle;
    nodes.scrollNode.innerHTML = (legalDoc.sections || []).map(function(section){
      var heading = section.heading
        ? '<h3 class="droppy-legal-section-title">' + escapeHtml(section.heading) + '</h3>'
        : '';
      var paragraphs = (section.paragraphs || []).map(function(paragraph){
        return '<p class="droppy-legal-paragraph">' + linkifyLegalText(paragraph) + '</p>';
      }).join('');
      var bullets = Array.isArray(section.bullets) && section.bullets.length
        ? '<ul class="droppy-legal-list">' + section.bullets.map(function(item){
            return '<li>' + linkifyLegalText(item) + '</li>';
          }).join('') + '</ul>'
        : '';
      return '<article class="droppy-legal-section">' + heading + paragraphs + bullets + '</article>';
    }).join('');
    nodes.scrollNode.scrollTop = 0;
  }
  function createLegalModal(){
    if(legalModalNodes) return legalModalNodes;

    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay droppy-legal-modal-overlay';
    overlay.id = 'droppy-legal-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-legal-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-legal-modal-title" tabindex="-1">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div class="droppy-license-title-wrap" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
              '<h1 id="droppy-legal-modal-title" class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Privacy Policy</h1>' +
            '</div>' +
            '<p id="droppy-legal-modal-meta" class="droppy-license-meta">Effective February 26, 2026.</p>' +
          '</div>' +
        '</header>' +
        '<div id="droppy-legal-scroll" class="droppy-legal-scroll"></div>' +
      '</div>';
    document.body.appendChild(overlay);

    legalModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-legal-modal'),
      titleNode: overlay.querySelector('#droppy-legal-modal-title'),
      metaNode: overlay.querySelector('#droppy-legal-modal-meta'),
      scrollNode: overlay.querySelector('#droppy-legal-scroll')
    };

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closeLegalModal();
    });

    return legalModalNodes;
  }
  function openLegalModal(docKey){
    closeMobileMenu();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(accountModalState.isOpen) closeAccountModal();
    renderLegalDocument(docKey || 'privacy');
    var nodes = createLegalModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      legalModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    });
  }
  function closeLegalModal(){
    if(!legalModalNodes || !legalModalState.isOpen) return;
    morphModalHide(legalModalNodes.overlay, legalModalNodes.panel, function(){
      legalModalState.isOpen = false;
      legalModalNodes.overlay.classList.remove('is-open');
      legalModalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function buildInstallModalCardsHtml(){
    var step1 = '' +
      '<div class="droppy-install-card">' +
        '<div class="droppy-install-visual droppy-install-visual-1">' +
          '<div class="droppy-install-browser">' +
            '<div class="droppy-install-browser-row">' +
              '<svg class="droppy-install-file-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" fill="rgba(255,255,255,.18)" stroke="rgba(255,255,255,.5)" stroke-width="1"/><path d="M14 3v4h4" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1"/></svg>' +
              '<div class="droppy-install-file-meta">' +
                '<div class="droppy-install-file-name">Droppy.dmg</div>' +
                '<div class="droppy-install-file-sub">50 MB &middot; Done</div>' +
              '</div>' +
              '<div class="droppy-install-dl-arrow"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v8m0 0 3-3m-3 3-3-3M4 13h8" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>' +
            '</div>' +
            '<svg class="droppy-install-cursor droppy-install-cursor-1" viewBox="0 0 18 22" aria-hidden="true"><path d="M2 2 16 11 9.5 12.5 13 20 10 21 6.5 13.5 2 16Z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg>' +
          '</div>' +
        '</div>' +
        '<div class="droppy-install-step-label">Step 1</div>' +
        '<h3 class="droppy-install-step-title">Open</h3>' +
        '<p class="droppy-install-step-desc">Open the Droppy.dmg file from your Downloads.</p>' +
      '</div>';

    var step2 = '' +
      '<div class="droppy-install-card">' +
        '<div class="droppy-install-visual droppy-install-visual-2">' +
          '<div class="droppy-install-drag">' +
            '<div class="droppy-install-app-icon"><img alt="" decoding="async" loading="lazy" src="./assets/images/droppy-v2-app-icon.png"></div>' +
            '<svg class="droppy-install-arrow" viewBox="0 -30 200 80" overflow="visible" preserveAspectRatio="none" aria-hidden="true"><defs><marker id="droppyInstallArrowhead" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L12 6 L0 12 z" fill="#fff"/></marker></defs><path d="M 0 50 C 40 -30, 160 -30, 200 50" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-dasharray="5 6" marker-end="url(#droppyInstallArrowhead)" vector-effect="non-scaling-stroke"/></svg>' +
            '<div class="droppy-install-folder"><img alt="Applications" decoding="async" loading="lazy" src="./assets/images/macos-applications-folder.png"></div>' +
            '<svg class="droppy-install-cursor droppy-install-cursor-2" viewBox="0 0 18 22" aria-hidden="true"><path d="M2 2 16 11 9.5 12.5 13 20 10 21 6.5 13.5 2 16Z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg>' +
          '</div>' +
        '</div>' +
        '<div class="droppy-install-step-label">Step 2</div>' +
        '<h3 class="droppy-install-step-title">Install</h3>' +
        '<p class="droppy-install-step-desc">Drag the Droppy app into your Applications folder.</p>' +
      '</div>';

    var step3 = '' +
      '<div class="droppy-install-card">' +
        '<div class="droppy-install-visual droppy-install-visual-3">' +
          '<div class="droppy-install-dock">' +
            '<div class="droppy-install-dock-row">' +
              '<div class="droppy-install-dock-item droppy-install-dock-finder"><img alt="Finder" decoding="async" loading="lazy" src="./assets/images/macos-finder.png"></div>' +
              '<div class="droppy-install-dock-item droppy-install-dock-safari"><img alt="Safari" decoding="async" loading="lazy" src="./assets/images/macos-safari.png"></div>' +
              '<div class="droppy-install-dock-item droppy-install-dock-droppy">' +
                '<span class="droppy-install-dock-tooltip">Droppy</span>' +
                '<img alt="Droppy" decoding="async" loading="lazy" src="./assets/images/droppy-v2-app-icon.png">' +
                '<span class="droppy-install-dock-indicator"></span>' +
              '</div>' +
              '<div class="droppy-install-dock-item droppy-install-dock-photos"><img alt="Photos" decoding="async" loading="lazy" src="./assets/images/macos-photos.png"></div>' +
            '</div>' +
            '<svg class="droppy-install-cursor droppy-install-cursor-3" viewBox="0 0 18 22" aria-hidden="true"><path d="M2 2 16 11 9.5 12.5 13 20 10 21 6.5 13.5 2 16Z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg>' +
          '</div>' +
        '</div>' +
        '<div class="droppy-install-step-label">Step 3</div>' +
        '<h3 class="droppy-install-step-title">Launch</h3>' +
        '<p class="droppy-install-step-desc">Open Droppy from your Applications folder or Launchpad.</p>' +
      '</div>';

    return step1 + step2 + step3;
  }
  function createInstallModal(){
    if(installModalNodes) return installModalNodes;

    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay droppy-install-modal-overlay';
    overlay.id = 'droppy-install-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-install-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-install-modal-title" tabindex="-1">' +
        '<header class="droppy-license-modal-header droppy-install-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div class="droppy-license-title-wrap" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none">' +
              '<h1 id="droppy-install-modal-title" class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Install and open Droppy</h1>' +
            '</div>' +
            '<p class="droppy-license-meta">The Desktop App should have downloaded automatically. If not, you can <a href="#" class="droppy-install-manual-link" data-droppy-install-manual="1">download it manually</a>.</p>' +
          '</div>' +
        '</header>' +
        '<div class="droppy-install-grid">' + buildInstallModalCardsHtml() + '</div>' +
      '</div>';
    document.body.appendChild(overlay);

    installModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-install-modal'),
      manualLink: overlay.querySelector('.droppy-install-manual-link')
    };

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closeInstallModal();
    });
    if(installModalNodes.manualLink){
      installModalNodes.manualLink.addEventListener('click', function(event){
        event.preventDefault();
        var url = getStableDownloadUrl();
        if(url){
          window.open(url, '_blank', 'noopener');
        }
      });
    }

    return installModalNodes;
  }
  function openInstallModal(){
    closeMobileMenu();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(accountModalState.isOpen) closeAccountModal();
    if(legalModalState.isOpen) closeLegalModal();
    var nodes = createInstallModal();
    morphModalShow(nodes.overlay, nodes.panel, function(){
      installModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
    });
  }
  function closeInstallModal(){
    if(!installModalNodes || !installModalState.isOpen) return;
    morphModalHide(installModalNodes.overlay, installModalNodes.panel, function(){
      installModalState.isOpen = false;
      installModalNodes.overlay.classList.remove('is-open');
      installModalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function initializeInstallModalState(){
    if(installModalState.initialized) return;
    installModalState.initialized = true;
    createInstallModal();
    document.addEventListener('keydown', function(event){
      if(event.key === 'Escape' && installModalState.isOpen) closeInstallModal();
    });
  }
  function wireInstallInstructionsTrigger(){
    if(window.__droppyInstallTriggerBound) return;
    window.__droppyInstallTriggerBound = true;
    document.addEventListener('click', function(event){
      if(event.defaultPrevented) return;
      if(event.button !== undefined && event.button !== 0) return;
      var target = event.target instanceof Element ? event.target : null;
      if(!target) return;
      var anchor = target.closest('a');
      if(!anchor || !isDownloadAnchor(anchor)) return;
      window.setTimeout(function(){ openInstallModal(); }, 80);
    }, false);
  }
  function wireLegalTriggers(){
    createLegalModal();
    document.querySelectorAll('a').forEach(function(a){
      var docKey = resolveLegalDocumentKey(a);
      if(!docKey) return;
      if(a.dataset.legalModalPatched === '1') return;
      a.dataset.legalModalPatched = '1';
      a.setAttribute('data-droppy-legal-trigger', docKey);
      a.setAttribute('href', docKey === 'privacy' ? '#privacy-policy' : '#terms-of-service');
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        ev.stopPropagation();
        openLegalModal(docKey);
      }, true);
    });
  }
  function setAccountStatus(message, type){
    if(!accountModalNodes || !accountModalNodes.statusNode) return;
    var hasMessage = !!(message && message.trim());
    accountModalNodes.statusNode.textContent = message || '';
    accountModalNodes.statusNode.classList.remove('error', 'success');
    if(type) accountModalNodes.statusNode.classList.add(type);
    accountModalNodes.statusNode.hidden = !hasMessage;
  }
  function renderAccountLicenses(licenses){
    if(!accountModalNodes || !accountModalNodes.licensesNode) return;
    var list = Array.isArray(licenses) ? licenses : [];
    if(list.length === 0){
      accountModalNodes.licensesNode.innerHTML = '<p class="droppy-account-empty">No saved licenses yet.</p>';
      return;
    }

    accountModalNodes.licensesNode.innerHTML = list.map(function(item, index){
      var key = typeof item.license_key === 'string' ? item.license_key : '';
      var issued = typeof item.issued_at === 'string' ? item.issued_at : '';
      var issuedLabel = issued ? new Date(issued).toLocaleDateString() : 'Unknown date';
      return '' +
        '<div class="droppy-account-license">' +
          '<div class="droppy-account-license-head">' +
            '<p class="droppy-account-license-meta">Issued ' + issuedLabel + '</p>' +
            '<button type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn droppy-account-copy" data-license-copy-index="' + index + '" data-droppy-license-copy-allowed="1" style="background-color:#ffffff;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px;box-shadow:inset 0px 0px 8px 0px rgba(255,255,255,.6)"><span class="framer-text" style="color:#101828">Copy</span></button>' +
          '</div>' +
          '<p class="droppy-account-license-key" data-droppy-license-copy-allowed="1">' + (key || 'Unavailable for this license') + '</p>' +
        '</div>';
    }).join('');

    accountModalNodes.licensePayload = list;
  }
  async function fetchAccountLicenses(accessToken){
    var config = modalConfig();
    if(!config.functionsBaseURL || !config.anonKey){
      throw new Error('Account services are not configured.');
    }

    var response = await fetch(config.functionsBaseURL + '/account-licenses', {
      method: 'GET',
      headers: {
        'Authorization': 'Bearer ' + accessToken,
        'apikey': config.anonKey
      }
    });
    var payload = await response.json().catch(function(){ return {}; });
    if(!response.ok){
      throw new Error(payload.error || 'Could not load account licenses.');
    }
    return payload;
  }
  async function linkLicenseToAccount(accessToken, licenseKey){
    var config = modalConfig();
    if(!config.functionsBaseURL || !config.anonKey){
      throw new Error('Account services are not configured.');
    }
    var response = await fetch(config.functionsBaseURL + '/account-link-license', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + accessToken,
        'apikey': config.anonKey
      },
      body: JSON.stringify({ license_key: licenseKey })
    });
    var payload = await response.json().catch(function(){ return {}; });
    if(!response.ok){
      throw new Error(payload.error || 'Could not save license key.');
    }
    return payload;
  }
  async function refreshAccountModal(){
    if(!accountModalNodes) return;
    accountModalNodes.licensePayload = [];
    setAccountStatus('', null);

    try {
      var session = await getSupabaseSession();
      if(!session || !session.user){
        accountModalNodes.loginRow.hidden = false;
        accountModalNodes.loggedRow.hidden = true;
        accountModalNodes.linkRow.hidden = true;
        accountModalNodes.licensesNode.innerHTML = '<p class="droppy-account-empty">Log in to see your saved keys.</p>';
        return;
      }

      accountModalNodes.loginRow.hidden = true;
      accountModalNodes.loggedRow.hidden = false;
      accountModalNodes.linkRow.hidden = false;
      accountModalNodes.emailNode.textContent = session.user.email || 'Signed in';

      var payload = await fetchAccountLicenses(session.access_token);
      var licenses = payload.licenses || [];
      renderAccountLicenses(licenses);
      var pendingKey = getPendingLicenseKey();
      if(pendingKey && Array.isArray(licenses)){
        var foundPending = licenses.some(function(item){
          return !!item && item.license_key === pendingKey;
        });
        if(foundPending) clearPendingLicenseKey();
      }
    } catch (error) {
      setAccountStatus((error && error.message) || 'Could not load account details.', 'error');
    }
  }
  function createAccountModal(){
    if(accountModalNodes) return accountModalNodes;
    var overlay = document.createElement('div');
    overlay.className = 'droppy-license-modal-overlay droppy-account-modal-overlay';
    overlay.id = 'droppy-account-modal-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-license-modal droppy-account-modal" role="dialog" aria-modal="true" aria-labelledby="droppy-account-modal-title">' +
        '<header class="droppy-license-modal-header">' +
          '<div class="droppy-license-copy">' +
            '<div id="droppy-account-modal-title" class="droppy-license-title-wrap" style="outline:none;display:flex;flex-direction:column;justify-content:flex-start;flex-shrink:0;transform:none" data-framer-component-type="RichTextContainer">' +
              '<h1 class="framer-text droppy-license-title" style="--font-selector:R0Y7SW5zdHJ1bWVudCBTZXJpZi1yZWd1bGFy;--framer-font-family:&quot;Instrument Serif&quot;, &quot;Instrument Serif Placeholder&quot;, serif;--framer-font-weight:400;--framer-letter-spacing:-0.03em;--framer-line-height:92%;--framer-text-color:rgb(246, 251, 255)">Your account</h1>' +
            '</div>' +
            '<p class="droppy-license-meta">Log in to save and recover your license keys at any time.</p>' +
          '</div>' +
        '</header>' +
        '<div id="droppy-account-login-row" class="droppy-account-auth-row">' +
          '<input id="droppy-account-email" type="email" autocomplete="email" placeholder="you@example.com">' +
          '<button id="droppy-account-send-link" type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn droppy-inline-continue" style="background-color:#ffffff;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px;box-shadow:inset 0px 0px 10px 0px rgba(255,255,255,.65), 0px 5px 18px 0px rgba(255,255,255,.12)"><div class="framer-ng3b95"><p class="framer-text framer-styles-preset-3f7vf4" data-styles-preset="bWiCpUaS8">Send Login Link</p></div></button>' +
        '</div>' +
        '<div id="droppy-account-logged-row" class="droppy-account-row-head" hidden>' +
          '<p id="droppy-account-email-label" class="droppy-account-email"></p>' +
          '<button id="droppy-account-logout" type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn" style="background-color:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#e7edf5;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px"><span class="framer-text">Log out</span></button>' +
        '</div>' +
        '<div id="droppy-account-link-row" class="droppy-account-link-row" hidden>' +
          '<input id="droppy-account-license-input" data-droppy-license-copy-allowed="1" type="text" autocomplete="off" spellcheck="false" placeholder="DRPY-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX">' +
          '<button id="droppy-account-save-key" type="button" class="framer-seHzO framer-2gzj02 framer-v-2gzj02 framer-1a7uupv droppy-modal-btn droppy-inline-continue" style="background-color:#ffffff;border-bottom-left-radius:100px;border-bottom-right-radius:100px;border-top-left-radius:100px;border-top-right-radius:100px;box-shadow:inset 0px 0px 10px 0px rgba(255,255,255,.65), 0px 5px 18px 0px rgba(255,255,255,.12)"><div class="framer-ng3b95"><p class="framer-text framer-styles-preset-3f7vf4" data-styles-preset="bWiCpUaS8">Save Key</p></div></button>' +
        '</div>' +
        '<div id="droppy-account-licenses" class="droppy-account-list"><p class="droppy-account-empty">Log in to see your saved keys.</p></div>' +
        '<p id="droppy-account-status" class="droppy-license-modal-status" aria-live="polite" hidden></p>' +
      '</div>';
    document.body.appendChild(overlay);

    accountModalNodes = {
      overlay: overlay,
      panel: overlay.querySelector('.droppy-account-modal'),
      loginRow: overlay.querySelector('#droppy-account-login-row'),
      loggedRow: overlay.querySelector('#droppy-account-logged-row'),
      linkRow: overlay.querySelector('#droppy-account-link-row'),
      statusNode: overlay.querySelector('#droppy-account-status'),
      licensesNode: overlay.querySelector('#droppy-account-licenses'),
      emailInput: overlay.querySelector('#droppy-account-email'),
      emailNode: overlay.querySelector('#droppy-account-email-label'),
      sendLinkButton: overlay.querySelector('#droppy-account-send-link'),
      logoutButton: overlay.querySelector('#droppy-account-logout'),
      saveKeyButton: overlay.querySelector('#droppy-account-save-key'),
      keyInput: overlay.querySelector('#droppy-account-license-input'),
      licensePayload: []
    };

    overlay.addEventListener('click', function(event){
      if(event.target === overlay) closeAccountModal();
    });

    accountModalNodes.sendLinkButton.addEventListener('click', async function(){
      var email = (accountModalNodes.emailInput.value || '').trim().toLowerCase();
      if(!email || email.indexOf('@') === -1){
        setAccountStatus('Enter a valid email address.', 'error');
        return;
      }
      try {
        var client = await ensureSupabaseClient();
        var redirectTo = resolveAccountMagicLinkRedirectURL();
        await client.auth.signInWithOtp({
          email: email,
          options: { emailRedirectTo: redirectTo }
        });
        setAccountStatus('Magic link sent. Check your email to sign in.', 'success');
      } catch (error) {
        setAccountStatus((error && error.message) || 'Could not send login email.', 'error');
      }
    });

    accountModalNodes.logoutButton.addEventListener('click', async function(){
      try {
        var client = await ensureSupabaseClient();
        await client.auth.signOut();
        setAccountStatus('Signed out.', 'success');
        refreshAccountModal();
      } catch (error) {
        setAccountStatus((error && error.message) || 'Could not sign out.', 'error');
      }
    });

    accountModalNodes.saveKeyButton.addEventListener('click', async function(){
      var licenseKey = normalizeModalLicenseKey(accountModalNodes.keyInput.value || '');
      if(!licenseKey){
        setAccountStatus('Enter a valid Droppy license key.', 'error');
        return;
      }
      try {
        var token = await getSupabaseAccessToken();
        if(!token){
          setAccountStatus('Log in before saving a key.', 'error');
          return;
        }
        await linkLicenseToAccount(token, licenseKey);
        accountModalNodes.keyInput.value = '';
        clearPendingLicenseKey();
        setAccountStatus('License key saved to your account.', 'success');
        await refreshAccountModal();
      } catch (error) {
        setAccountStatus((error && error.message) || 'Could not save license key.', 'error');
      }
    });

    accountModalNodes.keyInput.addEventListener('input', function(){
      accountModalNodes.keyInput.value = accountModalNodes.keyInput.value.toUpperCase();
    });

    accountModalNodes.licensesNode.addEventListener('click', function(event){
      var target = event.target;
      if(!(target instanceof HTMLElement)) return;
      var button = target.closest('[data-license-copy-index]');
      if(!(button instanceof HTMLElement)) return;
      var rawIndex = button.getAttribute('data-license-copy-index');
      var index = rawIndex ? Number.parseInt(rawIndex, 10) : -1;
      var entry = index >= 0 ? accountModalNodes.licensePayload[index] : null;
      if(!entry || typeof entry.license_key !== 'string') return;
      navigator.clipboard.writeText(entry.license_key).then(function(){
        setAccountStatus('License key copied.', 'success');
      }).catch(function(){
        setAccountStatus('Could not copy. Copy it manually from the list.', 'error');
      });
    });

    return accountModalNodes;
  }
  function openAccountModal(){
    closeMobileMenu();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(legalModalState.isOpen) closeLegalModal();
    var nodes = createAccountModal();
    var preloadKey = normalizeModalLicenseKey(new URLSearchParams(window.location.search).get('license_key') || '');
    var pendingKey = preloadKey || getPendingLicenseKey();
    if(pendingKey && nodes.keyInput){
      nodes.keyInput.value = pendingKey;
      setPendingLicenseKey(pendingKey);
    }
    if(preloadKey){
      try {
        history.replaceState(null, '', window.location.pathname + window.location.hash);
      } catch (_) {}
    }
    morphModalShow(nodes.overlay, nodes.panel, function(){
      accountModalState.isOpen = true;
      void nodes.overlay.offsetHeight;
      nodes.overlay.classList.add('is-open');
      nodes.overlay.setAttribute('aria-hidden', 'false');
      syncBodyModalLock();
      refreshAccountModal();
    }, nodes.emailInput);
  }
  function closeAccountModal(){
    if(!accountModalNodes || !accountModalState.isOpen) return;
    morphModalHide(accountModalNodes.overlay, accountModalNodes.panel, function(){
      accountModalState.isOpen = false;
      accountModalNodes.overlay.classList.remove('is-open');
      accountModalNodes.overlay.setAttribute('aria-hidden', 'true');
      syncBodyModalLock();
    });
  }
  function wireAccountTriggers(){
    createAccountModal();
    ensureAccountDockLinks();
    if(!accountDockSyncBound){
      accountDockSyncBound = true;
      var refreshAccountDock = function(){ ensureAccountDockLinks(); };
      window.addEventListener('resize', refreshAccountDock);
      window.addEventListener('orientationchange', refreshAccountDock);
    }

    if(!document.querySelector('[data-droppy-account-trigger]')){
      var faqLink = null;
      document.querySelectorAll('a').forEach(function(a){
        if(faqLink) return;
        if(normalizedText(a.textContent || '') === 'droppy faq') faqLink = a;
      });

      if(faqLink){
        var faqContainer = faqLink.closest('div[class*="-container"]');
        if(faqContainer && faqContainer.parentElement){
          var accountContainer = faqContainer.cloneNode(true);
          var accountLink = accountContainer.querySelector('a');
          if(accountLink){
            accountLink.setAttribute('href', '#account');
            accountLink.removeAttribute('target');
            accountLink.removeAttribute('rel');
            accountLink.setAttribute('data-droppy-account-trigger', '1');
            accountLink.querySelectorAll('.framer-text').forEach(function(node){
              node.textContent = 'Account';
            });
            faqContainer.parentElement.insertBefore(accountContainer, faqContainer);
          }
        }
      }
    }

    document.querySelectorAll('[data-droppy-account-trigger]').forEach(function(a){
      if(a.dataset.accountModalPatched === '1') return;
      a.dataset.accountModalPatched = '1';
      a.setAttribute('href', '#account');
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.addEventListener('click', function(ev){
        ev.preventDefault();
        ev.stopPropagation();
        setAccountStatus('', null);
        openAccountModal();
      }, true);
    });
  }
  function ensureAccountDockLinks(){
    function isSeparatorNode(node){
      if(!(node instanceof HTMLElement)) return false;
      var name = (node.getAttribute('data-framer-name') || '').toLowerCase();
      return name.indexOf('seprator') !== -1 || name.indexOf('separator') !== -1;
    }
    function stripAccountFromMainDock(nav){
      var accountAnchor = null;
      nav.querySelectorAll('a').forEach(function(a){
        if(accountAnchor) return;
        var label = normalizedText(a.textContent || '');
        if(label === 'account' || a.getAttribute('data-droppy-nav-account') === '1'){
          accountAnchor = a;
        }
      });
      if(!accountAnchor) return;

      var accountItem = accountAnchor.closest('[data-framer-component-type="RichTextContainer"]');
      if(!(accountItem instanceof HTMLElement) || !accountItem.parentElement) return;

      var prev = accountItem.previousElementSibling;
      var next = accountItem.nextElementSibling;
      accountItem.remove();
      if(isSeparatorNode(prev)) prev.remove();
      else if(isSeparatorNode(next)) next.remove();
    }
    function positionAccountDock(nav, dock){
      var baseRect = nav.getBoundingClientRect();
      if(baseRect.width < 10 || baseRect.height < 10){
        dock.classList.remove('is-visible');
        return;
      }
      var gap = window.innerWidth <= 1199 ? 10 : 14;
      var matchedHeight = Math.round(baseRect.height);
      dock.style.height = matchedHeight + 'px';
      dock.style.minHeight = matchedHeight + 'px';

      // Center the combined width of main nav + gap + account dock.
      nav.style.marginLeft = '0px';
      var dockWidth = Math.max(dock.offsetWidth || 0, dock.getBoundingClientRect().width || 0, 130);
      var shiftLeft = Math.round((gap + dockWidth) / 2);
      nav.style.marginLeft = '-' + shiftLeft + 'px';

      var rect = nav.getBoundingClientRect();
      dock.style.left = Math.round(rect.right + gap) + 'px';
      dock.style.top = Math.round(rect.top + (rect.height / 2)) + 'px';
      dock.style.transform = 'translateY(-50%)';
      dock.classList.add('is-visible');
    }

    var navs = [];
    document.querySelectorAll('.framer-1wzrkvf-container nav[data-framer-name="Big"]').forEach(function(nav){
      stripAccountFromMainDock(nav);
      nav.style.removeProperty('margin-left');
      navs.push(nav);
    });

    var activeNav = null;
    var activeArea = 0;
    navs.forEach(function(nav){
      if(!(nav instanceof HTMLElement)) return;
      var computed = window.getComputedStyle(nav);
      if(computed.display === 'none' || computed.visibility === 'hidden') return;
      var rect = nav.getBoundingClientRect();
      if(rect.width < 10 || rect.height < 10) return;
      if(rect.bottom < 0 || rect.top > window.innerHeight) return;
      if(rect.right < 0 || rect.left > window.innerWidth) return;
      var area = rect.width * rect.height;
      if(area > activeArea){
        activeArea = area;
        activeNav = nav;
      }
    });

    var accountDock = document.body.querySelector('nav.droppy-account-dock');
    if(!(accountDock instanceof HTMLElement)){
      accountDock = document.createElement('nav');
      accountDock.className = 'droppy-account-dock';
      accountDock.setAttribute('aria-label', 'Account');
      document.body.appendChild(accountDock);
    }

    if(!(activeNav instanceof HTMLElement)){
      accountDock.classList.remove('is-visible');
      return;
    }

    // Match the live visual surface of the main dock.
    accountDock.style.background = activeNav.style.background;
    accountDock.style.backdropFilter = activeNav.style.backdropFilter;
    accountDock.style.webkitBackdropFilter = activeNav.style.webkitBackdropFilter;
    accountDock.style.boxShadow = activeNav.style.boxShadow;
    accountDock.style.borderTopLeftRadius = activeNav.style.borderTopLeftRadius;
    accountDock.style.borderTopRightRadius = activeNav.style.borderTopRightRadius;
    accountDock.style.borderBottomLeftRadius = activeNav.style.borderBottomLeftRadius;
    accountDock.style.borderBottomRightRadius = activeNav.style.borderBottomRightRadius;

    var pricingAnchor = null;
    activeNav.querySelectorAll('a').forEach(function(a){
      if(pricingAnchor) return;
      if(normalizedText(a.textContent || '') === 'pricing') pricingAnchor = a;
    });
    if(!pricingAnchor){
      accountDock.classList.remove('is-visible');
      return;
    }

    var accountAnchor = accountDock.querySelector('a[data-droppy-nav-account="1"]');
    if(!(accountAnchor instanceof HTMLElement)){
      accountDock.textContent = '';
      accountAnchor = document.createElement('a');
      accountDock.appendChild(accountAnchor);
    }
    accountAnchor.setAttribute('href', '#account');
    accountAnchor.removeAttribute('target');
    accountAnchor.removeAttribute('rel');
    accountAnchor.setAttribute('data-droppy-account-trigger', '1');
    accountAnchor.setAttribute('data-droppy-nav-account', '1');
    accountAnchor.setAttribute('aria-label', 'Account');
    accountAnchor.setAttribute('title', 'Account');
    accountAnchor.innerHTML = '<span class="droppy-account-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" role="img" focusable="false"><circle cx="12" cy="8" r="4.2" stroke="currentColor" stroke-width="1.8"></circle><path d="M4.5 19.5a7.5 7.5 0 0 1 15 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></span>';

    positionAccountDock(activeNav, accountDock);
  }
  function removeAccountEntryPoints(){
    document.querySelectorAll('a').forEach(function(a){
      var label = normalizedText(a.textContent || '');
      var href = (a.getAttribute('href') || '').trim().toLowerCase();
      var isAccountLink = (
        label === 'account' ||
        href === '#account' ||
        href === '/#account' ||
        href.indexOf('#account') !== -1 ||
        a.getAttribute('data-droppy-account-trigger') === '1' ||
        a.getAttribute('data-droppy-nav-account') === '1'
      );
      if(!isAccountLink) return;
      var removable = a.closest('[data-framer-component-type="RichTextContainer"], div[class*="-container"]');
      if(removable && removable.parentElement){
        removable.remove();
        return;
      }
      a.remove();
    });
    document.querySelectorAll('.droppy-account-dock, #droppy-account-modal-overlay').forEach(function(node){
      node.remove();
    });
  }
  function wireInPageNav(){
    var navMap = {
      home: '#hero',
      features: '#features',
      extensions: '#gallery',
      pricing: '#pricing'
    };

    // Force known nav labels to hash targets in case hydration rewrites hrefs.
    document.querySelectorAll('a').forEach(function(a){
      var label = (a.textContent || '').trim().toLowerCase();
      if(navMap[label]) a.setAttribute('href', navMap[label]);
    });

    // Intercept nav anchor clicks and scroll in-page (no directory navigation).
    document.querySelectorAll('a[href^="#"], a[href*="./#"]').forEach(function(a){
      if(a.dataset.droppyScrollPatched === '1') return;
      a.dataset.droppyScrollPatched = '1';
      a.addEventListener('click', function(ev){
        var href = (a.getAttribute('href') || '').trim();
        var clickedFromMobileMenu = !!a.closest('#droppy-mobile-menu-overlay');
        var hashIndex = href.indexOf('#');
        if(hashIndex < 0){
          if(clickedFromMobileMenu) closeMobileMenu();
          return;
        }
        var id = href.slice(hashIndex + 1);
        if(!id){
          if(clickedFromMobileMenu) closeMobileMenu();
          return;
        }
        var target = document.getElementById(id);
        if(!target){
          if(clickedFromMobileMenu) closeMobileMenu();
          return;
        }
        ev.preventDefault();
        ev.stopPropagation();
        if(clickedFromMobileMenu) closeMobileMenu();
        if(window._droppyHorizontalScroll && !window._droppyHorizontalScroll.isMobile()){
          window._droppyHorizontalScroll.scrollToSection(id);
        } else {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        try { history.replaceState(null, '', '#' + id); } catch (_) {}
      }, true);
    });
  }
  function isElementVisible(element){
    if(!(element instanceof HTMLElement)) return false;
    var computed = window.getComputedStyle(element);
    if(computed.display === 'none' || computed.visibility === 'hidden') return false;
    var rect = element.getBoundingClientRect();
    return rect.width > 0 && rect.height > 0;
  }
  function syncMobileMenuButtonState(){
    document.querySelectorAll('.framer-1wzrkvf-container nav[data-framer-name="Small Closed"] .framer-y0o1i8').forEach(function(button){
      if(!(button instanceof HTMLElement)) return;
      button.setAttribute('aria-expanded', mobileMenuState.isOpen ? 'true' : 'false');
    });
    document.querySelectorAll('.droppy-mobile-menu-fab').forEach(function(button){
      button.setAttribute('aria-expanded', mobileMenuState.isOpen ? 'true' : 'false');
      button.setAttribute('aria-label', mobileMenuState.isOpen ? 'Close menu' : 'Open menu');
      button.classList.toggle('is-open', mobileMenuState.isOpen);
    });
  }
  function syncMobileMenuLock(){
    if(mobileMenuState.isOpen){
      document.body.classList.add('droppy-mobile-menu-open');
      return;
    }
    document.body.classList.remove('droppy-mobile-menu-open');
  }
  function createMobileMenuOverlay(){
    if(mobileMenuState.overlay) return mobileMenuState.overlay;

    var overlay = document.createElement('div');
    overlay.id = 'droppy-mobile-menu-overlay';
    overlay.className = 'droppy-mobile-menu-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = '' +
      '<div class="droppy-mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Navigation menu">' +
        '<div class="droppy-mobile-menu-head">' +
          '<p class="droppy-mobile-menu-title">Menu</p>' +
        '</div>' +
        '<nav class="droppy-mobile-menu-nav" aria-label="Mobile menu">' +
          '<a class="droppy-mobile-menu-link" data-droppy-nav-link="1" href="#hero">Home</a>' +
          '<a class="droppy-mobile-menu-link" data-droppy-nav-link="1" href="#pricing">Pricing</a>' +
          '<a class="droppy-mobile-menu-link is-cta" href="#purchase" data-droppy-purchase-trigger="1">Purchase License</a>' +
          '<a class="droppy-mobile-menu-link" href="#faq" data-droppy-faq-trigger="1">FAQ</a>' +
          '<a class="droppy-mobile-menu-link" href="#changelog" data-droppy-changelog-trigger="1">What’s New</a>' +
          '<a class="droppy-mobile-menu-link" href="./recover-license.html">Recover License</a>' +
        '</nav>' +
      '</div>';
    document.body.appendChild(overlay);

    overlay.addEventListener('click', function(event){
      var target = event.target;
      if(!(target instanceof HTMLElement)) return;
      var link = target.closest('.droppy-mobile-menu-link');
      if(link){
        if(link.getAttribute('data-droppy-changelog-trigger') === '1'){
          event.preventDefault();
          openChangelogModal(); /* also closes the mobile menu */
          return;
        }
        closeMobileMenu();
        return;
      }
      if(target === overlay){
        closeMobileMenu();
      }
    });

    mobileMenuState.overlay = overlay;
    return overlay;
  }
  function resolveActiveSectionId(){
    if(window._droppyHorizontalScroll && !window._droppyHorizontalScroll.isMobile()){
      var hActive = window._droppyHorizontalScroll.resolveActiveSection();
      if(hActive) return hActive;
    }
    var sectionIds = ['hero', 'features', 'gallery', 'pricing'];
    var marker = window.scrollY + Math.min(window.innerHeight * 0.35, 320);
    var active = sectionIds[0];

    sectionIds.forEach(function(id){
      var section = document.getElementById(id);
      if(!(section instanceof HTMLElement)) return;
      var top = section.getBoundingClientRect().top + window.scrollY;
      if(marker >= top - 32) active = id;
    });

    return active;
  }
  function syncMobileMenuActiveSection(){
    var activeId = resolveActiveSectionId();
    document.querySelectorAll('.droppy-mobile-menu-link[data-droppy-nav-link="1"]').forEach(function(link){
      var href = (link.getAttribute('href') || '').trim();
      var hashIndex = href.indexOf('#');
      var linkId = hashIndex >= 0 ? href.slice(hashIndex + 1) : '';
      var isActive = linkId === activeId;
      link.classList.toggle('is-active', isActive);
      if(isActive){
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }
  function openMobileMenu(){
    if(window.matchMedia('(min-width: 1200px)').matches) return;
    if(purchaseModalState.isOpen) closePurchaseModal();
    if(reclaimModalState.isOpen) closeReclaimModal();
    if(faqModalState.isOpen) closeFaqModal();
    if(accountModalState.isOpen) closeAccountModal();
    var overlay = createMobileMenuOverlay();
    mobileMenuState.isOpen = true;
    void overlay.offsetHeight;
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    syncMobileMenuLock();
    syncMobileMenuButtonState();
    syncMobileMenuActiveSection();
  }
  function closeMobileMenu(){
    if(!mobileMenuState.overlay || !mobileMenuState.isOpen) return;
    mobileMenuState.isOpen = false;
    mobileMenuState.overlay.classList.remove('is-open');
    mobileMenuState.overlay.setAttribute('aria-hidden', 'true');
    syncMobileMenuLock();
    syncMobileMenuButtonState();
  }
  function toggleMobileMenu(){
    if(mobileMenuState.isOpen){
      closeMobileMenu();
      return;
    }
    openMobileMenu();
  }
  function ensureMobileMenuButton(){
    var existing = document.querySelector('.droppy-mobile-menu-fab');
    if(existing) return existing;
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'droppy-mobile-menu-fab';
    button.setAttribute('aria-label', 'Open menu');
    button.setAttribute('aria-haspopup', 'dialog');
    button.setAttribute('aria-expanded', 'false');
    button.innerHTML =
      '<svg class="droppy-mobile-menu-fab-open" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>' +
      '<svg class="droppy-mobile-menu-fab-close" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
    button.addEventListener('click', function(event){
      event.preventDefault();
      event.stopPropagation();
      toggleMobileMenu();
    });
    document.body.appendChild(button);
    return button;
  }
  function wireMobileMenuFallback(){
    createMobileMenuOverlay();
    ensureMobileMenuButton();
    var hasVisibleTrigger = isElementVisible(document.querySelector('.droppy-mobile-menu-fab'));

    document.querySelectorAll('.framer-1wzrkvf-container nav[data-framer-name="Small Closed"] .framer-y0o1i8').forEach(function(button){
      if(!(button instanceof HTMLElement)) return;
      var nav = button.closest('nav[data-framer-name="Small Closed"]');
      if(isElementVisible(nav)) hasVisibleTrigger = true;

      if(button.dataset.droppyMobileMenuPatched === '1') return;
      button.dataset.droppyMobileMenuPatched = '1';
      button.setAttribute('role', 'button');
      button.setAttribute('aria-label', 'Open menu');
      button.setAttribute('aria-haspopup', 'dialog');
      button.setAttribute('aria-expanded', 'false');

      button.addEventListener('click', function(event){
        event.preventDefault();
        event.stopPropagation();
        toggleMobileMenu();
      }, true);
      button.addEventListener('keydown', function(event){
        if(event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        event.stopPropagation();
        toggleMobileMenu();
      }, true);
    });

    if(!mobileMenuState.wired){
      mobileMenuState.wired = true;
      var handleViewportChange = function(){
        if(window.matchMedia('(min-width: 1200px)').matches){
          closeMobileMenu();
        }
      };
      window.addEventListener('resize', handleViewportChange);
      window.addEventListener('orientationchange', handleViewportChange);
      window.addEventListener('scroll', syncMobileMenuActiveSection, { passive: true });
      document.addEventListener('keydown', function(event){
        if(event.key === 'Escape') closeMobileMenu();
      });
    }

    if(!hasVisibleTrigger) closeMobileMenu();
    syncMobileMenuButtonState();
    syncMobileMenuActiveSection();
  }
  function applyMobileHeroHeadlineLayout(){
    var hero = document.getElementById('hero');
    if(!hero) return;

    var isMobile = window.matchMedia('(max-width: 809px)').matches;
    var primaryNodes = hero.querySelectorAll('.framer-1rmrzte .framer-text');
    var secondaryNodes = hero.querySelectorAll('.framer-1yylnnf .framer-text');

    primaryNodes.forEach(function(node){
      if(!(node instanceof HTMLElement)) return;
      if(!node.dataset.droppyHeroOriginalPrimary){
        node.dataset.droppyHeroOriginalPrimary = (node.textContent || '').trim() || 'Droppy for macOS';
      }
      if(isMobile){
        if(node.dataset.droppyHeroLayoutMode !== 'mobile'){
          node.textContent = node.dataset.droppyHeroOriginalPrimary;
          node.dataset.droppyLettersReady = '';
        }
        node.dataset.droppyHeroLayoutMode = 'mobile';
        node.style.whiteSpace = 'normal';
        node.style.textWrap = 'balance';
        node.style.overflowWrap = 'normal';
        node.style.wordBreak = 'normal';
        return;
      }
      if(node.dataset.droppyHeroLayoutMode === 'mobile'){
        node.textContent = node.dataset.droppyHeroOriginalPrimary;
        node.dataset.droppyLettersReady = '';
      }
      node.dataset.droppyHeroLayoutMode = 'desktop';
    });

    secondaryNodes.forEach(function(node){
      if(!(node instanceof HTMLElement)) return;
      if(!node.dataset.droppyHeroOriginalSecondary){
        node.dataset.droppyHeroOriginalSecondary = (node.textContent || '').trim() || "Your Mac, just way better.";
      }
      if(isMobile){
        if(node.dataset.droppyHeroLayoutMode !== 'mobile'){
          node.textContent = "Your Mac, just way better.";
          node.dataset.droppyLettersReady = '';
        }
        node.dataset.droppyHeroLayoutMode = 'mobile';
        node.style.whiteSpace = 'normal';
        node.style.textWrap = 'balance';
        node.style.overflowWrap = 'normal';
        node.style.wordBreak = 'normal';
        return;
      }
      if(node.dataset.droppyHeroLayoutMode === 'mobile'){
        node.textContent = node.dataset.droppyHeroOriginalSecondary;
        node.dataset.droppyLettersReady = '';
      }
      node.dataset.droppyHeroLayoutMode = 'desktop';
    });
  }

  function animateHeroHeadingLetters(){
    var isMobile = window.matchMedia('(max-width: 809px)').matches;
    var lineNodes = document.querySelectorAll('#hero .framer-mk7lz9 .framer-1rmrzte .framer-text, #hero .framer-mk7lz9 .framer-1yylnnf .framer-text');
    lineNodes.forEach(function(node){
      if(!(node instanceof HTMLElement)) return;
      var isPrimary = !!node.closest('.framer-1rmrzte');
      var original = isPrimary
        ? (node.dataset.droppyHeroOriginalPrimary || (node.textContent || '').trim() || 'Droppy for macOS')
        : (node.dataset.droppyHeroOriginalSecondary || (node.textContent || '').trim() || "Your Mac, just way better.");
      node.removeAttribute('aria-label');
      node.textContent = original;
      node.dataset.droppyLettersReady = '1';
    });
  }
  function replayHeroHeadingBlurReveal(){
    animateHeroHeadingLetters();
  }
  function ensureHeroFirstPaintStructure(){
    var hero = document.getElementById('hero');
    if(!hero) return;

    stripHeroAppearIds(hero);
    applyMobileHeroHeadlineLayout();
    animateHeroHeadingLetters();
    forceHeroPrimaryLineSingleLine();

    hero.querySelectorAll('.framer-wdvr1e, .framer-s9qlth-container, .framer-yeprz2-container').forEach(function(node){
      if(node instanceof HTMLElement) node.style.display = 'none';
    });

    hero.querySelectorAll('.framer-1ycnx3s-container').forEach(function(container){
      if(!(container instanceof HTMLElement)) return;
      var downloadBtn = container.querySelector('a[data-framer-name="Blue Button With Icon"]');
      if(!(downloadBtn instanceof HTMLAnchorElement)) return;

      container.classList.add('droppy-hero-cta-row');
      container.style.opacity = '1';
      container.style.transform = 'none';
      container.style.willChange = 'auto';

      var downloadText = downloadBtn.querySelector('.framer-text');
      if(downloadText) downloadText.textContent = 'Download';
      if(!downloadBtn.querySelector('.droppy-apple-icon')){
        downloadBtn.insertBefore(createAppleIconNode(), downloadBtn.firstChild);
      }
      applyDownloadUrlToAnchor(downloadBtn, getStableDownloadUrl());

      var purchaseBtn = container.querySelector('.droppy-hero-purchase');
      if(!(purchaseBtn instanceof HTMLAnchorElement)){
        purchaseBtn = downloadBtn.cloneNode(true);
        var clonedApple = purchaseBtn.querySelector('.droppy-apple-icon');
        if(clonedApple) clonedApple.remove();
        purchaseBtn.setAttribute('data-droppy-purchase-trigger', '1');
        purchaseBtn.classList.add('droppy-hero-purchase');
        purchaseBtn.removeAttribute('target');
        purchaseBtn.removeAttribute('rel');
        purchaseBtn.setAttribute('data-framer-name', 'Purchase a License');
        var purchaseText = purchaseBtn.querySelector('.framer-text');
        if(purchaseText) purchaseText.textContent = 'Purchase';
        if(!purchaseBtn.querySelector('.droppy-purchase-icon')){
          purchaseBtn.insertBefore(createPurchaseIconNode(), purchaseBtn.firstChild);
        }
        container.appendChild(purchaseBtn);
      }

      var discordBtn = container.querySelector('.droppy-hero-discord') || container.querySelector('.droppy-hero-reclaim');
      if(!(discordBtn instanceof HTMLAnchorElement)){
        discordBtn = downloadBtn.cloneNode(true);
        var clonedApple2 = discordBtn.querySelector('.droppy-apple-icon');
        if(clonedApple2) clonedApple2.remove();
        container.appendChild(discordBtn);
      }
      discordBtn.removeAttribute('data-droppy-reclaim-trigger');
      discordBtn.classList.remove('droppy-hero-reclaim');
      discordBtn.classList.add('droppy-hero-discord');
      discordBtn.setAttribute('href', 'https://discord.gg/XP4EVD4Mde');
      discordBtn.setAttribute('target', '_blank');
      discordBtn.setAttribute('rel', 'noopener');
      discordBtn.setAttribute('data-framer-name', 'Join our Discord');
      var discordText = discordBtn.querySelector('.framer-text');
      if(discordText) discordText.textContent = 'Discord';
      if(!discordBtn.querySelector('.droppy-discord-icon')){
        discordBtn.insertBefore(createDiscordIconNode(), discordBtn.firstChild);
      }

      container.querySelectorAll('a').forEach(function(button){
        if(!(button instanceof HTMLElement)) return;
        button.classList.remove('droppy-blur-reveal-target');
        button.classList.remove('is-visible');
      });

      var headingWrap = hero.querySelector('.framer-mk7lz9');
      if(headingWrap instanceof HTMLElement && !headingWrap.querySelector(':scope > .droppy-hero-price-badge')){
        var badge = document.createElement('a');
        badge.className = 'droppy-hero-price-badge';
        badge.href = '#pricing';
        badge.setAttribute('data-droppy-purchase-trigger', '1');
        var badgeActiveText = formatIntentTotal(checkoutBasePrice.amountCents, checkoutBasePrice.currency);
        var badgeStandardText = formatIntentTotal(checkoutPriceConfig.standardAmountCents, checkoutPriceConfig.currency);
        if(isCheckoutLaunchSaleActive() && badgeActiveText !== badgeStandardText){
          badge.setAttribute('aria-label', 'Launch sale: was ' + badgeStandardText + ', now ' + badgeActiveText);
          badge.innerHTML = '<span class="was">' + badgeStandardText + '</span><span class="now">' + badgeActiveText + '</span>';
        } else {
          badge.setAttribute('aria-label', 'One-time price: ' + badgeStandardText);
          badge.innerHTML = '<span class="now">' + badgeStandardText + '</span>';
        }
        headingWrap.insertBefore(badge, headingWrap.firstChild);
      }
    });

    var heroLogoHeading = hero.querySelector('.framer-mk7lz9');
    if(heroLogoHeading instanceof HTMLElement && !heroLogoHeading.querySelector(':scope > .droppy-hero-logo-img')){
      var heroLogo = document.createElement('img');
      heroLogo.className = 'droppy-hero-logo-img';
      heroLogo.src = './assets/images/droppy-v2-app-icon-256.png';
      heroLogo.srcset = './assets/images/droppy-v2-app-icon-256.png 1x, ./assets/images/droppy-v2-app-icon-512.png 2x, ./assets/images/droppy-v2-app-icon.png 3x';
      heroLogo.alt = 'Droppy';
      heroLogo.width = 88;
      heroLogo.height = 88;
      heroLogo.loading = 'eager';
      heroLogo.decoding = 'async';
      heroLogo.style.imageRendering = 'auto';
      heroLogoHeading.insertBefore(heroLogo, heroLogoHeading.firstChild);
    }

    var heroColumn = hero.querySelector('.framer-ik6gh8');
    if(heroColumn instanceof HTMLElement && !heroColumn.querySelector(':scope > .droppy-macos-ready-badge')){
      var macReadyBadge = document.createElement('div');
      macReadyBadge.className = 'droppy-macos-ready-badge';
      macReadyBadge.setAttribute('role', 'img');
      macReadyBadge.setAttribute('aria-label', 'Ready for macOS 27');
      var macReadyIcon = document.createElement('img');
      macReadyIcon.className = 'droppy-macos-ready-icon';
      macReadyIcon.src = './assets/images/macos-27-round.webp';
      macReadyIcon.srcset = './assets/images/macos-27-round.webp 1x, ./assets/images/macos-27-round.webp 2x';
      macReadyIcon.alt = '';
      macReadyIcon.width = 22;
      macReadyIcon.height = 22;
      macReadyIcon.loading = 'lazy';
      macReadyIcon.decoding = 'async';
      var macReadyText = document.createElement('span');
      macReadyText.className = 'droppy-macos-ready-text';
      macReadyText.textContent = 'Ready for macOS 27';
      macReadyBadge.appendChild(macReadyIcon);
      macReadyBadge.appendChild(macReadyText);
      heroColumn.appendChild(macReadyBadge);
    }

    var existingMorph = heroLogoHeading && heroLogoHeading.querySelector(':scope > .droppy-hero-morph');
    if(existingMorph && existingMorph.parentNode) existingMorph.parentNode.removeChild(existingMorph);

    if(!hero.querySelector('.droppy-hero-mac-mock')){
      var macMock = document.createElement('div');
      macMock.className = 'droppy-hero-mac-mock';

      var ytId = 'hlIdX9QE1MQ';
      var ytParams = [
        'autoplay=1',
        'mute=1',
        'loop=1',
        'playlist=' + ytId,
        'controls=0',
        'showinfo=0',
        'modestbranding=1',
        'rel=0',
        'iv_load_policy=3',
        'playsinline=1',
        'disablekb=1',
        'fs=0',
        'cc_load_policy=0',
        'enablejsapi=1'
      ].join('&');

      var ytFrame = document.createElement('iframe');
      ytFrame.className = 'droppy-hero-youtube-embed';
      ytFrame.src = 'https://www.youtube-nocookie.com/embed/' + ytId + '?' + ytParams;
      ytFrame.setAttribute('frameborder', '0');
      ytFrame.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
      ytFrame.setAttribute('loading', 'eager');
      ytFrame.setAttribute('title', 'Droppy demo');
      ytFrame.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');

      var soundBtn = document.createElement('button');
      soundBtn.type = 'button';
      soundBtn.className = 'droppy-hero-sound-toggle is-muted';
      soundBtn.setAttribute('aria-label', 'Unmute video');
      soundBtn.innerHTML =
        '<svg class="droppy-hero-sound-icon-on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>' +
        '<svg class="droppy-hero-sound-icon-off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';

      var isMuted = true;
      soundBtn.addEventListener('click', function(){
        isMuted = !isMuted;
        soundBtn.classList.toggle('is-muted', isMuted);
        soundBtn.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');
        try {
          ytFrame.contentWindow.postMessage(JSON.stringify({
            event: 'command',
            func: isMuted ? 'mute' : 'unMute',
            args: []
          }), '*');
        } catch (_) {}
      });

      macMock.appendChild(ytFrame);
      macMock.appendChild(soundBtn);
      hero.insertBefore(macMock, hero.firstChild);
    }

    if(!hero.querySelector('.droppy-hero-featured')){
      var featured = document.createElement('div');
      featured.className = 'droppy-hero-featured';
      featured.innerHTML = '<span class="droppy-hero-featured-label">As featured on</span><span class="droppy-hero-featured-name" aria-live="polite"></span>';
      var macRef = hero.querySelector('.droppy-hero-mac-mock');
      if(macRef && macRef.parentNode) macRef.parentNode.insertBefore(featured, macRef.nextSibling);
      else hero.appendChild(featured);
      startFeaturedRotator(featured.querySelector('.droppy-hero-featured-name'));
    }

    /* Glue the "As featured on" strip to the mac-mock by grouping both into a
       single left column. They used to be independent grid items sharing the
       hero's first row with the right-hand text column; whenever that column
       grew — the scroll morph swaps in the taller "The Shelf" subtitle, and
       the macOS 27 badge adds height — the shared row grew and shoved the
       featured line downward. The wrapper is pinned to the top of the row in
       horizontal mode (see .droppy-hero-media-col CSS), so the featured line
       stays welded under the mac-mock no matter what the text column does. */
    var heroMacForCol = hero.querySelector('.droppy-hero-mac-mock');
    var heroFeaturedForCol = hero.querySelector('.droppy-hero-featured');
    if(heroMacForCol && heroFeaturedForCol && !hero.querySelector('.droppy-hero-media-col')){
      var heroMediaCol = document.createElement('div');
      heroMediaCol.className = 'droppy-hero-media-col';
      heroMacForCol.parentNode.insertBefore(heroMediaCol, heroMacForCol);
      heroMediaCol.appendChild(heroMacForCol);
      heroMediaCol.appendChild(heroFeaturedForCol);
    }
  }

  function startFeaturedRotator(rotatorEl){
    if(!(rotatorEl instanceof HTMLElement) || rotatorEl.dataset.droppyRotating === '1') return;
    rotatorEl.dataset.droppyRotating = '1';
    var brands = [
      { name: 'SlashGear', href: 'https://www.slashgear.com/2172654/best-mac-apps-improve-apple-experience-2026/' },
      { name: 'Medium', href: 'https://medium.com/@PowerUpSkills/droppy-is-the-free-mac-productivity-app-power-users-should-install-first-61e1f42c9b3d' },
      { name: 'Reddit', href: 'https://www.reddit.com/r/macapps/comments/1ta1hz4/new_droppy_release_is_a_full_featured_utility/' },
      { name: 'AppAddict', href: 'https://appaddict.app/post/new-droppy-release-is-a-full-featured-utility-suite' }
    ];
    var idx = 0;

    /* Single persistent <a> element — text/href just swap. No more stacking
       absolute siblings, so brands can never overlap during fade transitions
       (which used to happen when the tab was backgrounded and queued
       setTimeouts fired in bursts on return). */
    while(rotatorEl.firstChild) rotatorEl.removeChild(rotatorEl.firstChild);
    var link = document.createElement('a');
    link.className = 'is-in';
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = brands[0].name;
    link.href = brands[0].href;
    rotatorEl.appendChild(link);

    function tick(){
      /* Skip while the tab is hidden — visibility-change handler resumes us. */
      if(document.hidden) return;
      idx = (idx + 1) % brands.length;
      link.classList.remove('is-in');
      link.classList.add('is-out');
      setTimeout(function(){
        link.textContent = brands[idx].name;
        link.href = brands[idx].href;
        link.classList.remove('is-out');
        /* force a reflow so the fade-in animates from the fresh out state */
        void link.offsetWidth;
        link.classList.add('is-in');
      }, 320);
    }
    setInterval(tick, 2600);
  }
  function ensureScrollBlurReveal(){
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var setHeroCtaVisibility = function(row, shouldShow, force){
      if(!(row instanceof HTMLElement)) return;
      var show = !!shouldShow;
      var current = row.dataset.droppyCtaVisible === '1';
      if(!force && current === show) return;
      row.dataset.droppyCtaVisible = show ? '1' : '0';
      row.querySelectorAll('.droppy-hero-cta-reveal').forEach(function(button){
        if(!(button instanceof HTMLElement)) return;
        if(show){
          if(!force && button.classList.contains('is-visible')) return;
          button.classList.remove('is-visible');
          void button.offsetWidth;
          button.classList.add('is-visible');
        } else {
          button.classList.remove('is-visible');
        }
      });
    };
    var rowInView = function(row){
      if(!(row instanceof HTMLElement)) return false;
      var rect = row.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight || 0;
      return rect.bottom > vh * 0.08 && rect.top < vh * 0.92;
    };
    var observeTarget = function(target){
      if(!(target instanceof HTMLElement)) return;
      if(target.dataset.droppyBlurObserved === '1') return;
      target.dataset.droppyBlurObserved = '1';
      target.classList.add('droppy-blur-reveal-target');
      if(prefersReducedMotion){
        target.classList.add('is-visible');
        return;
      }
      if(blurRevealState.observer){
        blurRevealState.observer.observe(target);
      }
    };

    if(!blurRevealState.initialized){
      blurRevealState.initialized = true;
      if(!prefersReducedMotion){
        blurRevealState.observer = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            var target = entry.target;
            if(!(target instanceof HTMLElement)) return;
            if(target.id === 'hero'){
              if(entry.isIntersecting){
                replayHeroHeadingBlurReveal();
              }
              return;
            }
            if(target.classList.contains('droppy-hero-cta-row')){
              setHeroCtaVisibility(target, entry.isIntersecting, false);
              return;
            }
            if(entry.isIntersecting){
              target.classList.remove('is-visible');
              void target.offsetWidth;
              target.classList.add('is-visible');
            } else {
              target.classList.remove('is-visible');
            }
          });
        }, {
          threshold: 0.26,
          rootMargin: '0px 0px -8% 0px'
        });
      }
    }

    document.querySelectorAll('main section h1, main section h2, main section h3').forEach(function(heading){
      observeTarget(heading);
    });

    document.querySelectorAll('#hero .droppy-hero-cta-row').forEach(function(heroRow){
      if(!(heroRow instanceof HTMLElement)) return;
      heroRow.querySelectorAll('a.framer-seHzO, a.framer-9N3cB, a[data-framer-name="Blue Button With Icon"], a').forEach(function(button){
        if(!(button instanceof HTMLElement)) return;
        if(button.closest('.droppy-hero-cta-row') !== heroRow) return;
        button.classList.add('droppy-hero-cta-reveal', 'droppy-blur-reveal-target');
      });
      if(prefersReducedMotion){
        heroRow.querySelectorAll('.droppy-hero-cta-reveal').forEach(function(button){
          if(button instanceof HTMLElement){
            button.classList.add('is-visible');
          }
        });
        return;
      }
      if(heroRow.dataset.droppyBlurObserved !== '1'){
        heroRow.dataset.droppyBlurObserved = '1';
        blurRevealState.observer.observe(heroRow);
      }
      setHeroCtaVisibility(heroRow, rowInView(heroRow), false);
    });
    if(!prefersReducedMotion){
      var heroSection = document.getElementById('hero');
      if(heroSection instanceof HTMLElement && heroSection.dataset.droppyHeroBlurObserved !== '1'){
        heroSection.dataset.droppyHeroBlurObserved = '1';
        blurRevealState.observer.observe(heroSection);
      }
    }
  }

  function collectScrollStoryTargets(){
    var hero = document.getElementById('hero');
    scrollStoryState.hero = hero instanceof HTMLElement ? hero : null;
    scrollStoryState.heroContent = hero ? hero.querySelector('.framer-ik6gh8') : null;
    scrollStoryState.heroVisual = hero ? hero.querySelector('.framer-wdvr1e') : null;
    scrollStoryState.heroParticles = hero ? hero.querySelector('.framer-yeprz2-container') : null;
    scrollStoryState.heroTickerNodes = hero ? Array.from(hero.querySelectorAll('[data-framer-name="Hero Ticker Image"]')).filter(function(node){
      return node instanceof HTMLElement;
    }) : [];
    scrollStoryState.featureCards = Array.from(document.querySelectorAll('#features .droppy-feat')).filter(function(node){
      return node instanceof HTMLElement;
    });
    scrollStoryState.galleryCards = Array.from(document.querySelectorAll('#gallery .droppy-carousel-slide')).filter(function(node){
      return node instanceof HTMLElement;
    });
    scrollStoryState.powerCards = Array.from(document.querySelectorAll('#icons .droppy-power-card')).filter(function(node){
      return node instanceof HTMLElement;
    });
    scrollStoryState.showcasePanels = [
      document.querySelector('#how-it-works .droppy-how-video-wrap'),
      document.querySelector('#cta .framer-8sm0k6')
    ].filter(function(node){
      return node instanceof HTMLElement;
    });
  }

  function resetScrollStoryEffects(){
    if(scrollStoryState.hero){
      [
        '--droppy-hero-scroll-progress',
        '--droppy-hero-content-opacity',
        '--droppy-hero-content-shift',
        '--droppy-hero-content-scale',
        '--droppy-hero-particles-opacity',
        '--droppy-hero-particles-shift',
        '--droppy-hero-particles-scale',
        '--droppy-hero-visual-shift',
        '--droppy-hero-visual-scale',
        '--droppy-hero-visual-brightness',
        '--droppy-hero-visual-saturate'
      ].forEach(function(property){
        scrollStoryState.hero.style.removeProperty(property);
      });
    }

    scrollStoryState.heroTickerNodes.forEach(function(node){
      node.style.transform = '';
      node.style.opacity = '';
      node.style.filter = '';
    });

    [
      scrollStoryState.featureCards,
      scrollStoryState.galleryCards,
      scrollStoryState.powerCards,
      scrollStoryState.showcasePanels
    ].forEach(function(group){
      group.forEach(function(node){
        node.style.transform = '';
        node.style.opacity = '';
        node.style.filter = '';

        var media = node.querySelector('img, video');
        if(media instanceof HTMLElement){
          media.style.transform = '';
          media.style.filter = '';
          media.style.opacity = '';
        }
      });
    });
  }

  function syncHeroScrollStory(){
    if(!(scrollStoryState.hero instanceof HTMLElement)) return;

    var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
    var isMobile = window.matchMedia('(max-width: 809px)').matches;
    var heroRect = scrollStoryState.hero.getBoundingClientRect();
    var progress = clamp01((-heroRect.top) / Math.max(viewportHeight * 0.95, heroRect.height * 0.65, 1));
    var eased = easeOutQuart(progress);
    var contentShift = lerp(0, isMobile ? -54 : -92, eased);
    var contentScale = lerp(1, isMobile ? 0.965 : 0.935, eased);
    var visualShift = lerp(0, isMobile ? -84 : -138, eased);
    var visualScale = lerp(1, isMobile ? 1.12 : 1.22, eased);

    scrollStoryState.hero.style.setProperty('--droppy-hero-scroll-progress', progress.toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-content-opacity', lerp(1, 0.04, eased).toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-content-shift', contentShift.toFixed(2) + 'px');
    scrollStoryState.hero.style.setProperty('--droppy-hero-content-scale', contentScale.toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-particles-opacity', lerp(1, 0.22, eased).toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-particles-shift', lerp(0, isMobile ? -28 : -48, eased).toFixed(2) + 'px');
    scrollStoryState.hero.style.setProperty('--droppy-hero-particles-scale', lerp(1, isMobile ? 1.06 : 1.12, eased).toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-visual-shift', visualShift.toFixed(2) + 'px');
    scrollStoryState.hero.style.setProperty('--droppy-hero-visual-scale', visualScale.toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-visual-brightness', lerp(1, 0.78, eased).toFixed(4));
    scrollStoryState.hero.style.setProperty('--droppy-hero-visual-saturate', lerp(1, 1.08, eased).toFixed(4));

    scrollStoryState.heroTickerNodes.forEach(function(node, index){
      var direction = index % 2 === 0 ? -1 : 1;
      var offsetX = lerp(0, direction * (isMobile ? 10 : 18), eased);
      var offsetY = lerp(0, -(isMobile ? 18 : 30) - (index * (isMobile ? 5 : 8)), eased);
      var scale = lerp(1, isMobile ? 1.04 : 1.09, eased);
      node.style.transform = 'translate3d(' + offsetX.toFixed(2) + 'px,' + offsetY.toFixed(2) + 'px,0) scale(' + scale.toFixed(4) + ')';
      node.style.opacity = lerp(1, 0.28, eased).toFixed(4);
      node.style.filter = 'blur(' + lerp(0, isMobile ? 4 : 8, eased).toFixed(2) + 'px)';
    });
  }

  function syncScrollReactiveCards(cards, options){
    var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
    cards.forEach(function(card, index){
      var rect = card.getBoundingClientRect();
      var progress = clamp01(((viewportHeight * 0.96) - rect.top) / Math.max(viewportHeight * 0.74, 1));
      var eased = easeOutQuart(progress);
      var direction = index % 2 === 0 ? -1 : 1;
      var translateX = lerp(direction * options.fromX, 0, eased);
      var translateY = lerp(options.fromY, 0, eased);
      var scale = lerp(options.fromScale, 1, eased);
      var opacity = lerp(options.fromOpacity, 1, eased);
      var blur = lerp(options.fromBlur, 0, eased);
      card.style.transform = 'translate3d(' + translateX.toFixed(2) + 'px,' + translateY.toFixed(2) + 'px,0) scale(' + scale.toFixed(4) + ')';
      card.style.opacity = opacity.toFixed(4);
      card.style.filter = 'blur(' + blur.toFixed(2) + 'px)';

      var media = card.querySelector(options.mediaSelector);
      if(media instanceof HTMLElement){
        var mediaScale = lerp(options.mediaFromScale, 1, eased);
        var mediaShift = lerp(options.mediaFromY, 0, eased);
        media.style.transform = 'translate3d(0,' + mediaShift.toFixed(2) + 'px,0) scale(' + mediaScale.toFixed(4) + ')';
        media.style.filter = 'brightness(' + lerp(options.mediaBrightness, 1, eased).toFixed(4) + ')';
        media.style.opacity = lerp(options.mediaOpacity, 1, eased).toFixed(4);
      }
    });
  }

  function syncShowcasePanels(){
    var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
    scrollStoryState.showcasePanels.forEach(function(panel){
      var rect = panel.getBoundingClientRect();
      var progress = clamp01(((viewportHeight * 0.94) - rect.top) / Math.max(viewportHeight * 0.68, 1));
      var eased = easeOutQuart(progress);
      panel.style.transform = 'translate3d(0,' + lerp(56, 0, eased).toFixed(2) + 'px,0) scale(' + lerp(0.96, 1, eased).toFixed(4) + ')';
      panel.style.opacity = lerp(0.38, 1, eased).toFixed(4);
      panel.style.filter = 'blur(' + lerp(8, 0, eased).toFixed(2) + 'px)';
    });
  }

  function syncScrollStoryEffects(){
    scrollStoryState.ticking = false;
    collectScrollStoryTargets();
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){
      resetScrollStoryEffects();
      return;
    }

    syncHeroScrollStory();
    syncScrollReactiveCards(scrollStoryState.featureCards, {
      fromX: 20,
      fromY: 72,
      fromScale: 0.955,
      fromOpacity: 0.34,
      fromBlur: 9,
      mediaSelector: '.droppy-feat-img-wrap img',
      mediaFromScale: 1.08,
      mediaFromY: 18,
      mediaBrightness: 0.86,
      mediaOpacity: 0.78
    });
    syncScrollReactiveCards(scrollStoryState.galleryCards, {
      fromX: 18,
      fromY: 58,
      fromScale: 0.97,
      fromOpacity: 0.4,
      fromBlur: 7,
      mediaSelector: '.droppy-ext-media img, .droppy-ext-media video',
      mediaFromScale: 1.06,
      mediaFromY: 14,
      mediaBrightness: 0.88,
      mediaOpacity: 0.76
    });
    syncScrollReactiveCards(scrollStoryState.powerCards, {
      fromX: 22,
      fromY: 62,
      fromScale: 0.965,
      fromOpacity: 0.38,
      fromBlur: 7,
      mediaSelector: '.droppy-power-media img',
      mediaFromScale: 1.07,
      mediaFromY: 16,
      mediaBrightness: 0.88,
      mediaOpacity: 0.78
    });
    syncShowcasePanels();
  }

  function scheduleScrollStoryEffects(){
    if(scrollStoryState.ticking) return;
    scrollStoryState.ticking = true;
    window.requestAnimationFrame(syncScrollStoryEffects);
  }

  function applyGalleryBasketDemo(){
    var gallery = document.getElementById('gallery');
    if(!gallery) return;
    if(gallery.dataset.droppyBasketDemo === '1') return;
    gallery.dataset.droppyBasketDemo = '1';

    while(gallery.firstChild) gallery.removeChild(gallery.firstChild);

    var wrap = document.createElement('div');
    wrap.className = 'droppy-basket-demo';
    var basketYtId = 'fuTNCkAmA9g';
    var basketYtParams = 'autoplay=1&mute=1&loop=1&playlist=' + basketYtId + '&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1&fs=0&cc_load_policy=0&enablejsapi=1';

    wrap.innerHTML =
      '<div class="droppy-basket-demo-header">' +
        '<div class="droppy-basket-summon-float" aria-hidden="true">' +
          '<div class="droppy-basket-summon-file">' +
            '<svg viewBox="0 0 32 40" aria-hidden="true">' +
              '<path d="M5 1.5h14.4L27 9.2v28.3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3.5a2 2 0 0 1 2-2Z" fill="rgba(255,255,255,.94)" stroke="rgba(0,0,0,.4)" stroke-width="0.6"/>' +
              '<path d="M19.4 1.5V9.2H27" fill="rgba(220,232,250,.95)" stroke="rgba(0,0,0,.4)" stroke-width="0.6" stroke-linejoin="round"/>' +
              '<rect x="7" y="16" width="16" height="1.2" rx="0.6" fill="rgba(60,80,110,.6)"/>' +
              '<rect x="7" y="20" width="13" height="1.2" rx="0.6" fill="rgba(60,80,110,.55)"/>' +
              '<rect x="7" y="24" width="15" height="1.2" rx="0.6" fill="rgba(60,80,110,.5)"/>' +
            '</svg>' +
          '</div>' +
          '<div class="droppy-basket-summon-cursor">' +
            '<svg viewBox="0 0 24 24" aria-hidden="true">' +
              '<path d="M5 3.2L5 18.4L9 14.8L11.3 20.6L13.7 19.6L11.4 13.8L17.1 13.5Z" fill="#ffffff" stroke="#101828" stroke-width="0.9" stroke-linejoin="round"/>' +
            '</svg>' +
          '</div>' +
          '<div class="droppy-basket-summon-poof">' +
            '<span class="droppy-basket-poof-ring"></span>' +
            '<span class="droppy-basket-poof-puff droppy-basket-poof-puff--1"></span>' +
            '<span class="droppy-basket-poof-puff droppy-basket-poof-puff--2"></span>' +
            '<span class="droppy-basket-poof-puff droppy-basket-poof-puff--3"></span>' +
            '<span class="droppy-basket-poof-puff droppy-basket-poof-puff--4"></span>' +
            '<span class="droppy-basket-poof-puff droppy-basket-poof-puff--5"></span>' +
            '<span class="droppy-basket-poof-spark droppy-basket-poof-spark--1"></span>' +
            '<span class="droppy-basket-poof-spark droppy-basket-poof-spark--2"></span>' +
            '<span class="droppy-basket-poof-spark droppy-basket-poof-spark--3"></span>' +
            '<span class="droppy-basket-poof-spark droppy-basket-poof-spark--4"></span>' +
          '</div>' +
        '</div>' +
        '<h2 class="droppy-basket-demo-title">Summon the basket!</h2>' +
        '<p class="droppy-basket-demo-body">Anywhere on screen, jiggle the file you\'re dragging. The basket flies in, stores anything, and stays on top of every app so you can drop it back out wherever you need it next.</p>' +
      '</div>' +
      '<div class="droppy-basket-video">' +
        '<iframe class="droppy-basket-youtube-embed" src="https://www.youtube-nocookie.com/embed/' + basketYtId + '?' + basketYtParams + '" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" loading="lazy" title="Droppy basket demo" referrerpolicy="strict-origin-when-cross-origin"></iframe>' +
        '<button type="button" class="droppy-basket-sound-toggle is-muted" aria-label="Unmute video">' +
          '<svg class="droppy-basket-sound-icon-on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>' +
          '<svg class="droppy-basket-sound-icon-off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>' +
        '</button>' +
      '</div>';

    gallery.appendChild(wrap);

    /* Play the summon animation exactly once when slide 3 first scrolls into view */
    var summonFloat = wrap.querySelector('.droppy-basket-summon-float');
    if(summonFloat && 'IntersectionObserver' in window){
      var summonObs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting && !summonFloat.classList.contains('is-playing')){
            summonFloat.classList.add('is-playing');
            summonObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.35 });
      summonObs.observe(summonFloat);
    } else if(summonFloat){
      summonFloat.classList.add('is-playing');
    }

    var iframe = wrap.querySelector('.droppy-basket-youtube-embed');
    var soundBtn = wrap.querySelector('.droppy-basket-sound-toggle');
    if(iframe && soundBtn){
      var muted = true;
      soundBtn.addEventListener('click', function(){
        muted = !muted;
        soundBtn.classList.toggle('is-muted', muted);
        soundBtn.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
        try {
          iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: muted ? 'mute' : 'unMute', args: [] }), '*');
        } catch (_) {}
      });
    }
  }

  function escapeAttributeValue(value){
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function isLocalRasterAsset(value){
    return /^(?:\.\/)?assets\/.+\.(?:png|jpe?g|gif|webp|avif)(?:\?.*)?$/i.test(String(value || '').trim()) ||
      /^\/assets\/.+\.(?:png|jpe?g|gif|webp|avif)(?:\?.*)?$/i.test(String(value || '').trim());
  }

  function toAbsoluteAssetPath(value){
    var raw = String(value || '').trim();
    if(!raw) return '';
    if(raw.indexOf('/assets/') === 0) return raw;
    return '/' + raw.replace(/^\.\//, '').replace(/^\/+/, '');
  }

  function buildNetlifyImageUrl(source, options){
    if(!isLocalRasterAsset(source)) return source;
    var params = new URLSearchParams();
    var config = options || {};
    var width = Number(config.width || config.w || 0);
    var height = Number(config.height || config.h || 0);
    var quality = Number(config.quality || config.q || 0);
    var format = String(config.format || config.fm || 'webp').trim();
    params.set('url', toAbsoluteAssetPath(source));
    if(width > 0) params.set('w', String(Math.round(width)));
    if(height > 0) params.set('h', String(Math.round(height)));
    if(quality > 0) params.set('q', String(Math.round(quality)));
    if(format) params.set('fm', format);
    if(config.fit) params.set('fit', String(config.fit));
    return '/.netlify/images?' + params.toString();
  }

  function rewriteLocalAssetSrcset(srcset, options){
    var raw = String(srcset || '').trim();
    if(!raw) return raw;
    return raw.split(',').map(function(part){
      var entry = part.trim();
      if(!entry) return '';
      var descriptorMatch = entry.match(/\s+(\d+(?:\.\d+)?[wx])$/i);
      var descriptor = descriptorMatch ? descriptorMatch[1] : '';
      var source = descriptorMatch ? entry.slice(0, descriptorMatch.index).trim() : entry;
      if(!isLocalRasterAsset(source)) return entry;
      var nextOptions = Object.assign({}, options || {});
      if(/w$/i.test(descriptor)){
        nextOptions.width = parseInt(descriptor, 10);
      }
      var optimized = buildNetlifyImageUrl(source, nextOptions);
      return descriptor ? optimized + ' ' + descriptor : optimized;
    }).join(', ');
  }

  function rewriteStaticAssetImages(scope){
    var root = scope && typeof scope.querySelectorAll === 'function' ? scope : document;
    root.querySelectorAll('img').forEach(function(img){
      var currentSrcset = img.getAttribute('srcset');
      if(currentSrcset){
        var nextSrcset = rewriteLocalAssetSrcset(currentSrcset, { quality: 78 });
        if(nextSrcset && nextSrcset !== currentSrcset){
          img.setAttribute('srcset', nextSrcset);
        }
      }

      var currentSrc = img.getAttribute('src');
      if(!isLocalRasterAsset(currentSrc)) return;
      var width = Number(img.getAttribute('width') || 0);
      var nextSrc = buildNetlifyImageUrl(currentSrc, {
        width: width > 0 ? width : undefined,
        quality: 78
      });
      if(nextSrc && nextSrc !== currentSrc){
        img.setAttribute('src', nextSrc);
      }
    });

    root.querySelectorAll('source[srcset]').forEach(function(source){
      var currentSrcset = source.getAttribute('srcset');
      var nextSrcset = rewriteLocalAssetSrcset(currentSrcset, { quality: 78 });
      if(nextSrcset && nextSrcset !== currentSrcset){
        source.setAttribute('srcset', nextSrcset);
      }
    });

    root.querySelectorAll('video[poster]').forEach(function(video){
      var currentPoster = video.getAttribute('poster');
      if(!isLocalRasterAsset(currentPoster)) return;
      var nextPoster = buildNetlifyImageUrl(currentPoster, { width: 1324, quality: 78 });
      if(nextPoster && nextPoster !== currentPoster){
        video.setAttribute('poster', nextPoster);
      }
    });
  }

  function hydrateLazyVideoSources(scope){
    var root = scope && typeof scope.querySelectorAll === 'function' ? scope : document;
    var lazyVideos = root.querySelectorAll('video[data-lazy-video="1"]');
    if(!lazyVideos.length) return;

    function loadVideo(video){
      if(video.dataset.lazyLoaded === '1') return;
      video.querySelectorAll('source[data-src]').forEach(function(source){
        if(!source.src){
          source.src = source.getAttribute('data-src');
        }
      });
      video.dataset.lazyLoaded = '1';
      video.load();
      var playPromise = video.play();
      if(playPromise && typeof playPromise.catch === 'function'){
        playPromise.catch(function(){});
      }
    }

    if(typeof IntersectionObserver !== 'function'){
      lazyVideos.forEach(loadVideo);
      return;
    }

    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        loadVideo(entry.target);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '240px 0px', threshold: 0.01 });

    lazyVideos.forEach(function(video){
      observer.observe(video);
    });
  }

  function applyBelowFoldLazyMedia(scope){
    var root = scope && typeof scope.querySelectorAll === 'function' ? scope : document;
    var viewportHeight = window.innerHeight || 0;
    var lazyCutoff = viewportHeight * 1.25;
    root.querySelectorAll('img').forEach(function(img){
      if(!img.getAttribute('decoding')){
        img.setAttribute('decoding', 'async');
      }
      var rect = img.getBoundingClientRect();
      var hasSize = rect.width > 0 && rect.height > 0;
      var inCriticalBand = hasSize && rect.bottom > 0 && rect.top < lazyCutoff;
      if(inCriticalBand){
        if(img.dataset.droppyLazyForced === 'lazy'){
          img.removeAttribute('loading');
          img.dataset.droppyLazyForced = 'eager';
        } else if(img.dataset.droppyLazyForced !== 'eager' && !img.getAttribute('loading')){
          img.dataset.droppyLazyForced = 'eager';
        }
      } else {
        if(img.getAttribute('loading') !== 'lazy'){
          img.setAttribute('loading', 'lazy');
        }
        img.dataset.droppyLazyForced = 'lazy';
      }
    });
  }

  function startDroppyLazyImageObserver(){
    if(window.__droppyLazyImgObserver) return;
    if(typeof MutationObserver !== 'function') return;
    var pending = false;
    var run = function(){
      pending = false;
      applyBelowFoldLazyMedia(document);
    };
    var schedule = function(){
      if(pending) return;
      pending = true;
      if(typeof requestAnimationFrame === 'function'){
        requestAnimationFrame(run);
      } else {
        setTimeout(run, 16);
      }
    };
    var obs = new MutationObserver(function(mutations){
      for(var i = 0; i < mutations.length; i++){
        var m = mutations[i];
        if(m.type !== 'childList' || !m.addedNodes || !m.addedNodes.length) continue;
        for(var j = 0; j < m.addedNodes.length; j++){
          var node = m.addedNodes[j];
          if(node && node.nodeType === 1 && (node.tagName === 'IMG' || (node.querySelector && node.querySelector('img')))){
            schedule();
            return;
          }
        }
      }
    });
    obs.observe(document.documentElement, {
      childList: true,
      subtree: true
    });
    window.__droppyLazyImgObserver = obs;
  }

  function forceHeroPrimaryLineSingleLine(){
    var hero = document.getElementById('hero');
    if(!hero) return;
    var primaryLine = hero.querySelector('.framer-1rmrzte .framer-text');
    if(!primaryLine) return;

    if(window.matchMedia('(max-width: 1199px)').matches){
      primaryLine.style.whiteSpace = '';
      primaryLine.style.textWrap = '';
      return;
    }

    primaryLine.style.whiteSpace = 'nowrap';
    primaryLine.style.textWrap = 'nowrap';
  }

  var heroShowcaseImages = [];

  var companiesTrackLoops = new WeakMap();

  var powerTrackLoops = new WeakMap();

  function fixNativeProductivityCTA(){
    var cta = document.getElementById('cta');
    if(!cta) return;
    if(cta.dataset.droppyOrbitCta === '1') return;
    cta.dataset.droppyOrbitCta = '1';

    while(cta.firstChild) cta.removeChild(cta.firstChild);

    var wrap = document.createElement('div');
    wrap.className = 'droppy-cta-orbit-wrap';
    wrap.innerHTML =
      '<div class="droppy-cta-orbit-header">' +
        '<h2 class="droppy-cta-title">All of Droppy, in one place.</h2>' +
        '<p class="droppy-cta-body">From the Shelf to every Droplet. Droppy ties your Mac together with a single download.</p>' +
        '<div class="droppy-cta-actions" data-droppy-cta-actions></div>' +
      '</div>' +
      '<div class="droppy-cta-huds-video">' +
        '<iframe class="droppy-cta-huds-embed" src="https://www.youtube-nocookie.com/embed/0F8DII1bSO0?autoplay=1&mute=1&loop=1&playlist=0F8DII1bSO0&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1&fs=0&cc_load_policy=0&enablejsapi=1" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" loading="lazy" title="Droppy HUDs overview" referrerpolicy="strict-origin-when-cross-origin"></iframe>' +
        '<button type="button" class="droppy-cta-huds-sound is-muted" aria-label="Unmute video">' +
          '<svg class="droppy-cta-huds-sound-on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>' +
          '<svg class="droppy-cta-huds-sound-off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>' +
        '</button>' +
      '</div>';

    cta.appendChild(wrap);

    cloneHeroCTAsInto(wrap.querySelector('[data-droppy-cta-actions]'));

    var hudsIframe = wrap.querySelector('.droppy-cta-huds-embed');
    var hudsBtn = wrap.querySelector('.droppy-cta-huds-sound');
    if(hudsIframe && hudsBtn){
      var hudsMuted = true;
      hudsBtn.addEventListener('click', function(){
        hudsMuted = !hudsMuted;
        hudsBtn.classList.toggle('is-muted', hudsMuted);
        hudsBtn.setAttribute('aria-label', hudsMuted ? 'Unmute video' : 'Mute video');
        try {
          hudsIframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: hudsMuted ? 'mute' : 'unMute', args: [] }), '*');
        } catch (_) {}
      });
    }
  }

  function cloneHeroCTAsInto(target){
    if(!(target instanceof HTMLElement)) return;
    function tryClone(){
      var heroRow = document.querySelector('#hero .droppy-hero-cta-row');
      if(!heroRow){
        setTimeout(tryClone, 250);
        return;
      }
      var clone = heroRow.cloneNode(true);
      clone.classList.add('droppy-cta-cloned-row');
      clone.querySelectorAll('[data-droppy-hero-cta]').forEach(function(el){
        el.removeAttribute('data-droppy-hero-cta');
      });
      clone.querySelectorAll('.droppy-hero-discord').forEach(function(btn){
        btn.style.display = 'none';
      });
      target.innerHTML = '';
      target.appendChild(clone);
    }
    tryClone();
  }

  function buildYouTubeEmbedSrc(videoId, opts){
    opts = opts || {};
    var host = opts.nocookie ? 'https://www.youtube-nocookie.com' : 'https://www.youtube.com';
    var params = ['rel=0','modestbranding=1','playsinline=1','iv_load_policy=3'];
    if(opts.autoplay) params.push('autoplay=1');
    if(opts.color) params.push('color=' + encodeURIComponent(opts.color));
    var embedOrigin = '';
    if(/^https?:$/i.test(window.location.protocol || '')){
      embedOrigin = window.location.origin || '';
    }
    if(embedOrigin && opts.jsApi){
      params.push('enablejsapi=1');
      params.push('origin=' + encodeURIComponent(embedOrigin));
      params.push('widget_referrer=' + encodeURIComponent(embedOrigin + '/'));
    }
    return host + '/embed/' + encodeURIComponent(videoId) + '?' + params.join('&');
  }

  function createYouTubeFacade(videoId, opts){
    opts = opts || {};
    var facade = document.createElement('button');
    facade.type = 'button';
    facade.className = 'droppy-yt-facade';
    facade.setAttribute('aria-label', opts.title || 'Play video');
    facade.style.background = '#000 center/cover no-repeat';
    var posterUrl = 'https://i.ytimg.com/vi_webp/' + encodeURIComponent(videoId) + '/maxresdefault.webp';
    var posterImg = new Image();
    posterImg.loading = 'lazy';
    posterImg.decoding = 'async';
    posterImg.fetchPriority = 'low';
    posterImg.alt = '';
    posterImg.className = 'droppy-yt-facade-img';
    posterImg.src = posterUrl;
    posterImg.addEventListener('error', function(){
      posterImg.src = 'https://i.ytimg.com/vi/' + encodeURIComponent(videoId) + '/hqdefault.jpg';
    });
    facade.appendChild(posterImg);

    var playBtn = document.createElement('span');
    playBtn.className = 'droppy-yt-facade-play';
    playBtn.setAttribute('aria-hidden', 'true');
    playBtn.innerHTML = '<svg viewBox="0 0 68 48" focusable="false"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74 0 13.05 0 24 0 24s0 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C68 34.95 68 24 68 24s0-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg>';
    facade.appendChild(playBtn);

    var swapped = false;
    function swap(){
      if(swapped) return;
      swapped = true;
      var iframe = document.createElement('iframe');
      iframe.className = facade.className.replace('droppy-yt-facade', 'droppy-yt-iframe');
      iframe.title = opts.title || 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.src = buildYouTubeEmbedSrc(videoId, Object.assign({}, opts, { autoplay: true }));
      facade.replaceWith(iframe);
    }
    facade.addEventListener('click', swap);
    facade.addEventListener('pointerover', function once(){
      facade.removeEventListener('pointerover', once);
      var pre = document.createElement('link');
      pre.rel = 'preconnect';
      pre.href = 'https://www.youtube-nocookie.com';
      document.head.appendChild(pre);
    }, { once: true });

    return facade;
  }

  function applyFeaturesWorkflowCards(){
    var features = document.getElementById('features');
    if(!features) return;
    if(features.dataset.droppyFeaturesShowcase === '1') return;
    features.dataset.droppyFeaturesShowcase = '1';
    /* Wipe any legacy Framer content so nothing old can leak through */
    while(features.firstChild) features.removeChild(features.firstChild);
    var container = features;

    var sections = [
      {
        layout: 'hero-stats',
        kicker: '',
        title: 'Not just a notch app',
        body: 'Droppy offers way more. For example a full-fledged clipboard manager.',
        videoId: 'IVivktqFoFM',
        marquee: ['OCR', 'Screenshot editing', 'Live Office file previews', 'Background removal', 'Drop clipboard entries into the shelf', 'Custom tags', 'Favorited & pinned', 'And much more']
      }
    ];

    if(container.querySelector('.droppy-feature-showcase')) return;

    var showcase = document.createElement('div');
    showcase.className = 'droppy-feature-showcase';

    function makeImage(s) {
      var imgWrap = document.createElement('div');
      imgWrap.className = 'droppy-feat-img-wrap';
      var img = document.createElement('img');
      img.src = buildNetlifyImageUrl(s.image, { width: 1324, quality: 78 });
      img.alt = s.title;
      img.loading = 'lazy';
      img.decoding = 'async';
      imgWrap.appendChild(img);
      return imgWrap;
    }

    sections.forEach(function(s){
      var article = document.createElement('article');
      article.className = 'droppy-feat droppy-feat--' + s.layout;

      if(s.layout === 'hero-stats') {
        /* Centered header, image/video, stats or marquee below */
        var header = document.createElement('div');
        header.className = 'droppy-feat-header';
        if(s.kicker){
          var k = document.createElement('p'); k.className = 'droppy-feat-kicker'; k.textContent = s.kicker;
          header.appendChild(k);
        }
        var t = document.createElement('h3'); t.className = 'droppy-feat-title'; t.textContent = s.title;
        var b = document.createElement('p'); b.className = 'droppy-feat-body'; b.textContent = s.body;
        header.appendChild(t); header.appendChild(b);
        article.appendChild(header);

        var visual = document.createElement('div');
        visual.className = 'droppy-feat-visual';
        if(s.videoId){
          var ytParams2 = 'autoplay=1&mute=1&loop=1&playlist=' + s.videoId + '&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1&fs=0&cc_load_policy=0&enablejsapi=1';
          var ytFrame2 = document.createElement('iframe');
          ytFrame2.className = 'droppy-feat-youtube-embed';
          ytFrame2.src = 'https://www.youtube-nocookie.com/embed/' + s.videoId + '?' + ytParams2;
          ytFrame2.setAttribute('frameborder', '0');
          ytFrame2.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
          ytFrame2.setAttribute('loading', 'lazy');
          ytFrame2.setAttribute('title', s.title);
          ytFrame2.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
          visual.appendChild(ytFrame2);

          var soundBtn2 = document.createElement('button');
          soundBtn2.type = 'button';
          soundBtn2.className = 'droppy-feat-sound-toggle is-muted';
          soundBtn2.setAttribute('aria-label', 'Unmute video');
          soundBtn2.innerHTML =
            '<svg class="droppy-feat-sound-icon-on" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>' +
            '<svg class="droppy-feat-sound-icon-off" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';
          var muted2 = true;
          soundBtn2.addEventListener('click', function(){
            muted2 = !muted2;
            soundBtn2.classList.toggle('is-muted', muted2);
            soundBtn2.setAttribute('aria-label', muted2 ? 'Unmute video' : 'Mute video');
            try {
              ytFrame2.contentWindow.postMessage(JSON.stringify({
                event: 'command',
                func: muted2 ? 'mute' : 'unMute',
                args: []
              }), '*');
            } catch (_) {}
          });
          visual.appendChild(soundBtn2);
        } else {
          visual.appendChild(makeImage(s));
        }
        article.appendChild(visual);

        if(s.marquee){
          var marqueeWrap = document.createElement('div');
          marqueeWrap.className = 'droppy-feat-marquee';
          var marqueeTrack = document.createElement('div');
          marqueeTrack.className = 'droppy-feat-marquee-track';
          var sequence = s.marquee.concat(s.marquee);
          sequence.forEach(function(word, i){
            var item = document.createElement('span');
            item.className = 'droppy-feat-marquee-item';
            item.textContent = word;
            marqueeTrack.appendChild(item);
            var sep = document.createElement('span');
            sep.className = 'droppy-feat-marquee-sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '·';
            marqueeTrack.appendChild(sep);
          });
          marqueeWrap.appendChild(marqueeTrack);
          article.appendChild(marqueeWrap);
        } else if(s.stats) {
          var statsRow = document.createElement('div');
          statsRow.className = 'droppy-feat-stats';
          s.stats.forEach(function(st){
            var stat = document.createElement('div');
            stat.className = 'droppy-feat-stat';
            var val = document.createElement('span');
            val.className = 'droppy-feat-stat-value';
            val.textContent = st.value;
            var lbl = document.createElement('span');
            lbl.className = 'droppy-feat-stat-label';
            lbl.textContent = st.label;
            stat.appendChild(val); stat.appendChild(lbl);
            statsRow.appendChild(stat);
          });
          article.appendChild(statsRow);
        }

      } else if(s.layout === 'img-text') {
        /* Image left, text right */
        article.appendChild(makeImage(s));
        var textCol = document.createElement('div');
        textCol.className = 'droppy-feat-text';
        var k2 = document.createElement('p'); k2.className = 'droppy-feat-kicker'; k2.textContent = s.kicker;
        var t2 = document.createElement('h3'); t2.className = 'droppy-feat-title'; t2.textContent = s.title;
        var b2 = document.createElement('p'); b2.className = 'droppy-feat-body'; b2.textContent = s.body;
        textCol.appendChild(k2); textCol.appendChild(t2); textCol.appendChild(b2);
        article.appendChild(textCol);

      } else if(s.layout === 'centered') {
        /* Centered text, big image, footer text */
        var header3 = document.createElement('div');
        header3.className = 'droppy-feat-header';
        var k3 = document.createElement('p'); k3.className = 'droppy-feat-kicker'; k3.textContent = s.kicker;
        var t3 = document.createElement('h3'); t3.className = 'droppy-feat-title'; t3.textContent = s.title;
        var b3 = document.createElement('p'); b3.className = 'droppy-feat-body'; b3.textContent = s.body;
        header3.appendChild(k3); header3.appendChild(t3); header3.appendChild(b3);
        article.appendChild(header3);
        article.appendChild(makeImage(s));
        if(s.footer) {
          var footerDiv = document.createElement('div');
          footerDiv.className = 'droppy-feat-footer';
          var fp = document.createElement('p');
          fp.textContent = s.footer;
          footerDiv.appendChild(fp);
          article.appendChild(footerDiv);
        }

      } else if(s.layout === 'full-bleed') {
        /* Centered text, then massive edge-to-edge image */
        var header4 = document.createElement('div');
        header4.className = 'droppy-feat-header';
        var k4 = document.createElement('p'); k4.className = 'droppy-feat-kicker'; k4.textContent = s.kicker;
        var t4 = document.createElement('h3'); t4.className = 'droppy-feat-title'; t4.textContent = s.title;
        header4.appendChild(k4); header4.appendChild(t4);
        article.appendChild(header4);
        var b4 = document.createElement('p'); b4.className = 'droppy-feat-body'; b4.textContent = s.body;
        article.appendChild(b4);
        article.appendChild(makeImage(s));

      } else if(s.layout === 'huds-compose') {
        /* Centered text, then composed grid of HUD screenshots */
        var header5 = document.createElement('div');
        header5.className = 'droppy-feat-header';
        var k5 = document.createElement('p'); k5.className = 'droppy-feat-kicker'; k5.textContent = s.kicker;
        var t5 = document.createElement('h3'); t5.className = 'droppy-feat-title'; t5.textContent = s.title;
        header5.appendChild(k5); header5.appendChild(t5);
        article.appendChild(header5);
        var b5 = document.createElement('p'); b5.className = 'droppy-feat-body'; b5.textContent = s.body;
        article.appendChild(b5);

        var grid = document.createElement('div');
        grid.className = 'droppy-huds-grid';

        /* Row 1: 3 notch HUDs */
        var notchRow = document.createElement('div');
        notchRow.className = 'droppy-huds-row droppy-huds-row--notch';
        /* Row 2: 2 pill HUDs */
        var pillRow = document.createElement('div');
        pillRow.className = 'droppy-huds-row droppy-huds-row--pill';

        s.huds.forEach(function(h){
          var wrap = document.createElement('div');
          wrap.className = 'droppy-hud-item droppy-hud-item--' + h.mode;
          var img = document.createElement('img');
          img.src = buildNetlifyImageUrl(h.src, { width: 720, quality: 78 });
          img.alt = h.alt;
          img.loading = 'lazy';
          img.decoding = 'async';
          wrap.appendChild(img);
          if(h.mode === 'notch') notchRow.appendChild(wrap);
          else pillRow.appendChild(wrap);
        });

        grid.appendChild(notchRow);
        grid.appendChild(pillRow);
        article.appendChild(grid);
      }

      showcase.appendChild(article);
    });

    container.appendChild(showcase);

    /* Scroll-triggered reveal */
    if('IntersectionObserver' in window){
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting){
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });
      showcase.querySelectorAll('.droppy-feat').forEach(function(el){ obs.observe(el); });
    } else {
      showcase.querySelectorAll('.droppy-feat').forEach(function(el){ el.classList.add('is-visible'); });
    }
  }

  function applyDropletsGrid(){
    var icons = document.getElementById('icons');
    if(!icons) return;
    if(icons.dataset.droppyDropletsGrid === '1') return;
    icons.dataset.droppyDropletsGrid = '1';

    while(icons.firstChild) icons.removeChild(icons.firstChild);

    var section = document.createElement('div');
    section.className = 'droppy-droplets-section';

    var droplets = [
      { name: 'Mechey',            body: 'Real mechanical keyboard sounds for every keystroke.',  iconSrc: './assets/droplets/mechey.png' },
