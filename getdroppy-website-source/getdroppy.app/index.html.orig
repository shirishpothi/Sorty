align-items:center;
justify-content:flex-end;
}
#droppy-license-modal-overlay .droppy-quantity-stepper{
display:grid;
grid-template-columns:34px minmax(28px,1fr) 34px;
align-items:center;
justify-items:center;
column-gap:8px;
padding:4px;
border-radius:var(--droppy-purchase-shared-radius);
border:1px solid rgba(255,255,255,.16);
background:rgba(255,255,255,.05);
min-width:130px;
height:44px;
transition:border-color .22s ease,background-color .22s ease,box-shadow .22s ease,filter .22s ease;
}
#droppy-license-modal-overlay .droppy-quantity-step{
width:34px;
height:34px;
border-radius:999px;
border:0;
background:rgba(255,255,255,.12);
color:#ecf4ff;
font:700 16px/1 "Inter","Inter Placeholder",sans-serif;
cursor:pointer;
display:inline-flex;
align-items:center;
justify-content:center;
line-height:1;
padding:0;
}
#droppy-license-modal-overlay .droppy-quantity-step:hover{
filter:brightness(1.06);
}
#droppy-license-modal-overlay .droppy-quantity-value{
min-width:28px;
display:inline-flex;
align-items:center;
justify-content:center;
text-align:center;
font:700 14px/1 "Inter","Inter Placeholder",sans-serif;
color:#f4f9ff;
}
.droppy-pricing-card.is-updating{
animation:droppy-pricing-refresh .34s cubic-bezier(.22,.61,.36,1);
}
.droppy-quantity-stepper.is-updating{
animation:droppy-stepper-refresh .3s cubic-bezier(.22,.61,.36,1);
}
#droppy-quantity-value.is-updating{
animation:droppy-quantity-refresh .28s cubic-bezier(.22,.61,.36,1);
}
@keyframes droppy-pricing-refresh{
0%{filter:blur(5px);opacity:.68;transform:translateY(4px)}
100%{filter:blur(0);opacity:1;transform:translateY(0)}
}
@keyframes droppy-quantity-refresh{
0%{filter:blur(4px);opacity:.55;transform:scale(.92)}
100%{filter:blur(0);opacity:1;transform:scale(1)}
}
@keyframes droppy-stepper-refresh{
0%{filter:blur(2px);box-shadow:0 0 0 0 rgba(123,201,255,.24),inset 0 0 0 rgba(255,255,255,.12)}
100%{filter:blur(0);box-shadow:0 0 0 7px rgba(123,201,255,0),inset 0 1px 0 rgba(255,255,255,.12)}
}
@media (max-width:809px){
#droppy-license-modal-overlay .droppy-license-modal.droppy-purchase-modal{
--droppy-purchase-shared-radius:24px;
border-radius:var(--droppy-purchase-shared-radius);
padding:16px 14px 14px;
}
#droppy-license-modal-overlay .droppy-purchase-head{
grid-template-columns:1fr;
gap:10px;
}
#droppy-license-modal-overlay .droppy-purchase-config,
#droppy-license-modal-overlay .droppy-purchase-controls{
justify-content:flex-start;
}
#droppy-license-modal-overlay .droppy-purchase-config .droppy-inline-continue{
width:100%;
}
#droppy-license-modal-overlay .droppy-pricing-card{
grid-template-columns:1fr;
gap:10px;
padding:10px 12px;
}
#droppy-license-modal-overlay .droppy-quantity-row{
justify-content:flex-start;
}
}
@media (prefers-reduced-motion:reduce){
.droppy-pricing-card.is-updating,
.droppy-quantity-stepper.is-updating,
#droppy-quantity-value.is-updating{
animation:none!important;
}
}
/* ── Payment Step ── */
/* Inherits the default modal's translucent gradient + backdrop-filter so both
   steps share the same glass look. Only width changes. overflow stays hidden
   (inherited from .droppy-purchase-modal) so the title-wrap key decoration
