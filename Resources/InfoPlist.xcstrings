    "NSAppleEventsUsageDescription" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sorty benötigt die Erlaubnis, Ihre Auswahl im Finder zu lesen und die Ordner anzuzeigen, die es organisiert." } },
        "en" : { "stringUnit" : { "state" : "new", "value" : "Sorty needs permission to read the files you select in Finder and reveal the folders it organizes." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sorty necesita permiso para leer los archivos que seleccionas en Finder y mostrar las carpetas que organiza." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sorty a besoin d'autorisation pour lire les fichiers que vous sélectionnez dans le Finder et afficher les dossiers qu'il organise." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Sortyは、Finderで選択したファイルを読み取り、整理したフォルダを表示するための許可を必要とします。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Sorty 需要获得权限，才能读取你在访达中选择的文件并显示它整理的文件夹。" } }
      }
    },
    "NSFaceIDUsageDescription" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sorty verwendet biometrische Authentifizierung, um Ihre Lerndaten zu schützen." } },
        "en" : { "stringUnit" : { "state" : "new", "value" : "Sorty uses biometric authentication to protect your learning data." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sorty usa la autenticación biométrica para proteger tus datos de aprendizaje." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sorty utilise l’authentification biométrique pour protéger vos données d’apprentissage." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Sortyは学習データを保護するために生体認証を使用します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Sorty 使用生物识别认证来保护你的学习数据。" } }
      }
    },
