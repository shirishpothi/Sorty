@@ -1195,8 +1195,8 @@ function rangesToLineRects(ranges, anchor, originTop = 0, options) {
     width: rect.width,
     height: rect.height,
     // Seed off `originTop` (container's document origin), not the selection's min-top: min-top moves
     // when an upward drag adds a line above, re-rolling every seed and re-randomizing painted shapes.
-    seed: Math.round((rect.top - originTop) * SEED_SCALE),
+    seed: (Math.imul(Math.round((rect.top - originTop) * SEED_SCALE), 73856093) ^ Math.imul(Math.round(rect.left * SEED_SCALE), 19349663)) >>> 0,
     isFirst: index === 0,
     isLast: index === lines.length - 1
   }));
@@ -1334,12 +1334,6 @@ function findSelectionAnchor(node) {
   if (!hasWindow() || typeof getComputedStyle === "undefined") {
     return document.body ?? document.documentElement;
   }
-  let el = node instanceof Element ? node : node.parentElement;
-  while (el && el !== document.body && el !== document.documentElement) {
-    const position = getComputedStyle(el).position;
-    if (position && position !== "static") return el;
-    el = el.parentElement;
-  }
   const contentRoot = document.querySelector("article") ?? document.querySelector("main");
   return contentRoot ?? document.body;
 }
