#!/usr/bin/env bash
set -euo pipefail

APP_SCHEME="sorty"

show_help() {
    cat <<'EOF'
Sorty CLI

Usage: sorty <command> [options]

Commands:
  organize <path> [options]    Start organizing a directory
    --persona <id>             Select a persona (e.g. 'general', 'developer')
    --auto                     Automatically start organization

  duplicates <path> [options]  Scan for duplicates
    --auto                     Automatically start scanning

  status, health               View Workspace Health
  list                         View Watched Folders
  watched [add <path>]         View or add watched folders
  exclusions [add <pattern>]   View or add exclusion rules
  storage [add <path>]         View or add storage locations
  settings [section]           Open settings
    sections: rules, provider, strategy, tuning, automation, finder,
              notifications, advanced, troubleshooting, help

  persona <action>             Manage personas
    create                     Open persona creator
    generate <prompt>          Generate a new persona from description

  rules add <pattern>          Add an exclusion rule
  learnings                    Open Learnings dashboard
  history                      Open History
  help                         Show this help
  update                       Check for updates
  version, -v, --version       Show app version
EOF
}

show_version() {
    local app_path="/Applications/Sorty.app"
    local version
    local build

    if [[ -d "${app_path}" ]]; then
        version="$(defaults read "${app_path}/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || true)"
        build="$(defaults read "${app_path}/Contents/Info.plist" CFBundleVersion 2>/dev/null || true)"
        if [[ -n "${version}" ]]; then
            echo "Sorty version ${version} (build ${build})"
        else
            echo "Sorty is installed but version could not be determined."
            echo "Check version in-app: Settings > About"
        fi
    else
        echo "Sorty app not found at ${app_path}"
        echo "Check version in-app: Settings > About"
    fi
}

die() {
    echo "Error: $*" >&2
    exit 1
}

require_arg() {
    local value="${1:-}"
    local message="$2"
    if [[ -z "${value}" ]]; then
        die "${message}"
    fi
}

urlencode() {
    local value="${1-}"
    if ! command -v python3 >/dev/null 2>&1; then
        die "python3 is required for URL encoding."
    fi

    python3 - "$value" <<'PY'
import sys
import urllib.parse

print(urllib.parse.quote(sys.argv[1], safe="/"))
PY
}

resolve_directory_path() {
    local input_path="${1-}"
    require_arg "${input_path}" "Missing required directory path."

    if [[ ! -e "${input_path}" ]]; then
        die "Directory does not exist: ${input_path}"
    fi
    if [[ ! -d "${input_path}" ]]; then
        die "Expected a directory path, got: ${input_path}"
    fi

    (
        cd "${input_path}"
        pwd -P
    )
}

open_url() {
    local url="$1"
    if [[ "${SORTY_CLI_DRY_RUN:-0}" == "1" ]]; then
        echo "${url}"
        return
    fi
    open "${url}"
}

require_no_extra_args() {
    local command="$1"
    shift
    if [[ $# -gt 0 ]]; then
        die "Unexpected arguments for ${command}: $*"
    fi
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

command="$1"
shift

case "${command}" in
    organize)
        path_arg=""
        persona=""
        autostart="false"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --persona)
                    if [[ $# -lt 2 ]]; then
                        die "Missing value for --persona. Usage: sorty organize <path> [--persona <id>] [--auto]"
                    fi
                    persona="$2"
                    shift 2
                    ;;
                --auto)
                    autostart="true"
                    shift
                    ;;
                -*)
                    die "Unknown option for organize: $1"
                    ;;
                *)
                    if [[ -z "${path_arg}" ]]; then
                        path_arg="$1"
                        shift
                    else
                        die "Unexpected extra argument for organize: $1"
                    fi
                    ;;
            esac
        done

        require_arg "${path_arg}" "Missing required path. Usage: sorty organize <path> [--persona <id>] [--auto]"
        abs_path="$(resolve_directory_path "${path_arg}")"
        encoded_path="$(urlencode "${abs_path}")"
        url="${APP_SCHEME}://organize?autostart=${autostart}&path=${encoded_path}"
        if [[ -n "${persona}" ]]; then
            url="${url}&persona=$(urlencode "${persona}")"
        fi
        open_url "${url}"
        ;;

    duplicates)
        path_arg=""
        autostart="false"

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --auto)
                    autostart="true"
                    shift
                    ;;
                -*)
                    die "Unknown option for duplicates: $1"
                    ;;
                *)
                    if [[ -z "${path_arg}" ]]; then
                        path_arg="$1"
                        shift
                    else
                        die "Unexpected extra argument for duplicates: $1"
                    fi
                    ;;
            esac
        done

        require_arg "${path_arg}" "Missing required path. Usage: sorty duplicates <path> [--auto]"
        abs_path="$(resolve_directory_path "${path_arg}")"
        encoded_path="$(urlencode "${abs_path}")"
        open_url "${APP_SCHEME}://duplicates?autostart=${autostart}&path=${encoded_path}"
        ;;

    status | health)
        require_no_extra_args "${command}" "$@"
        open_url "${APP_SCHEME}://health"
        ;;

    list)
        require_no_extra_args "${command}" "$@"
        open_url "${APP_SCHEME}://watched"
        ;;

    watched)
        if [[ $# -eq 0 ]]; then
            open_url "${APP_SCHEME}://watched"
            exit 0
        fi

        action="$1"
        shift
        case "${action}" in
            add)
                require_arg "${1-}" "Missing required path. Usage: sorty watched add <path>"
                if [[ $# -gt 1 ]]; then
                    die "Unexpected extra argument for watched add: ${*:2}"
                fi
                abs_path="$(resolve_directory_path "$1")"
                encoded_path="$(urlencode "${abs_path}")"
                open_url "${APP_SCHEME}://watched?action=add&path=${encoded_path}"
                ;;
            *)
                die "Unknown watched action: ${action}. Usage: sorty watched [add <path>]"
                ;;
        esac
        ;;

    exclusions)
        if [[ $# -eq 0 ]]; then
            open_url "${APP_SCHEME}://exclusions"
            exit 0
        fi

        action="$1"
        shift
        case "${action}" in
            add)
                if [[ $# -eq 0 ]]; then
                    die "Missing required pattern. Usage: sorty exclusions add <pattern>"
                fi
                pattern="$*"
                encoded_pattern="$(urlencode "${pattern}")"
                open_url "${APP_SCHEME}://exclusions?action=add&pattern=${encoded_pattern}"
                ;;
            *)
                die "Unknown exclusions action: ${action}. Usage: sorty exclusions [add <pattern>]"
                ;;
        esac
        ;;

    storage)
        if [[ $# -eq 0 ]]; then
            open_url "${APP_SCHEME}://storage"
            exit 0
        fi

        action="$1"
        shift
        case "${action}" in
            add)
                require_arg "${1-}" "Missing required path. Usage: sorty storage add <path>"
                if [[ $# -gt 1 ]]; then
                    die "Unexpected extra argument for storage add: ${*:2}"
                fi
                abs_path="$(resolve_directory_path "$1")"
                encoded_path="$(urlencode "${abs_path}")"
                open_url "${APP_SCHEME}://storage?action=add&path=${encoded_path}"
                ;;
            *)
                die "Unknown storage action: ${action}. Usage: sorty storage [add <path>]"
                ;;
        esac
        ;;

    settings)
        if [[ $# -gt 1 ]]; then
            die "Usage: sorty settings [section]"
        fi
        if [[ $# -eq 1 ]]; then
            encoded_section="$(urlencode "$1")"
            open_url "${APP_SCHEME}://settings?section=${encoded_section}"
        else
            open_url "${APP_SCHEME}://settings"
        fi
        ;;

    persona)
        action="${1-}"
        require_arg "${action}" "Missing persona action. Usage: sorty persona <create|generate ...>"
        shift || true
        case "${action}" in
            create)
                require_no_extra_args "persona create" "$@"
                open_url "${APP_SCHEME}://persona?action=create"
                ;;
            generate)
                if [[ $# -eq 0 ]]; then
                    die "Missing prompt. Usage: sorty persona generate <prompt>"
                fi
                prompt="$*"
                encoded_prompt="$(urlencode "${prompt}")"
                open_url "${APP_SCHEME}://persona?action=generate&generate=true&prompt=${encoded_prompt}"
                ;;
            *)
                die "Unknown persona action: ${action}. Usage: sorty persona <create|generate ...>"
                ;;
        esac
        ;;

    rules)
        action="${1-}"
        require_arg "${action}" "Missing rules action. Usage: sorty rules add <pattern>"
        shift || true
        if [[ "${action}" != "add" ]]; then
            die "Unknown rules action: ${action}. Usage: sorty rules add <pattern>"
        fi
        if [[ $# -eq 0 ]]; then
            die "Missing pattern. Usage: sorty rules add <pattern>"
        fi
        pattern="$*"
        encoded_pattern="$(urlencode "${pattern}")"
        open_url "${APP_SCHEME}://exclusions?action=add&pattern=${encoded_pattern}"
        ;;

    learnings)
        require_no_extra_args "${command}" "$@"
        open_url "${APP_SCHEME}://learnings"
        ;;

    history)
        require_no_extra_args "${command}" "$@"
        open_url "${APP_SCHEME}://history"
        ;;

    help)
        require_no_extra_args "${command}" "$@"
        show_help
        ;;

    update)
        require_no_extra_args "${command}" "$@"
        open_url "${APP_SCHEME}://help?section=updates"
        ;;

    version | -v | --version)
        require_no_extra_args "${command}" "$@"
        show_version
        ;;

    *)
        echo "Error: Unknown command: ${command}" >&2
        show_help >&2
        exit 1
        ;;
esac
