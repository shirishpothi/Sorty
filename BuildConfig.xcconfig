//
// BuildConfig.xcconfig
// Sorty - Shared build configuration for optimization
//
// This file contains shared build settings for both Xcode and SPM builds
// to ensure consistent optimization across all build methods.
//

// MARK: - Parallel Build Settings
// Enable parallel target building
ENABLE_PARALLEL_BUILDING_PHASE = YES
RUN_BUILD_SCRIPT_PHASES_IN_PARALLEL = YES

// Eager linking unblocks downstream targets faster (Xcode 14+)
ENABLE_EAGER_LINKING = YES

// MARK: - Debug Build Optimization (Speed)
// Disable index store for debug builds to reduce compile/index overhead
COMPILER_INDEX_STORE_ENABLE[config=Debug] = NO

// Build only active architecture for faster debug builds
ONLY_ACTIVE_ARCH[config=Debug] = YES
ONLY_ACTIVE_ARCH[config=Release] = NO

// Debug: No optimization for fastest build
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0

// Debug: Use incremental compilation for parallel file compilation
SWIFT_COMPILATION_MODE[config=Debug] = incremental

// Debug: Minimal debug info for faster builds
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf

// MARK: - Release Build Optimization (Performance & Size)
// Release: Full optimization
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule

// Release: Full debug info with dSYM
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym

// MARK: - Linker Optimizations
// Remove dead code and strip symbols in release
DEAD_CODE_STRIPPING = YES
STRIP_INSTALLED_PRODUCT[config=Release] = YES
STRIP_STYLE[config=Release] = all

// Link-time optimization for release (enables cross-module optimizations)
LLVM_LTO[config=Release] = YES_THIN

// MARK: - Compiler Caching
// Enable compilation cache when available (Xcode 26+)
COMPILATION_CACHE_ENABLE_CACHING = YES

// MARK: - Swift Specific
// Use integrated driver for better performance
SWIFT_USE_INTEGRATED_DRIVER = YES

// Enable incremental compilation
SWIFT_ENABLE_INCREMENTAL_COMPILATION = YES

// Suppress warnings during build for cleaner output
// GCC_WARN_INHIBIT_ALL_WARNINGS = YES

// MARK: - Linker Optimizations (Debug)
// Skip deduplication in debug for faster linking
OTHER_LDFLAGS[config=Debug] = -Xlinker -no_deduplicate

// MARK: - Architecture Settings
// Limit to macOS only for faster builds
SUPPORTED_PLATFORMS = macosx
SDKROOT = macosx

// Valid architectures
VALID_ARCHS = x86_64 arm64

// MARK: - Licensing Build Settings
// Release builds consume these immutable bundle values. Keep the signing private key server-side.
// PEM values may use literal \\n escapes; Sorty normalizes them when reading Info.plist.
SORTY_LICENSE_SERVICE_URL =
SORTY_LICENSE_PUBLIC_KEY_PEM =
SORTY_LICENSE_PUBLIC_KEY_ID = sorty-license-key-v1
SORTY_LICENSE_VALIDATION_HOURS = 24
SORTY_LICENSE_GRACE_HOURS = 168
SORTY_LICENSE_SEAT_LIMIT = 3

// MARK: - Build Performance Diagnostics
// Uncomment to profile build times (significantly slows builds)
// OTHER_SWIFT_FLAGS = -Xfrontend -warn-long-function-bodies=100 -Xfrontend -warn-long-expression-type-checking=100
